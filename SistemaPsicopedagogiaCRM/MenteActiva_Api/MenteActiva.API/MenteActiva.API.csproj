<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Cada quien guarda aqui sus datos locales: la clave de la base y la
         contrasena de aplicacion del correo. Nada de eso va en appsettings,
         que si se sube al repositorio. El identificador es compartido a
         proposito; lo que cambia es el contenido en cada maquina. -->
    <UserSecretsId>f69b7168-6bdc-4e10-bef0-9e1d8b20a25f</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
</Project>
