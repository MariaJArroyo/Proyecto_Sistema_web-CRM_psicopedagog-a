POST {{host}}/api/sesiones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idEstudiante": 1, "idCita": null, "idTipoSesion": 1, "idTipoAtencion": 1,
  "fechaHoraInicio": "2026-10-03T09:00:00", "duracionMinutos": 5,
