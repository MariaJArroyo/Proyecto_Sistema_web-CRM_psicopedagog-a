PUT {{host}}/api/sesiones/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idTipoSesion": 1, "idTipoAtencion": 1,
  "fechaHoraInicio": "2026-09-12T14:00:00", "duracionMinutos": 45,
  "objetivo": "X", "temaTrabajado": "Y"
}

