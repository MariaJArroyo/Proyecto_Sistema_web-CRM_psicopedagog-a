{


  // Proveedor: "Registro" escribe el enlace en la consola y no manda nada.
  // Cuando exista el buzon, se cambia a "Gmail" y se llenan las tres claves de
  // abajo. Usuario es el correo y Contrasena es una contrasena de aplicacion
  // de Google, no la de la cuenta.
  "Correo": {
    "Proveedor": "Registro",
    "UrlBaseWeb": "https://localhost:7202",
    "Servidor": "smtp.gmail.com",
    "Puerto": 587,
    "NombreRemitente": "Mente Activa Psicopedagogia",
    "Remitente": "",
    "Usuario": "",
    "Contrasena": "",
    "DestinatarioContacto": ""
  },

  "Agenda": {
    "ZonaHoraria": "America/Costa_Rica",
    "MinutosRevisionVencidas": 5
  },

  // Cada cuanto el worker programa recordatorios y manda lo pendiente. Esto es
  // infraestructura; las horas de anticipacion del recordatorio son del negocio
  // y se editan desde la pantalla de Configuracion.
  // MaxIntentos: despues de ese numero de fallos el aviso deja de reintentarse
  // y queda marcado como fallido con el motivo a la vista.
  "Notificaciones": {
    "MinutosRevision": 5,
    "MaxIntentos": 3,
    "PorVuelta": 50
  },

  "Jwt": {
    "Llave": "CAMBIAR-EN-USER-SECRETS",
    "Emisor": "MenteActiva.Api",
    "Audiencia": "MenteActiva.Web",
    "HorasVigencia": 8
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
