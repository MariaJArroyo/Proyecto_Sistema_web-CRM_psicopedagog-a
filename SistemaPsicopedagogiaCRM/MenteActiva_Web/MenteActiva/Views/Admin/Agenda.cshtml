@model MenteActiva.Models.CatalogosAgendaViewModel

@{
    ViewData["Title"] = "Agenda";
    var hayCatalogos = Model.TiposSesion.Any() && Model.Modalidades.Any();
}

<main class="PrincipalAdmin">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1">Agenda de citas</h2>
            <p class="TextoSuave mb-0" id="RangoAgenda" aria-live="polite">&nbsp;</p>
        </div>
        <button type="button" class="btn btn-primary"
                data-bs-toggle="modal" data-bs-target="#ModalNuevaCita"
                @(hayCatalogos ? "" : "disabled")>
            <i class="bi bi-plus-lg me-1"></i>Nueva cita
        </button>
    </div>

    @if (ViewBag.ErrorCarga != null)
    {
        <div class="alert alert-warning">@ViewBag.ErrorCarga</div>
    }

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

        <ul class="nav nav-pills" id="SelectorVistaAgenda">
            <li class="nav-item"><button type="button" class="nav-link active" data-vista="semana">Semana</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-vista="dia">Día</button></li>
            <li class="nav-item"><button type="button" class="nav-link" data-vista="mes">Mes</button></li>
        </ul>

        <div class="btn-group" role="group" aria-label="Navegar en la agenda">
            <button type="button" class="btn btn-outline-secondary" id="BotonAnterior" aria-label="Anterior">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary" id="BotonHoy">Hoy</button>
            <button type="button" class="btn btn-outline-secondary" id="BotonSiguiente" aria-label="Siguiente">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

    </div>

    <div class="d-flex flex-wrap gap-3 mb-3 small TextoSuave">
        <span><span class="CalendarioMes-Punto punto-programada"></span>Programada</span>
        <span><span class="CalendarioMes-Punto punto-confirmada"></span>Confirmada</span>
        <span><span class="CalendarioMes-Punto punto-completada"></span>Completada</span>
        <span><span class="CalendarioMes-Punto punto-cancelada"></span>Cancelada</span>
        <span><span class="CalendarioMes-Punto punto-no-asistio"></span>No asistió</span>
        <span><i class="bi bi-people-fill text-primary me-1"></i>Grupo</span>
    </div>

    <!-- El calendario lo dibuja agenda.js con las citas del rango visible -->
    <div class="Tarjeta p-3 p-md-4" id="VistaAgenda"></div>

</main>


<!-- ========================================================= -->
<!-- MODAL NUEVA CITA (individual / grupo / unirse a grupo) -->
<!-- ========================================================= -->

<div class="modal fade" id="ModalNuevaCita" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <form id="FormularioNuevaCita" asp-controller="Admin" asp-action="CrearCita" method="post" novalidate>

                <div class="modal-header">
                    <h5 class="modal-title" id="TituloNuevaCita">Nueva cita</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">

                    <div class="btn-group w-100 mb-3 SelectorModoCita" role="group" aria-label="Tipo de cita">
                        <input type="radio" class="btn-check" name="ModoCita" id="ModoIndividual" value="individual" checked>
                        <label class="btn btn-outline-primary" for="ModoIndividual">
                            <i class="bi bi-person me-1"></i>Individual
                        </label>

                        <input type="radio" class="btn-check" name="ModoCita" id="ModoGrupo" value="grupo">
                        <label class="btn btn-outline-primary" for="ModoGrupo">
                            <i class="bi bi-people me-1"></i>Grupo nuevo
                        </label>

                        <input type="radio" class="btn-check" name="ModoCita" id="ModoUnirse" value="unirse">
                        <label class="btn btn-outline-primary" for="ModoUnirse">
                            <i class="bi bi-person-plus me-1"></i>Unirse a un grupo
                        </label>
                    </div>

                    <div class="alert d-none" id="NuevaCitaError" role="alert"></div>

                    <div class="row g-3">

                        <!-- Estudiante (en modo grupo agrega a la lista de participantes) -->
                        <div class="col-12">
                            <label for="EstudianteCita" class="form-label CampoObligatorio" id="EtiquetaEstudianteCita">Estudiante</label>
                            <div id="BuscadorEstudianteCita"></div>
                            <div class="form-text d-none" data-modos="grupo">
                                Busque y elija cada estudiante: se van sumando a la lista.
                            </div>
                        </div>

                        <!-- Solo grupo -->
                        <div class="col-12 d-none" data-modos="grupo">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="form-label mb-0 CampoObligatorio">Participantes</span>
                                <small class="TextoSuave" id="ContadorParticipantes">0 de 6</small>
                            </div>
                            <div class="ListaParticipantes" id="ListaParticipantes"></div>
                            <div class="invalid-feedback" id="ParticipantesError">Agregue al menos un estudiante.</div>
                        </div>

                        <div class="col-md-8 d-none" data-modos="grupo">
                            <label for="NombreGrupoCita" class="form-label">Nombre del grupo <span class="TextoSuave small">(opcional)</span></label>
                            <input type="text" class="form-control" id="NombreGrupoCita" maxlength="100"
                                   placeholder="Ej.: Hermanos Mora, Taller de lectura">
                        </div>

                        <div class="col-md-4 d-none" data-modos="grupo">
                            <label for="CupoGrupoCita" class="form-label CampoObligatorio">Cupo</label>
                            <input type="number" class="form-control" id="CupoGrupoCita" min="2" max="30" value="6">
                            <div class="invalid-feedback">Entre 2 y 30, y no menor que los participantes.</div>
                        </div>

                        <!-- Individual y grupo -->
                        <div class="col-md-6" data-modos="individual grupo">
                            <label for="TipoSesionCita" class="form-label CampoObligatorio">Tipo de sesión</label>
                            <select class="form-select" id="TipoSesionCita" name="IdTipoSesion">
                                <option value="">Seleccione una opción</option>
                                @foreach (var tipo in Model.TiposSesion)
                                {
                                    <option value="@tipo.IdTipoSesion">@tipo.Nombre (@tipo.DuracionMinutos min)</option>
                                }
                            </select>
                            <div class="invalid-feedback">Seleccione el tipo de sesión.</div>
                        </div>

                        <div class="col-md-6" data-modos="individual grupo">
                            <label class="form-label CampoObligatorio d-block">Modalidad</label>
                            @for (var i = 0; i < Model.Modalidades.Count; i++)
                            {
                                var modalidad = Model.Modalidades[i];
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IdModalidad"
                                           id="ModalidadCita@(modalidad.IdModalidad)" value="@modalidad.IdModalidad"
                                           @(i == 0 ? "checked" : "")>
                                    <label class="form-check-label" for="ModalidadCita@(modalidad.IdModalidad)">@modalidad.Nombre</label>
                                </div>
                            }
                        </div>

                        <!-- Todos los modos -->
                        <div class="col-md-4">
                            <label for="FechaCita" class="form-label CampoObligatorio">Fecha</label>
                            <input type="date" class="form-control" id="FechaCita">
                            <div class="invalid-feedback">Seleccione una fecha de hoy en adelante.</div>
                        </div>

                        <!-- Individual y grupo: espacios libres -->
                        <div class="col-md-8" data-modos="individual grupo">
                            <span class="form-label CampoObligatorio d-block">Horario disponible</span>
                            <div class="EspaciosHorario" id="EspaciosNuevaCita"></div>
                            <input type="hidden" id="HoraCita" name="FechaHoraInicio">
                            <div class="invalid-feedback" id="HoraCitaError">Seleccione un horario.</div>
                        </div>

                        <!-- Unirse: grupos con cupo ese dia -->
                        <div class="col-md-8 d-none" data-modos="unirse">
                            <span class="form-label CampoObligatorio d-block">Grupos con cupo ese día</span>
                            <div class="d-flex flex-column gap-2" id="GruposDisponibles"></div>
                            <input type="hidden" id="GrupoElegido">
                            <div class="invalid-feedback" id="GrupoElegidoError">Seleccione un grupo.</div>
                        </div>

                        <div class="col-12" data-modos="individual grupo">
                            <label for="ObservacionesCita" class="form-label">Observaciones</label>
                            <textarea class="form-control" id="ObservacionesCita" name="Observaciones"
                                      rows="2" maxlength="500"></textarea>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="BotonGuardarNuevaCita">Guardar cita</button>
                </div>

            </form>

        </div>
    </div>
</div>


<!-- ========================================================= -->
<!-- MODAL DETALLE DE CITA INDIVIDUAL -->
<!-- ========================================================= -->

<div class="modal fade" id="ModalDetalleCita" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Detalle de la cita
                    <span class="badge align-middle ms-2" id="DetalleCitaEstado"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <div class="alert d-none" id="DetalleCitaMensaje" role="alert"></div>

                <dl class="row mb-0">
                    <dt class="col-5 TextoSuave fw-normal">Fecha</dt>
                    <dd class="col-7" id="DetalleCitaFecha"></dd>
                    <dt class="col-5 TextoSuave fw-normal">Hora</dt>
                    <dd class="col-7" id="DetalleCitaHora"></dd>
                    <dt class="col-5 TextoSuave fw-normal">Estudiante</dt>
                    <dd class="col-7" id="DetalleCitaEstudiante"></dd>
                    <dt class="col-5 TextoSuave fw-normal">Encargado</dt>
                    <dd class="col-7" id="DetalleCitaEncargado"></dd>
                    <dt class="col-5 TextoSuave fw-normal">Tipo de sesión</dt>
                    <dd class="col-7" id="DetalleCitaTipo"></dd>
                    <dt class="col-5 TextoSuave fw-normal">Modalidad</dt>
                    <dd class="col-7" id="DetalleCitaModalidad"></dd>
                    <dt class="col-5 TextoSuave fw-normal">Observaciones</dt>
                    <dd class="col-7" id="DetalleCitaObservaciones" style="white-space:pre-line;"></dd>
                    <dt class="col-5 TextoSuave fw-normal d-none" id="EtiquetaMotivoCancelacion">Motivo de cancelación</dt>
                    <dd class="col-7 d-none" id="DetalleCitaMotivo"></dd>
                </dl>

                <div class="border rounded-3 p-3 mt-3 d-none" id="PanelReprogramar">
                    <h6 class="fw-semibold mb-3">Reprogramar cita</h6>
                    <div class="mb-2">
                        <label for="ReprogramarFecha" class="form-label small">Nueva fecha</label>
                        <input type="date" class="form-control form-control-sm" id="ReprogramarFecha">
                    </div>
                    <span class="form-label small d-block">Horario disponible</span>
                    <div class="EspaciosHorario" id="EspaciosReprogramar"></div>
                    <input type="hidden" id="HoraReprogramar">
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cerrar-panel>Volver</button>
                        <button type="button" class="btn btn-sm btn-primary" id="BotonConfirmarReprogramar">Confirmar nuevo horario</button>
                    </div>
                </div>

                <div class="border border-danger-subtle rounded-3 p-3 mt-3 d-none" id="PanelCancelar">
                    <h6 class="fw-semibold mb-2">Cancelar cita</h6>
                    <p class="small TextoSuave mb-2">La cita quedará como "Cancelada" y seguirá visible en el historial.</p>
                    <label for="MotivoCancelacion" class="form-label small CampoObligatorio">Motivo</label>
                    <textarea class="form-control form-control-sm" id="MotivoCancelacion" rows="2" maxlength="500"></textarea>
                    <div class="invalid-feedback">Indique el motivo de la cancelación.</div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cerrar-panel>Volver</button>
                        <button type="button" class="btn btn-sm btn-danger" id="BotonConfirmarCancelar">Sí, cancelar cita</button>
                    </div>
                </div>

            </div>

            <div class="modal-footer justify-content-between">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger" id="BotonCancelarCita">
                        <i class="bi bi-x-circle me-1"></i>Cancelar cita
                    </button>
                    <button type="button" class="btn btn-outline-warning" id="BotonNoAsistio">
                        <i class="bi bi-person-x me-1"></i>Marcar como no asistió
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-primary" id="BotonReprogramarCita">
                        <i class="bi bi-calendar-event me-1"></i>Reprogramar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>

        </div>
    </div>
</div>


<!-- ========================================================= -->
<!-- MODAL DETALLE DE GRUPO -->
<!-- ========================================================= -->

<div class="modal fade" id="ModalDetalleGrupo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0">
                        <i class="bi bi-people-fill text-primary me-1"></i>
                        <span id="GrupoTitulo">Grupo</span>
                        <span class="badge text-bg-light border align-middle ms-2" id="GrupoCupo"></span>
                    </h5>
                    <small class="TextoSuave" id="GrupoSubtitulo"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <div class="alert d-none" id="GrupoMensaje" role="alert"></div>

                <h6 class="text-uppercase small fw-semibold TextoSuave mb-2">Participantes</h6>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" id="TablaParticipantes">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Encargado</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <!-- Agregar participante -->
                <div class="border rounded-3 p-3 mt-3 d-none" id="PanelGrupoAgregar">
                    <h6 class="fw-semibold mb-2">Agregar participante</h6>
                    <label for="EstudianteAgregarGrupo" class="form-label small CampoObligatorio">Estudiante</label>
                    <div id="BuscadorAgregarGrupo"></div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cerrar-panel-grupo>Volver</button>
                        <button type="button" class="btn btn-sm btn-primary" id="BotonConfirmarAgregar">Agregar al grupo</button>
                    </div>
                </div>

                <!-- Editar nombre y cupo -->
                <div class="border rounded-3 p-3 mt-3 d-none" id="PanelGrupoEditar">
                    <h6 class="fw-semibold mb-2">Editar grupo</h6>
                    <div class="row g-2">
                        <div class="col-md-8">
                            <label for="EditarGrupoNombre" class="form-label small">Nombre</label>
                            <input type="text" class="form-control form-control-sm" id="EditarGrupoNombre" maxlength="100">
                        </div>
                        <div class="col-md-4">
                            <label for="EditarGrupoCupo" class="form-label small CampoObligatorio">Cupo</label>
                            <input type="number" class="form-control form-control-sm" id="EditarGrupoCupo" min="2" max="30">
                            <div class="invalid-feedback">Entre 2 y 30, y no menor que los inscritos.</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cerrar-panel-grupo>Volver</button>
                        <button type="button" class="btn btn-sm btn-primary" id="BotonConfirmarEditarGrupo">Guardar cambios</button>
                    </div>
                </div>

                <!-- Reprogramar el grupo completo -->
                <div class="border rounded-3 p-3 mt-3 d-none" id="PanelGrupoReprogramar">
                    <h6 class="fw-semibold mb-2">Reprogramar el grupo completo</h6>
                    <div class="mb-2">
                        <label for="ReprogramarGrupoFecha" class="form-label small">Nueva fecha</label>
                        <input type="date" class="form-control form-control-sm" id="ReprogramarGrupoFecha">
                    </div>
                    <span class="form-label small d-block">Horario disponible</span>
                    <div class="EspaciosHorario" id="EspaciosReprogramarGrupo"></div>
                    <input type="hidden" id="HoraReprogramarGrupo">
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cerrar-panel-grupo>Volver</button>
                        <button type="button" class="btn btn-sm btn-primary" id="BotonConfirmarReprogramarGrupo">Confirmar nuevo horario</button>
                    </div>
                </div>

                <!-- Cancelar (el grupo completo o un participante) -->
                <div class="border border-danger-subtle rounded-3 p-3 mt-3 d-none" id="PanelGrupoCancelar">
                    <h6 class="fw-semibold mb-2" id="TituloCancelarGrupo">Cancelar grupo</h6>
                    <label for="MotivoCancelarGrupo" class="form-label small CampoObligatorio">Motivo</label>
                    <textarea class="form-control form-control-sm" id="MotivoCancelarGrupo" rows="2" maxlength="500"></textarea>
                    <div class="invalid-feedback">Indique el motivo de la cancelación.</div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cerrar-panel-grupo>Volver</button>
                        <button type="button" class="btn btn-sm btn-danger" id="BotonConfirmarCancelarGrupo">Confirmar cancelación</button>
                    </div>
                </div>

            </div>

            <div class="modal-footer justify-content-between">
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary" id="BotonGrupoAgregar">
                        <i class="bi bi-person-plus me-1"></i>Agregar participante
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="BotonGrupoEditar">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </button>
                    <button type="button" class="btn btn-outline-primary" id="BotonGrupoReprogramar">
                        <i class="bi bi-calendar-event me-1"></i>Reprogramar
                    </button>
                    <button type="button" class="btn btn-outline-danger" id="BotonGrupoCancelar">
                        <i class="bi bi-x-circle me-1"></i>Cancelar grupo
                    </button>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/buscadorEstudiantes.js" asp-append-version="true"></script>
    <script src="~/js/agenda.js" asp-append-version="true"></script>
}