  <div class="ContenedorToasts"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/Main.js"></script>
  <script src="~/js/Validaciones.js"></script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {

      var vistas = { Semana: document.getElementById("VistaSemana"), Dia: document.getElementById("VistaDia"), Mes: document.getElementById("VistaMes") };
      document.querySelectorAll("#SelectorVistaAgenda [data-vista]").forEach(function (boton) {
        boton.addEventListener("click", function () {
          document.querySelectorAll("#SelectorVistaAgenda .nav-link").forEach(function (b) { b.classList.remove("active"); });
          boton.classList.add("active");
          Object.keys(vistas).forEach(function (clave) {
            vistas[clave].classList.toggle("d-none", clave !== boton.getAttribute("data-vista"));
          });
        });
      });

      var horariosOcupados = [
        { fecha: "2026-07-13", hora: "09:00" },
        { fecha: "2026-07-13", hora: "14:00" },
        { fecha: "2026-07-14", hora: "10:00" },
        { fecha: "2026-07-15", hora: "15:30" },
        { fecha: "2026-07-16", hora: "11:00" },
        { fecha: "2026-07-17", hora: "09:00" },
        { fecha: "2026-07-17", hora: "13:00" },
        { fecha: "2026-07-18", hora: "10:00" }
      ];

      function HorarioOcupado(fecha, hora) {
        return horariosOcupados.some(function (slot) { return slot.fecha === fecha && slot.hora === hora; });
      }

      document.getElementById("FormularioNuevaCita").addEventListener("submit", function (evento) {
        evento.preventDefault();
        var aviso = document.getElementById("AvisoHorarioOcupado");
        aviso.classList.add("d-none");

        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("EstudianteNuevaCita"), "Seleccione un estudiante.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("FechaNuevaCita"), "Seleccione una fecha.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("HoraNuevaCita"), "Seleccione una hora.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("TipoSesionNuevaCita"), "Seleccione el tipo de sesión.") && esValido;
        if (!esValido) {
          return;
        }

        var fecha = document.getElementById("FechaNuevaCita").value;
        var hora = document.getElementById("HoraNuevaCita").value;
        if (HorarioOcupado(fecha, hora)) {
          aviso.classList.remove("d-none");
          return;
        }

        evento.target.reset();
        document.getElementById("FechaNuevaCita").value = "2026-07-13";
        evento.target.querySelectorAll(".is-valid").forEach(function (campo) { campo.classList.remove("is-valid"); });
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalNuevaCita")).hide();
        MostrarToast("Cita registrada correctamente.");
      });

      var citaSeleccionada = null;
      document.querySelectorAll('[data-modal-detalle="ModalDetalleCita"]').forEach(function (tarjeta) {
        tarjeta.addEventListener("click", function () {
          citaSeleccionada = tarjeta;
          document.getElementById("EstadoCitaSeleccionada").value = tarjeta.getAttribute("data-valor-estado");
          document.getElementById("PanelReprogramar").classList.remove("show");
          document.getElementById("AvisoReprogramarOcupado").classList.add("d-none");
        });
      });

      var mapaClaseTarjeta = {
        "Programada": "TarjetaCita-programada",
        "Confirmada": "TarjetaCita-confirmada",
        "Completada": "TarjetaCita-completada",
        "Cancelada": "TarjetaCita-cancelada",
        "No asistió": "TarjetaCita-no-asistio"
      };
      var mapaClaseBadge = {
        "Programada": "badge-cita-programada",
        "Confirmada": "badge-cita-confirmada",
        "Completada": "badge-cita-completada",
        "Cancelada": "badge-cita-cancelada",
        "No asistió": "badge-cita-no-asistio"
      };

      function ActualizarTarjetasCita(idCita, nuevoEstado) {
        document.querySelectorAll('[data-cita-objetivo="' + idCita + '"]').forEach(function (tarjeta) {
          tarjeta.setAttribute("data-valor-estado", nuevoEstado);
          Object.values(mapaClaseTarjeta).forEach(function (clase) { tarjeta.classList.remove(clase); });
          tarjeta.classList.add(mapaClaseTarjeta[nuevoEstado]);
          var insignia = tarjeta.querySelector(".badge");
          if (insignia) {
            Object.values(mapaClaseBadge).forEach(function (clase) { insignia.classList.remove(clase); });
            insignia.classList.add(mapaClaseBadge[nuevoEstado]);
            insignia.textContent = nuevoEstado;
          }
        });
      }

      document.getElementById("BotonGuardarEstadoCita").addEventListener("click", function () {
        if (!citaSeleccionada) {
          return;
        }
        var nuevoEstado = document.getElementById("EstadoCitaSeleccionada").value;
        var idCita = citaSeleccionada.getAttribute("data-cita-objetivo");
        ActualizarTarjetasCita(idCita, nuevoEstado);
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalDetalleCita")).hide();
        MostrarToast("Estado de la cita actualizado a \"" + nuevoEstado + "\".");
      });

      document.getElementById("BotonConfirmarReprogramar").addEventListener("click", function () {
        if (!citaSeleccionada) {
          return;
        }
        var aviso = document.getElementById("AvisoReprogramarOcupado");
        var nuevaFecha = document.getElementById("ReprogramarFecha").value;
        var nuevaHora = document.getElementById("ReprogramarHora").value;
        if (!nuevaFecha || !nuevaHora) {
          return;
        }
        if (HorarioOcupado(nuevaFecha, nuevaHora)) {
          aviso.classList.remove("d-none");
          return;
        }
        aviso.classList.add("d-none");
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalDetalleCita")).hide();
        MostrarToast("Cita reprogramada correctamente.");
      });

      document.getElementById("BotonConfirmarCancelarCita").addEventListener("click", function () {
        if (!citaSeleccionada) {
          return;
        }
        var idCita = citaSeleccionada.getAttribute("data-cita-objetivo");
        ActualizarTarjetasCita(idCita, "Cancelada");
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalCancelarCita")).hide();
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalDetalleCita")).hide();
        MostrarToast("Cita cancelada.", "error");
      });
    });
  </script>
</body>

</html>