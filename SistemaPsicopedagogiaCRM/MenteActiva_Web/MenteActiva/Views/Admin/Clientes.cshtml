@model List<MenteActiva.Models.ClienteViewModel>

@{
    ViewData["Title"] = "Clientes";
}

<main class="PrincipalAdmin">

    ```
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1">Clientes</h2>
            <p class="TextoSuave mb-0">
                Encargados e interesados en los servicios del consultorio.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#ModalNuevoCliente">
            <i class="bi bi-plus-lg me-1"></i>Nuevo cliente
        </button>
    </div>

    <div class="Tarjeta p-3 p-md-4">

        <div class="row g-2 mb-3" data-tabla-buscador="TablaClientes">

            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="search"
                           class="form-control"
                           data-buscar-texto
                           placeholder="Buscar por nombre, teléfono o correo">
                </div>
            </div>

            <div class="col-md-5">
                <select class="form-select"
                        data-buscar-estado
                        aria-label="Filtrar por estado">

                    <option value="">Todos los estados</option>
                    <option value="Nuevo">Nuevo</option>
                    <option value="Contactado">Contactado</option>
                    <option value="Cita agendada">Cita agendada</option>
                    <option value="Cliente activo">Cliente activo</option>
                    <option value="Inactivo">Inactivo</option>
                    <option value="En seguimiento">En seguimiento</option>

                </select>
            </div>

        </div>

        <div class="table-responsive">

            <table class="table align-middle mb-0" id="TablaClientes">

                <thead>
                    <tr>
                        <th>Encargado</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Servicio de interés</th>
                        <th>Estudiante</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var cliente in Model)
                        {
                            <tr data-fila data-estado="@cliente.Estado">

                                <td data-campo="encargado">
                                    @cliente.Encargado
                                </td>

                                <td data-campo="telefono">
                                    @cliente.Telefono
                                </td>

                                <td data-campo="correo">
                                    @cliente.Correo
                                </td>

                                <td data-campo="servicio">
                                    @cliente.Servicio
                                </td>

                                <td data-campo="estudiante">
                                    @cliente.Estudiante
                                </td>

                                <td>
                                    @{
                                        var estado = cliente.Estado?.Trim();

                                        var claseEstado = estado switch
                                        {
                                            "Nuevo" => "badge-estado-nuevo",
                                            "Contactado" => "badge-estado-contactado",
                                            "Cita agendada" => "badge-estado-cita-agendada",
                                            "Cliente activo" => "badge-estado-activo",
                                            "Inactivo" => "badge-estado-inactivo",
                                            "En seguimiento" => "badge-estado-seguimiento",
                                            _ => "NO-ENCONTRADO"
                                        };
                                    }

                                    <span class="badge @claseEstado"
                                          data-campo-badge="estado">
                                        @estado
                                    </span>
                                </td>

                                <td class="TablaAcciones">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary border-0"
                                            data-accion="ver"
                                            data-bs-toggle="tooltip"
                                            title="Ver detalle"
                                            data-id="@cliente.Id">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary border-0"
                                            data-accion="editar"
                                            data-bs-toggle="tooltip"
                                            title="Editar"
                                            data-id="@cliente.Id">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger border-0"
                                            data-accion="eliminar"
                                            data-bs-toggle="tooltip"
                                            title="Eliminar"
                                            data-id="@cliente.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

        <div id="EstadoVacio"
             class="text-center py-4"
             style="display:@(Model == null || !Model.Any() ? "block" : "none");">

            <p class="TextoSuave mt-2 mb-0">
                No hay clientes registrados.
            </p>

        </div>

    </div>
    ```

</main>

<!-- MODAL NUEVO CLIENTE -->

<div class="modal fade"
     id="ModalNuevoCliente"
     tabindex="-1"
     aria-hidden="true">

    ```
    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <form asp-controller="Admin"
                  asp-action="RegistrarCliente"
                  method="post">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Nuevo cliente
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label for="NombreEncargado"
                                   class="form-label CampoObligatorio">
                                Nombre del encargado
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="NombreEncargado"
                                   name="NombreEncargado"
                                   required>

                            <div class="invalid-feedback">
                                El nombre del encargado es obligatorio.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label for="ApellidoEncargado"
                                   class="form-label CampoObligatorio">
                                Apellido del encargado
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="ApellidoEncargado"
                                   name="ApellidoEncargado"
                                   required>

                            <div class="invalid-feedback">
                                El apellido del encargado es obligatorio.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label for="TelefonoNuevoCliente"
                                   class="form-label CampoObligatorio">
                                Teléfono
                            </label>

                            <input type="tel"
                                   class="form-control"
                                   id="TelefonoNuevoCliente"
                                   name="Telefono"
                                   placeholder="8888-8888"
                                   required>

                            <div class="invalid-feedback">
                                El teléfono es obligatorio.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label for="CorreoNuevoCliente"
                                   class="form-label">
                                Correo electrónico
                            </label>

                            <input type="email"
                                   class="form-control"
                                   id="CorreoNuevoCliente"
                                   name="Correo">

                            <div class="invalid-feedback">
                                El correo no es válido.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label for="ServicioInteresNuevoCliente"
                                   class="form-label CampoObligatorio">
                                Servicio de interés
                            </label>

                            <select class="form-select"
                                    id="ServicioInteresNuevoCliente"
                                    name="IdServicioInteres"
                                    required>

                                <option value="">
                                    Seleccione una opción
                                </option>

                                @if (ViewBag.Servicios != null)
                                {
                                    foreach (var servicio in ViewBag.Servicios)
                                    {
                                        <option value="@servicio.IdServicio">
                                            @servicio.Nombre
                                        </option>
                                    }
                                }

                            </select>

                            <div class="invalid-feedback">
                                Debe seleccionar un servicio de interés.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label for="NombreEstudiante"
                                   class="form-label CampoObligatorio">
                                Nombre del estudiante
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="NombreEstudiante"
                                   name="NombreEstudiante"
                                   required>

                            <div class="invalid-feedback">
                                El nombre del estudiante es obligatorio.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label for="ApellidoEstudiante"
                                   class="form-label CampoObligatorio">
                                Apellido del estudiante
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="ApellidoEstudiante"
                                   name="ApellidoEstudiante"
                                   required>

                            <div class="invalid-feedback">
                                El apellido del estudiante es obligatorio.
                            </div>

                        </div>


                        <div class="col-12">

                            <label for="Observaciones"
                                   class="form-label">
                                Observaciones
                            </label>

                            <textarea class="form-control"
                                      id="Observaciones"
                                      name="Observaciones"
                                      rows="3"></textarea>

                            <div class="invalid-feedback"></div>

                        </div>

                    </div>


                    <div class="alert alert-light border mt-3 mb-0 small">

                        <i class="bi bi-info-circle text-primary me-1"></i>

                        El estudiante se asociará automáticamente al encargado
                        durante el registro.

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar cliente
                    </button>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

