@model MenteActiva.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<main class="PrincipalAdmin">
    @if (ViewBag.ErrorCarga != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.ErrorCarga
        </div>
    }

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1">Bienvenida, Marcela</h2>
            <p class="TextoSuave mb-0">Este es el resumen general de tu consultorio esta semana.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
                <div class="TarjetaResumen-Icono"><i class="bi bi-mortarboard"></i></div>
                <div>
                    <div class="TarjetaResumen-Valor">@Model.EstudiantesActivos</div>
                    <div class="TextoSuave small">Estudiantes activos</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
                <div class="TarjetaResumen-Icono"><i class="bi bi-calendar-week"></i></div>
                <div>
                    <div class="TarjetaResumen-Valor">@Model.CitasSemana</div>
                    <div class="TextoSuave small">Citas de la semana</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
                <div class="TarjetaResumen-Icono"><i class="bi bi-cash-coin"></i></div>
                <div>
                    <div class="TarjetaResumen-Valor">@Model.PagosPendientes</div>
                    <div class="TextoSuave small">Pagos pendientes</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
                <div class="TarjetaResumen-Icono"><i class="bi bi-person-plus"></i></div>
                <div>
                    <div class="TarjetaResumen-Valor">@Model.SolicitudesSinAtender</div>
                    <div class="TextoSuave small">Contactos sin atender</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-7">
            <div class="Tarjeta p-3 p-md-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h3 class="mb-0">Clases de la semana</h3>
                    <!-- Razor: asp-controller="Agenda" asp-action="Index" -->
                    <a href="/Admin/Agenda" class="small">Ver agenda completa</a>
                </div>

                <div class="list-group list-group-flush">
                    @if (Model.CitasSemanaDetalle.Any())
                    {
                        @foreach (var cita in Model.CitasSemanaDetalle)
                        {
                            <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                                <div>
                                    <div class="fw-semibold">
                                        @cita.FechaHoraInicio.ToString("ddd dd MMM · h:mm tt",
                                            new System.Globalization.CultureInfo("es-CR"))
                                    </div>
                                    <div class="TextoSuave small">
                                        @cita.NombreEstudiante — @cita.TipoSesion
                                    </div>
                                </div>
                                <span class="badge badge-cita-programada">@cita.Estado</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="TextoSuave py-3">
                            No hay citas programadas para esta semana.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="Tarjeta p-3 p-md-4 h-100">
                <h3 class="mb-3">Alertas importantes</h3>

                <div class="list-group list-group-flush">
                    @if (Model.Alertas.Any())
                    {
                        @foreach (var alerta in Model.Alertas)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action px-0 border-0 border-bottom text-start"
                                    data-modal-detalle="ModalDetalleAlerta"
                                    data-valor-titulo="@alerta.Titulo"
                                    data-valor-fecha="@alerta.Fecha.ToString("dd/MM/yyyy HH:mm")"
                                    data-valor-detalle="@alerta.Detalle">
                                <div class="d-flex gap-2">
                                    <i class="bi bi-exclamation-circle text-warning"></i>
                                    <div>
                                        <div class="fw-semibold">@alerta.Titulo</div>
                                        <div class="TextoSuave small">@alerta.Detalle</div>
                                    </div>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="TextoSuave py-3">
                            No hay alertas importantes pendientes.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="Tarjeta p-3 p-md-4 h-100">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <h3 class="mb-0">Actividad reciente</h3>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Filtrar actividad" data-filtro-grupo="ActividadReciente">
                        <button type="button" class="btn btn-outline-secondary active" data-filtro-valor="Todas">Todas</button>
                        <button type="button" class="btn btn-outline-secondary" data-filtro-valor="Citas">Citas</button>
                        <button type="button" class="btn btn-outline-secondary" data-filtro-valor="Pagos">Pagos</button>
                        <button type="button" class="btn btn-outline-secondary" data-filtro-valor="Clientes">Clientes</button>
                    </div>
                </div>

                <div class="list-group list-group-flush">
                    @if (Model.ActividadesRecientes.Any())
                    {
                        @foreach (var actividad in Model.ActividadesRecientes)
                        {
                            var textoActividad = $"{actividad.Titulo} {actividad.Descripcion}".ToUpperInvariant();

                            var categoria = textoActividad.Contains("CITA")
                                ? "Citas"
                                : textoActividad.Contains("PAGO")
                                    ? "Pagos"
                                    : textoActividad.Contains("ENCARGADO")
                                        || textoActividad.Contains("ESTUDIANTE")
                                        || textoActividad.Contains("CLIENTE")
                                            ? "Clientes"
                                            : "Otras";

                            var icono = categoria == "Citas"
                                ? "bi-calendar-check text-primary"
                                : categoria == "Pagos"
                                    ? "bi-cash-coin text-success"
                                    : categoria == "Clientes"
                                        ? "bi-person-plus text-primary"
                                        : "bi-clock-history text-secondary";

                            <div class="list-group-item px-0"
                                 data-filtro-item="ActividadReciente"
                                 data-tipo="@categoria">
                                <div class="d-flex gap-2">
                                    <i class="bi @icono"></i>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">@actividad.Titulo</div>
                                        <div class="TextoSuave small">@actividad.Descripcion</div>
                                    </div>
                                    <div class="TextoSuave small text-nowrap">
                                        @actividad.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="TextoSuave py-3">
                            No hay actividad reciente registrada.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="Tarjeta p-3 p-md-4 h-100 d-flex flex-column">
                <h3 class="mb-2">Reportes generales</h3>
                <p class="TextoSuave">Consultá el progreso y la actividad general del consultorio.</p>
                <div class="mt-auto d-grid gap-2">
                    <!-- Razor: asp-controller="Reportes" asp-action="Index" -->
                    <a href="/Admin/Reportes" class="btn btn-outline-primary">
                        <i class="bi bi-bar-chart-line me-1"></i>Ver reportes
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="ModalDetalleAlerta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-campo="titulo">Detalle de alerta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="TextoSuave small mb-2" data-campo="fecha"></p>
                <p class="mb-0" data-campo="detalle"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Bootstrap 5 JS Bundle (CDN) -->
}
