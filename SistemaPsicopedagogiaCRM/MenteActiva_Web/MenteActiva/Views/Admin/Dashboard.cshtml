@{ Layout = null; }\n<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Mente Activa Psicopedagogía</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500&family=Poppins:wght@@600;700&display=swap" rel="stylesheet">

  <link href="~/css/Styles.css" rel="stylesheet">
</head>
<body>

  <div class="WrapperAdmin">

    <div class="FondoSidebarMovil"></div>

    <aside class="SidebarAdmin">
      <a href="/Admin/Dashboard" class="SidebarAdmin-Marca">
        <img src="~/img/LogoMenteActiva.jpeg" alt="Logo Mente Activa Psicopedagogía" class="LogoMarca">
        <span>Mente Activa</span>
      </a>

      <nav class="SidebarAdmin-Nav">
        <!-- Razor: asp-controller="Dashboard" asp-action="Index" -->
        <a href="/Admin/Dashboard" class="SidebarAdmin-Enlace">
          <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>
        <!-- Razor: asp-controller="Clientes" asp-action="Index" -->
        <a href="/Admin/Clientes" class="SidebarAdmin-Enlace">
          <i class="bi bi-person-lines-fill"></i><span>Clientes</span>
        </a>
        <!-- Razor: asp-controller="Estudiantes" asp-action="Index" -->
        <a href="/Admin/Estudiantes" class="SidebarAdmin-Enlace">
          <i class="bi bi-mortarboard"></i><span>Estudiantes</span>
        </a>
        <!-- Razor: asp-controller="Agenda" asp-action="Index" -->
        <a href="/Admin/Agenda" class="SidebarAdmin-Enlace">
          <i class="bi bi-calendar3"></i><span>Agenda</span>
        </a>
        <!-- Razor: asp-controller="Sesiones" asp-action="Index" -->
        <a href="/Admin/Sesiones" class="SidebarAdmin-Enlace">
          <i class="bi bi-journal-text"></i><span>Sesiones</span>
        </a>
        <!-- Razor: asp-controller="Planes" asp-action="Index" -->
        <a href="/Admin/Planes" class="SidebarAdmin-Enlace">
          <i class="bi bi-clipboard2-pulse"></i><span>Planes de intervención</span>
        </a>
        <!-- Razor: asp-controller="Reportes" asp-action="Index" -->
        <a href="/Admin/Reportes" class="SidebarAdmin-Enlace">
          <i class="bi bi-bar-chart-line"></i><span>Reportes</span>
        </a>
        <!-- Razor: asp-controller="Pagos" asp-action="Index" -->
        <a href="/Admin/Pagos" class="SidebarAdmin-Enlace">
          <i class="bi bi-cash-coin"></i><span>Pagos</span>
        </a>
        <!-- Razor: asp-controller="Comunicacion" asp-action="Index" -->
        <a href="/Admin/Comunicacion" class="SidebarAdmin-Enlace">
          <i class="bi bi-chat-dots"></i><span>Comunicación</span>
        </a>
        <!-- Razor: asp-controller="Materiales" asp-action="Index" -->
        <a href="/Admin/Materiales" class="SidebarAdmin-Enlace">
          <i class="bi bi-folder2-open"></i><span>Materiales</span>
        </a>
        <!-- Razor: asp-controller="Usuarios" asp-action="Index" -->
        <a href="/Admin/Usuarios" class="SidebarAdmin-Enlace">
          <i class="bi bi-people-fill"></i><span>Usuarios internos</span>
        </a>
        <!-- Razor: asp-controller="UsuariosExternos" asp-action="Index" -->
        <a href="/Admin/UsuariosExternos" class="SidebarAdmin-Enlace">
          <i class="bi bi-person-badge"></i><span>Usuarios externos</span>
        </a>
      </nav>
    </aside>

    <div class="ContenidoAdmin">

      <header class="TopbarAdmin">
        <div class="d-flex align-items-center gap-3">
          <button type="button" class="BotonSidebarToggle" aria-label="Abrir menú">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="TopbarAdmin-Titulo">Dashboard</h1>
        </div>
        <div class="dropdown">
          <button type="button" class="TopbarAdmin-Usuario" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="d-none d-sm-inline">Marcela Solano</span>
            <div class="TopbarAdmin-Avatar">MS</div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <!-- Razor: asp-controller="Cuenta" asp-action="MiPerfil" -->
            <li><a class="dropdown-item" href="/Admin/MiPerfil"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
            <li><hr class="dropdown-divider"></li>
            <!-- Razor: asp-controller="Cuenta" asp-action="CerrarSesion" -->
            <li><a class="dropdown-item" href="/Cuenta/Login"><i class="bi bi-box-arrow-left me-2"></i>Cerrar sesión</a></li>
          </ul>
        </div>
      </header>

      <main class="PrincipalAdmin">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
          <div>
            <h2 class="mb-1">Bienvenida, Marcela</h2>
            <p class="TextoSuave mb-0">Este es el resumen general de tu consultorio esta semana.</p>
          </div>
        </div>

        <!-- Razor: reemplazar por @@foreach (var indicador in Model.Indicadores) -->
        <div class="row g-3 mb-4">
          <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
              <div class="TarjetaResumen-Icono"><i class="bi bi-mortarboard"></i></div>
              <div>
                <div class="TarjetaResumen-Valor">18</div>
                <div class="TextoSuave small">Estudiantes activos</div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
              <div class="TarjetaResumen-Icono"><i class="bi bi-calendar-week"></i></div>
              <div>
                <div class="TarjetaResumen-Valor">12</div>
                <div class="TextoSuave small">Citas de la semana</div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
              <div class="TarjetaResumen-Icono"><i class="bi bi-cash-coin"></i></div>
              <div>
                <div class="TarjetaResumen-Valor">3</div>
                <div class="TextoSuave small">Pagos pendientes</div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-3">
            <div class="TarjetaResumen d-flex align-items-center gap-3">
              <div class="TarjetaResumen-Icono"><i class="bi bi-person-plus"></i></div>
              <div>
                <div class="TarjetaResumen-Valor">5</div>
                <div class="TextoSuave small">Nuevos contactos</div>
              </div>
            </div>
          </div>
        </div>
        <!-- /Razor -->

        <div class="row g-3 mb-3">
          <div class="col-lg-7">
            <div class="Tarjeta p-3 p-md-4 h-100">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="mb-0">Clases de la semana</h3>
                <!-- Razor: asp-controller="Agenda" asp-action="Index" -->
                <a href="/Admin/Agenda" class="small">Ver agenda completa</a>
              </div>

              <div class="list-group list-group-flush">
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                  <div>
                    <div class="fw-semibold">Lun 13 jul · 9:00 a. m.</div>
                    <div class="TextoSuave small">María Rodríguez — Tutoría académica</div>
                  </div>
                  <span class="badge badge-cita-confirmada">Confirmada</span>
                </div>
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                  <div>
                    <div class="fw-semibold">Lun 13 jul · 2:00 p. m.</div>
                    <div class="TextoSuave small">Diego Vargas — Sesión psicopedagógica</div>
                  </div>
                  <span class="badge badge-cita-programada">Programada</span>
                </div>
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                  <div>
                    <div class="fw-semibold">Mar 14 jul · 10:00 a. m.</div>
                    <div class="TextoSuave small">Ana Castro — Evaluación</div>
                  </div>
                  <span class="badge badge-cita-programada">Programada</span>
                </div>
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                  <div>
                    <div class="fw-semibold">Mié 15 jul · 3:30 p. m.</div>
                    <div class="TextoSuave small">José Fernández — Reunión con padres</div>
                  </div>
                  <span class="badge badge-cita-confirmada">Confirmada</span>
                </div>
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                  <div>
                    <div class="fw-semibold">Jue 16 jul · 11:00 a. m.</div>
                    <div class="TextoSuave small">Valeria Mora — Tutoría académica</div>
                  </div>
                  <span class="badge badge-cita-completada">Completada</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-5">
            <div class="Tarjeta p-3 p-md-4 h-100">
              <h3 class="mb-3">Alertas importantes</h3>

              <div class="list-group list-group-flush">
                <button type="button" class="list-group-item list-group-item-action px-0 border-0 border-bottom text-start"
                        data-modal-detalle="ModalDetalleAlerta"
                        data-valor-titulo="Pagos por vencer"
                        data-valor-fecha="12 de julio, 2026"
                        data-valor-detalle="Los pagos de Carlos Jiménez, Ana Castro y José Fernández vencen esta semana.">
                  <div class="d-flex gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                    <div>
                      <div class="fw-semibold">3 pagos pendientes por vencer</div>
                      <div class="TextoSuave small">Ver detalle</div>
                    </div>
                  </div>
                </button>
                <button type="button" class="list-group-item list-group-item-action px-0 border-0 border-bottom text-start"
                        data-modal-detalle="ModalDetalleAlerta"
                        data-valor-titulo="Cita sin confirmar"
                        data-valor-fecha="12 de julio, 2026"
                        data-valor-detalle="La cita de Diego Vargas del 13 de julio aún no ha sido confirmada por el encargado.">
                  <div class="d-flex gap-2">
                    <i class="bi bi-calendar-x text-danger"></i>
                    <div>
                      <div class="fw-semibold">Cita sin confirmar</div>
                      <div class="TextoSuave small">Ver detalle</div>
                    </div>
                  </div>
                </button>
                <button type="button" class="list-group-item list-group-item-action px-0 border-0 text-start"
                        data-modal-detalle="ModalDetalleAlerta"
                        data-valor-titulo="Nuevo contacto sin atender"
                        data-valor-fecha="10 de julio, 2026"
                        data-valor-detalle="Se recibió un nuevo contacto de Laura Méndez hace 2 días sin respuesta.">
                  <div class="d-flex gap-2">
                    <i class="bi bi-person-exclamation text-primary"></i>
                    <div>
                      <div class="fw-semibold">Nuevo contacto sin atender</div>
                      <div class="TextoSuave small">Ver detalle</div>
                    </div>
                  </div>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-lg-8">
            <div class="Tarjeta p-3 p-md-4 h-100">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h3 class="mb-0">Actividad reciente</h3>
                <div class="btn-group btn-group-sm" role="group" aria-label="Filtrar actividad" data-filtro-grupo="ActividadReciente">
                  <button type="button" class="btn btn-outline-secondary active" data-filtro-valor="Todas">Todas</button>
                  <button type="button" class="btn btn-outline-secondary" data-filtro-valor="Citas">Citas</button>
                  <button type="button" class="btn btn-outline-secondary" data-filtro-valor="Pagos">Pagos</button>
                  <button type="button" class="btn btn-outline-secondary" data-filtro-valor="Clientes">Clientes</button>
                </div>
              </div>

              <div class="list-group list-group-flush">
                <div class="list-group-item px-0" data-filtro-item="ActividadReciente" data-tipo="Citas">
                  <div class="d-flex gap-2">
                    <i class="bi bi-calendar-check text-primary"></i>
                    <div class="flex-grow-1">
                      <div class="fw-semibold">Cita confirmada</div>
                      <div class="TextoSuave small">María Rodríguez confirmó su sesión del 13 de julio.</div>
                    </div>
                    <div class="TextoSuave small text-nowrap">Hace 2 h</div>
                  </div>
                </div>
                <div class="list-group-item px-0" data-filtro-item="ActividadReciente" data-tipo="Pagos">
                  <div class="d-flex gap-2">
                    <i class="bi bi-cash-coin text-success"></i>
                    <div class="flex-grow-1">
                      <div class="fw-semibold">Pago registrado</div>
                      <div class="TextoSuave small">Se registró un pago de ₡15 000 de Carlos Jiménez.</div>
                    </div>
                    <div class="TextoSuave small text-nowrap">Hace 5 h</div>
                  </div>
                </div>
                <div class="list-group-item px-0" data-filtro-item="ActividadReciente" data-tipo="Clientes">
                  <div class="d-flex gap-2">
                    <i class="bi bi-person-plus text-primary"></i>
                    <div class="flex-grow-1">
                      <div class="fw-semibold">Nuevo cliente</div>
                      <div class="TextoSuave small">Se registró a Laura Méndez como nuevo contacto.</div>
                    </div>
                    <div class="TextoSuave small text-nowrap">Hace 1 día</div>
                  </div>
                </div>
                <div class="list-group-item px-0" data-filtro-item="ActividadReciente" data-tipo="Citas">
                  <div class="d-flex gap-2">
                    <i class="bi bi-arrow-repeat text-primary"></i>
                    <div class="flex-grow-1">
                      <div class="fw-semibold">Cita reprogramada</div>
                      <div class="TextoSuave small">La cita de Ana Castro se movió al 14 de julio.</div>
                    </div>
                    <div class="TextoSuave small text-nowrap">Hace 1 día</div>
                  </div>
                </div>
                <div class="list-group-item px-0" data-filtro-item="ActividadReciente" data-tipo="Pagos">
                  <div class="d-flex gap-2">
                    <i class="bi bi-exclamation-circle text-warning"></i>
                    <div class="flex-grow-1">
                      <div class="fw-semibold">Pago pendiente</div>
                      <div class="TextoSuave small">El pago de José Fernández vence el 16 de julio.</div>
                    </div>
                    <div class="TextoSuave small text-nowrap">Hace 2 días</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="Tarjeta p-3 p-md-4 h-100 d-flex flex-column">
              <h3 class="mb-2">Reportes generales</h3>
              <p class="TextoSuave">Consultá el progreso y la actividad general del consultorio.</p>
              <div class="mt-auto d-grid gap-2">
                <!-- Razor: asp-controller="Reportes" asp-action="Index" -->
                <a href="/Admin/Reportes" class="btn btn-outline-primary">
                  <i class="bi bi-bar-chart-line me-1"></i>Ver reportes
                </a>
                <button type="button" class="btn btn-primary" onclick="MostrarToast('Reporte generado correctamente (simulado).')">
                  <i class="bi bi-download me-1"></i>Descargar PDF
                </button>
              </div>
            </div>
          </div>
        </div>
      </main>

      <div class="modal fade" id="ModalDetalleAlerta" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" data-campo="titulo">Detalle de alerta</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <p class="TextoSuave small mb-2" data-campo="fecha"></p>
              <p class="mb-0" data-campo="detalle"></p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenedor de toasts de confirmación -->
  <div class="ContenedorToasts"></div>

  <!-- Bootstrap 5 JS Bundle (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/Main.js"></script>
</body>
</html>
