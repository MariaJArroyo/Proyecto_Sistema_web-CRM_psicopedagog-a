                        </label>

                        <div class="position-relative">

                            <input id="EditarNombreArea"
                                   type="text"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   autocomplete="off">

                            <div id="ResultadosEditarArea"
                                 class="list-group position-absolute w-100 shadow-sm d-none"
