@model MenteActiva.Models.FichaEstudianteViewModel

@{
    ViewData["Title"] = "Ficha de estudiante";

    var nombreCompleto = $"{Model.Nombre} {Model.PrimerApellido} {Model.SegundoApellido}".Trim();

    var edad = Model.FechaNacimiento.HasValue
        ? DateTime.Today.Year
          - Model.FechaNacimiento.Value.Year
          - (
              DateTime.Today.DayOfYear < Model.FechaNacimiento.Value.DayOfYear
                ? 1
                : 0
            )
        : 0;
}

<main class="PrincipalAdmin">

    <a href="@Url.Action("Estudiantes", "Admin")"
       class="d-inline-flex align-items-center gap-1 small mb-3">

        <i class="bi bi-arrow-left"></i>
        Volver a estudiantes

    </a>


    <!-- Encabezado -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">

        <div>

            <h2 class="mb-1" id="FichaNombre">
                @nombreCompleto
            </h2>

            <p class="TextoSuave mb-0">
                Información individual del estudiante
            </p>

        </div>

        <button type="button"
                class="btn btn-outline-primary"
                data-bs-toggle="modal"
                data-bs-target="#ModalEditarFicha">

            <i class="bi bi-pencil me-1"></i>
            Editar ficha

        </button>

    </div>


    <div class="row g-3">

        <!-- CONTENIDO PRINCIPAL -->
        <div class="col-lg-8">


            <!-- Datos generales -->
            <div class="Tarjeta p-3 p-md-4 mb-3">

                <h3 class="mb-3">
                    Datos generales
                </h3>

                <dl class="row mb-0">

                    <dt class="col-sm-4 TextoSuave fw-normal">
                        Nombre completo
                    </dt>

                    <dd class="col-sm-8"
                        id="FichaDatoNombre">

                        @nombreCompleto

                    </dd>


                    <dt class="col-sm-4 TextoSuave fw-normal">
                        Edad
                    </dt>

                    <dd class="col-sm-8"
                        id="FichaDatoEdad">

                        @(edad > 0 ? $"{edad} años" : "-")

                    </dd>


                    <dt class="col-sm-4 TextoSuave fw-normal">
                        Nivel educativo
                    </dt>

                    <dd class="col-sm-8"
                        id="FichaDatoNivel">

                        @(Model.NivelEducativo ?? "-")

                    </dd>


                    <dt class="col-sm-4 TextoSuave fw-normal">
                        Institución
                    </dt>

                    <dd class="col-sm-8 mb-0"
                        id="FichaDatoInstitucion">

                        @(Model.Institucion ?? "-")

                    </dd>

                </dl>

            </div>


            <!-- Información académica -->
            <div class="Tarjeta p-3 p-md-4 mb-3">

                <h3 class="mb-3">
                    Información académica
                </h3>

                <dl class="row mb-0">

                    <dt class="col-sm-4 TextoSuave fw-normal">
                        Áreas de dificultad
                    </dt>

                    <dd class="col-sm-8"
                        id="FichaDatoMateria">

                        @(Model.AreasDificultad ?? "No registradas")

                    </dd>


                    <dt class="col-sm-4 TextoSuave fw-normal">
                        Resumen
                    </dt>

                    <dd class="col-sm-8 mb-0"
                        id="FichaDatoResumen">

                        @(Model.Observaciones ?? "No hay observaciones registradas.")

                    </dd>

                </dl>

            </div>


            <!-- Áreas de dificultad -->
            <div class="Tarjeta p-3 p-md-4 mb-3">

                <div class="d-flex align-items-center justify-content-between mb-3">

                    <h3 class="mb-0">
                        Áreas de dificultad
                    </h3>

                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#ModalAgregarArea">

                        <i class="bi bi-plus-lg me-1"></i>
                        Agregar área

                    </button>

                </div>


                <div class="list-group list-group-flush"
                     id="ListaAreasDificultad">

                    @if (!string.IsNullOrWhiteSpace(Model.AreasDificultad))
                    {
                        var areas = Model.AreasDificultad.Split(
                            ",",
                            StringSplitOptions.RemoveEmptyEntries
                        );

                        foreach (var area in areas)
                        {
                            <div class="list-group-item px-0">

                                <span class="badge badge-etiqueta-morado mb-1">
                                    @area.Trim()
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="list-group-item px-0">

                            <p class="mb-0 TextoSuave">
                                No hay áreas de dificultad registradas.
                            </p>

                        </div>
                    }

                </div>

            </div>


            <!-- Necesidades de apoyo -->
            <div class="Tarjeta p-3 p-md-4">

                <h3 class="mb-3">
                    Necesidades de apoyo
                </h3>

                @if (!string.IsNullOrWhiteSpace(Model.NecesidadesApoyo))
                {
                    <p class="mb-0">
                        @Model.NecesidadesApoyo
                    </p>
                }
                else
                {
                    <p class="TextoSuave mb-0">
                        No hay necesidades de apoyo registradas.
                    </p>
                }

            </div>

        </div>


        <!-- COLUMNA DERECHA -->
        <div class="col-lg-4">

            <div class="Tarjeta p-3 p-md-4">

                <h3 class="mb-3">
                    Información del estudiante
                </h3>

                <div class="d-flex align-items-center gap-2 mb-3">

                    <div class="TopbarAdmin-Avatar">
                        @(
                            string.IsNullOrWhiteSpace(Model.Nombre)
                                ? "E"
                                : Model.Nombre.Substring(0, 1).ToUpper()
                        )
                    </div>

                    <div>

                        <div class="fw-semibold">
                            @nombreCompleto
                        </div>

                        <div class="TextoSuave small">
                            Estudiante
                        </div>

                    </div>

                </div>


                <ul class="list-unstyled TextoSuave small mb-0">

                    <li class="mb-2">

                        <i class="bi bi-mortarboard me-2"></i>

                        @(Model.NivelEducativo ?? "Nivel no registrado")

                    </li>

                    <li class="mb-2">

                        <i class="bi bi-building me-2"></i>

                        @(Model.Institucion ?? "Institución no registrada")

                    </li>

                    @if (Model.FechaNacimiento.HasValue)
                    {
                        <li>

                            <i class="bi bi-calendar-event me-2"></i>

                            @Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")

                        </li>
                    }

                </ul>

            </div>

        </div>

    </div>

</main>


<!-- Modal agregar área -->
<div class="modal fade"
     id="ModalAgregarArea"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form id="FormularioAgregarArea"
                  novalidate>

                <div class="modal-header">

                    <h5 class="modal-title">
                        Agregar área de dificultad
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">

                        <label for="NombreArea"
                               class="form-label">

                            Área

                        </label>

                        <input type="text"
                               class="form-control"
                               id="NombreArea"
                               name="NombreArea"
                               placeholder="Ej. Razonamiento lógico-matemático">

                    </div>

                    <div class="mb-1">

                        <label for="ObservacionArea"
                               class="form-label">

                            Observación

                        </label>

                        <textarea class="form-control"
                                  id="ObservacionArea"
                                  name="ObservacionArea"
                                  rows="3"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Agregar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- Modal editar ficha -->
<div class="modal fade"
     id="ModalEditarFicha"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <form id="FormularioEditarFicha"
                  novalidate>

                <div class="modal-header">

                    <h5 class="modal-title">
                        Editar ficha del estudiante
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label for="EditarNombreFicha"
                                   class="form-label">

                                Nombre completo

                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="EditarNombreFicha"
                                   value="@nombreCompleto">

                        </div>


                        <div class="col-md-3">

                            <label for="EditarEdadFicha"
                                   class="form-label">

                                Edad

                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="EditarEdadFicha"
                                   value="@(edad > 0 ? $"{edad} años" : "")">

                        </div>


                        <div class="col-md-3">

                            <label for="EditarNivelFicha"
                                   class="form-label">

                                Nivel educativo

                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="EditarNivelFicha"
                                   value="@Model.NivelEducativo">

                        </div>


                        <div class="col-md-6">

                            <label for="EditarInstitucionFicha"
                                   class="form-label">

                                Institución

                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="EditarInstitucionFicha"
                                   value="@Model.Institucion">

                        </div>


                        <div class="col-md-6">

                            <label for="EditarMateriaFicha"
                                   class="form-label">

                                Área(s) de dificultad

                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="EditarMateriaFicha"
                                   value="@Model.AreasDificultad">

                        </div>


                        <div class="col-12">

                            <label for="EditarResumenFicha"
                                   class="form-label">

                                Observaciones

                            </label>

                            <textarea class="form-control"
                                      id="EditarResumenFicha"
                                      rows="3">@Model.Observaciones</textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Guardar cambios

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/estudianteFicha.js"></script>

}