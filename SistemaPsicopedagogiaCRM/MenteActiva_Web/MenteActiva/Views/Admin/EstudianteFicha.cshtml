
@model MenteActiva.Models.FichaEstudianteViewModel

@{
    ViewData["Title"] = "Ficha de estudiante";

    var niveles = ViewBag.NivelesEducativos
        as List<MenteActiva.Models.NivelEducativoViewModel>
        ?? new List<MenteActiva.Models.NivelEducativoViewModel>();

    var nombreCompleto =
        $"{Model.Nombre} {Model.PrimerApellido} {Model.SegundoApellido}".Trim();

    var puedeVerDocumentos =
        User.IsInRole("Administrador") || User.IsInRole("Psicopedagoga");

    // Foto: la ven todos los que ven la ficha; la cambian los mismos que los documentos
    var puedeCambiarFoto = puedeVerDocumentos;
    var tieneFoto = Model.FotoFecha.HasValue;
    var urlFoto = tieneFoto
        ? Url.Action("FotoEstudiante", "Admin", new { id = Model.IdEstudiante, v = Model.FotoFecha!.Value.Ticks })
        : null;
    var iniciales = string.Concat(
        new[] { Model.Nombre, Model.PrimerApellido }
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Select(p => char.ToUpperInvariant(p.Trim()[0])));

    int? edad = null;

    if (Model.FechaNacimiento.HasValue)
    {
        var nacimiento = Model.FechaNacimiento.Value.Date;
        var hoy = DateTime.Today;
        var anios = hoy.Year - nacimiento.Year;

        if (nacimiento > hoy.AddYears(-anios))
        {
            anios--;
        }

        edad = anios;
    }
}

<main class="PrincipalAdmin">

    <partial name="_AvisoCarga" />

    <div id="ContenedorMensaje"></div>

    <a href="@Url.Action("Estudiantes", "Admin")"
       class="d-inline-flex align-items-center gap-1 small mb-3">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        Volver a estudiantes
    </a>

    <!-- Encabezado -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div class="d-flex align-items-center gap-3 min-w-0">

            @* Foto del estudiante: las iniciales cuando no tiene *@
            <div class="FotoEstudiante @(tieneFoto ? "TieneFoto" : "")" id="FotoEstudiante"
                 data-id-estudiante="@Model.IdEstudiante"
                 data-url-foto="@Url.Action("FotoEstudiante", "Admin")"
                 data-url-subir="@Url.Action("SubirFotoEstudiante", "Admin")"
                 data-url-quitar="@Url.Action("QuitarFotoEstudiante", "Admin")">
                <img src="@urlFoto" alt="Foto de @nombreCompleto" class="FotoEstudiante-Imagen" @(tieneFoto ? "" : "hidden")>
                <span class="FotoEstudiante-Iniciales" aria-hidden="true" @(tieneFoto ? "hidden" : "")>@iniciales</span>

                @if (puedeCambiarFoto)
                {
                    <div class="dropdown FotoEstudiante-Menu">
                        <button type="button" class="FotoEstudiante-Boton" data-bs-toggle="dropdown" aria-expanded="false"
                                title="Cambiar foto" aria-label="Cambiar la foto del estudiante">
                            <i class="bi bi-camera-fill" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <button type="button" class="dropdown-item" data-foto-elegir>
                                    <i class="bi bi-upload me-2" aria-hidden="true"></i><span data-texto-elegir>@(tieneFoto ? "Cambiar foto" : "Subir foto")</span>
                                </button>
                            </li>
                            <li @(tieneFoto ? "" : "hidden") data-foto-quitar-item>
                                <button type="button" class="dropdown-item text-danger" data-foto-quitar>
                                    <i class="bi bi-trash me-2" aria-hidden="true"></i>Quitar foto
                                </button>
                            </li>
                        </ul>
                    </div>
                    <input type="file" class="d-none" id="ArchivoFotoEstudiante" accept="image/jpeg,image/png,image/webp">
                }
            </div>

            <div class="min-w-0">
                <h2 id="FichaNombre" class="mb-1">@nombreCompleto</h2>
                <p class="TextoSuave mb-0">Información individual del estudiante</p>
            </div>
        </div>
    </div>

    <!-- Layout de dos columnas -->
    <div class="row g-3 align-items-start">

        <!-- COLUMNA IZQUIERDA -->
        <div class="col-lg-7 d-flex flex-column gap-3">

            <!-- Datos generales y necesidades -->
            <div class="Tarjeta p-3 p-md-4">

                <h3 class="mb-3">Datos generales</h3>

                <dl class="row mb-0">

                    <dt class="col-sm-4 TextoSuave fw-normal">Nombre completo</dt>
                    <dd id="FichaDatoNombre" class="col-sm-8">@nombreCompleto</dd>

                    <dt class="col-sm-4 TextoSuave fw-normal">Fecha de nacimiento</dt>
                    <dd id="FichaDatoFechaNacimiento" class="col-sm-8">
                        @(Model.FechaNacimiento.HasValue
                            ? Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                            : "-")
                    </dd>

                    <dt class="col-sm-4 TextoSuave fw-normal">Edad</dt>
                    <dd id="FichaDatoEdad" class="col-sm-8">
                        @(edad.HasValue ? $"{edad.Value} años" : "-")
                    </dd>

                    <dt class="col-sm-4 TextoSuave fw-normal">Nivel educativo</dt>
                    <dd id="FichaDatoNivel" class="col-sm-8">
                        @(Model.NivelEducativo ?? "-")
                    </dd>

                    <dt class="col-sm-4 TextoSuave fw-normal">Institución</dt>
                    <dd id="FichaDatoInstitucion" class="col-sm-8">
                        @(Model.Institucion ?? "-")
                    </dd>

                    <dt class="col-sm-4 TextoSuave fw-normal">Resumen</dt>
                    <dd id="FichaDatoResumen" class="col-sm-8 text-break">
                        @(string.IsNullOrWhiteSpace(Model.Observaciones)
                            ? "Sin resumen registrado."
                            : Model.Observaciones)
                    </dd>

                </dl>

                <hr class="my-3">

                <!-- Necesidades de apoyo -->
                <section id="NecesidadesApoyo"
                         data-id-estudiante="@Model.IdEstudiante"
                         data-url-lista="@Url.Action("ConsultarNecesidadesEstudiante", "Admin")"
                         data-url-editar="@Url.Action("EditarNecesidadEstudiante", "Admin")"
                         data-url-quitar="@Url.Action("QuitarNecesidadEstudiante", "Admin")">

                    @Html.AntiForgeryToken()

                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">

                        <h4 class="h6 fw-semibold mb-0">
                            Necesidades de apoyo
                        </h4>

                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#ModalAgregarNecesidad">

                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                            Agregar necesidad

                        </button>

                    </div>


                    <div id="AvisoNecesidades"
                         class="alert d-none"
                         role="status"
                         aria-live="polite"></div>

                    <div id="ListaNecesidadesApoyo">
                        Cargando necesidades…
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.NecesidadesApoyo))
                    {
                        <p class="TextoSuave small mt-3 mb-0">
                            Nota anterior:
                            <span id="FichaDatoNecesidades">@Model.NecesidadesApoyo</span>
                        </p>
                    }

                </section>

            </div>

                <section id="InfoAcademica"
                         class="Tarjeta p-3 p-md-4"
                         data-id-estudiante="@Model.IdEstudiante"
                         data-url-lista="@Url.Action("ConsultarInfoAcademicaEstudiante", "Admin")"
                         data-url-quitar="@Url.Action("QuitarInfoAcademicaEstudiante", "Admin")">

                    @Html.AntiForgeryToken()

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                        <h3 class="mb-0">Información académica</h3>

                        <button id="BotonAgregarInfoAcademica"
                                type="button"
                                class="btn btn-sm btn-outline-primary">

                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                            Agregar información

                        </button>

                    </div>

                    <hr class="my-3">

                    <div id="AvisoInfoAcademica"
                         class="alert d-none"
                         role="status"
                         aria-live="polite"></div>

                    <div id="ListaInfoAcademica"
                         class="list-group list-group-flush">
                        Cargando información…
                    </div>

                </section>

        </div>

        <!-- COLUMNA DERECHA -->
        <div class="col-lg-5 d-flex flex-column gap-3">

            <!-- Persona encargada -->
            <div class="Tarjeta p-3 p-md-4">

                <h3 class="mb-3">Persona encargada</h3>

                @if (Model.Encargados != null && Model.Encargados.Any())
                {
                    <div class="d-flex flex-column gap-3">

                        @foreach (var encargado in Model.Encargados)
                        {
                            <div>

                                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">

                                    <span class="fw-semibold">
                                        @encargado.NombreCompleto
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(encargado.Parentesco))
                                    {
                                        <span class="badge badge-etiqueta-morado">
                                            @encargado.Parentesco
                                        </span>
                                    }

                                </div>

                                <ul class="list-unstyled TextoSuave small mb-0 mt-2">

                                    @if (!string.IsNullOrWhiteSpace(encargado.Correo))
                                    {
                                        <li class="d-flex align-items-start gap-2 text-break mb-1">
                                            <i class="bi bi-envelope" aria-hidden="true"></i>
                                            <span>@encargado.Correo</span>
                                        </li>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(encargado.Identificacion))
                                    {
                                        <li class="d-flex align-items-start gap-2 text-break">
                                            <i class="bi bi-person-vcard" aria-hidden="true"></i>
                                            <span>@encargado.Identificacion</span>
                                        </li>
                                    }

                                </ul>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <p class="TextoSuave mb-0">
                        No hay persona encargada asociada.
                    </p>
                }

            </div>

            <!-- Áreas de dificultad -->
            <section id="AreasEstado"
                     class="Tarjeta p-3 p-md-4"
                     data-id-estudiante="@Model.IdEstudiante"
                     data-url-lista="@Url.Action("ConsultarAreasEstadoEstudiante", "Admin")"
                     data-url-estado="@Url.Action("CambiarEstadoAreaEstudiante", "Admin")">

                @Html.AntiForgeryToken()

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                    <h3 class="mb-0">Áreas de dificultad</h3>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-bs-toggle="modal"
                                data-bs-target="#ModalAreasInactivas">

                            Áreas inactivas

                            <span id="CantidadAreasInactivas"
                                  class="badge bg-secondary">
                                0
                            </span>

                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#ModalAgregarArea">

                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                            Agregar área

                        </button>

                    </div>

                </div>

                <div id="AvisoAreasEstado"
                     class="alert d-none"
                     role="status"
                     aria-live="polite"></div>

                <div id="ListaAreasDificultad"
                     class="list-group list-group-flush"
                     aria-busy="true">
                    Cargando áreas…
                </div>

                <button id="RecargarAreasEstado"
                        type="button"
                        class="btn btn-sm btn-link mt-2 px-0">
                    Actualizar áreas
                </button>

            </section>

        </div>

    </div>

    @if (puedeVerDocumentos)
    {
        <!-- Documentos del estudiante -->
        <section id="DocumentosEstudiante"
                 class="Tarjeta p-3 p-md-4 mt-3"
                 aria-labelledby="TituloDocumentos"
                 data-id-estudiante="@Model.IdEstudiante"
                 data-url-lista="@Url.Action("ConsultarDocumentosEstudiante", "Admin")"
                 data-url-subir="@Url.Action("SubirDocumentoEstudiante", "Admin")"
                 data-url-ver="@Url.Action("VerDocumentoEstudiante", "Admin")"
                 data-url-visibilidad="@Url.Action("CambiarVisibilidadDocumento", "Admin")"
                 data-url-eliminar="@Url.Action("EliminarDocumentoEstudiante", "Admin")">

            @Html.AntiForgeryToken()

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="TarjetaServicio-Icono mb-0"
                         style="width: 42px; height: 42px; font-size: 1.2rem; background-color: #fff4e4; color: #d69a43;">

                        <i class="bi bi-folder2-open" aria-hidden="true"></i>

                    </div>

                    <div>

                        <h3 class="mb-0" id="TituloDocumentos">
                            Documentos
                            <span class="badge rounded-pill text-bg-light border ms-1 align-middle"
                                  id="ContadorDocumentos">
                                0
                            </span>
                        </h3>

                        <p class="TextoSuave small mb-0">
                            Evaluaciones, informes y otros archivos.
                            El interruptor decide si la familia lo ve en el portal.
                        </p>

                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2">

                    <div class="input-group input-group-sm BuscadorDocumentos">

                        <span class="input-group-text bg-white">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </span>

                        <input type="search"
                               class="form-control"
                               id="BuscarDocumento"
                               placeholder="Buscar documento"
                               aria-label="Buscar documento">

                    </div>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#ModalSubirDocumento">

                        <i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i>
                        Subir documento

                    </button>

                </div>

            </div>

            <div id="AvisoDocumentos"
                 class="alert d-none"
                 role="status"
                 aria-live="polite"></div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0 TablaDocumentos"
                       id="TablaDocumentos">

                    <thead>
                        <tr>
                            <th>Documento</th>
                            <th class="d-none d-md-table-cell">Subido</th>
                            <th class="d-none d-lg-table-cell text-end">Tamaño</th>
                            <th>Portal</th>
                            <th class="TablaAcciones text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="CuerpoDocumentos">
                        <tr>
                            <td colspan="5" class="TextoSuave">
                                Cargando documentos…
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

            <div class="EstadoVacio d-none" id="VacioDocumentos">
                <i class="bi bi-folder2" aria-hidden="true"></i>
                <p class="mb-0" id="TextoVacioDocumentos">
                    Todavía no hay documentos para este estudiante.
                </p>
            </div>

        </section>
    }

</main>

<!-- ========================================= -->
<!-- MODALES -->
<!-- ========================================= -->

<!-- Modal agregar área -->
<div id="ModalAgregarArea"
     class="modal fade"
     tabindex="-1"
     aria-labelledby="TituloAgregarArea"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form id="FormularioAgregarArea"
                  data-id-estudiante="@Model.IdEstudiante"
                  data-url="@Url.Action("AgregarAreaEstudiante", "Admin")"
                  data-url-buscar="@Url.Action("BuscarAreasDificultad", "Admin")">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 id="TituloAgregarArea" class="modal-title">
                        Agregar área de dificultad
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">

                        <label for="NombreArea" class="form-label">
                            Área
                        </label>

                        <div class="position-relative">

                            <input id="NombreArea"
                                   name="NombreArea"
                                   type="text"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   autocomplete="off"
                                   placeholder="Busque o escriba un área">

                            <div id="ResultadosArea"
                                 class="list-group position-absolute w-100 shadow-sm d-none"
                                 style="z-index: 1056; max-height: 220px; overflow-y: auto;"></div>

                        </div>

                        <div id="AvisoLookupArea" class="form-text"></div>

                    </div>

                    <div class="mb-1">
                        <label for="ObservacionArea" class="form-label">
                            Observación
                        </label>

                        <textarea id="ObservacionArea"
                                  name="ObservacionArea"
                                  class="form-control"
                                  maxlength="500"
                                  rows="3"></textarea>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Agregar
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<!-- Modal agregar / editar información académica -->
<div id="ModalInfoAcademica"
     class="modal fade"
     tabindex="-1"
     aria-labelledby="TituloModalInfoAcademica"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form id="FormularioInfoAcademica"
                  data-url-agregar="@Url.Action("AgregarInfoAcademicaEstudiante", "Admin")"
                  data-url-editar="@Url.Action("EditarInfoAcademicaEstudiante", "Admin")">

                @Html.AntiForgeryToken()

                <input id="IdInfoAcademica" type="hidden">

                <div class="modal-header">

                    <h5 id="TituloModalInfoAcademica" class="modal-title">
                        Agregar información académica
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>

                </div>

                <div class="modal-body">

                    <div id="AlertaInfoAcademica"
                         class="alert d-none"
                         role="alert"></div>

                    <div class="mb-3">

                        <label for="TituloInfoAcademica" class="form-label">
                            Título
                        </label>

                        <input id="TituloInfoAcademica"
                               type="text"
                               class="form-control"
                               maxlength="100"
                               required
                               placeholder="Ej. Rendimiento en matemática">

                    </div>

                    <div class="mb-1">

                        <label for="DetalleInfoAcademica" class="form-label">
                            Detalle
                        </label>

                        <textarea id="DetalleInfoAcademica"
                                  class="form-control"
                                  maxlength="1000"
                                  rows="4"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Agregar
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>



<!-- Modal agregar necesidad de apoyo -->
