@if (puedeVerDocumentos)
{
    <!-- Modal subir documento -->
    <div id="ModalSubirDocumento"
         class="modal fade"
         tabindex="-1"
         aria-labelledby="TituloSubirDocumento"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form id="FormularioSubirDocumento" novalidate>

                    <div class="modal-header">

                        <h5 id="TituloSubirDocumento" class="modal-title">
                            Subir documento
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar"></button>

                    </div>

                    <div class="modal-body">

                        <div id="AvisoSubirDocumento"
                             class="alert alert-danger d-none"
                             role="alert"></div>

                        <label class="ZonaArchivo mb-3"
                               id="ZonaDocumento"
                               for="ArchivoDocumento">

                            <input type="file"
                                   id="ArchivoDocumento"
                                   class="visually-hidden"
                                   accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx,.ppt,.pptx">

                            <span class="ZonaArchivo-Vacia">

                                <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>

                                <span>
                                    <strong>Elija un archivo</strong> o arrástrelo aquí
                                </span>

                                <small class="TextoSuave">
                                    PDF, imagen, Word, Excel o PowerPoint · máximo 15 MB
                                </small>

                            </span>

                            <span class="ZonaArchivo-Elegido d-none">

                                <i class="bi bi-file-earmark-check" aria-hidden="true"></i>

                                <span class="ZonaArchivo-Nombre"></span>

                                <small class="TextoSuave ZonaArchivo-Tamano"></small>

                            </span>

                        </label>

                        <div class="mb-3">

                            <label for="TituloDocumento"
                                   class="form-label CampoObligatorio">
                                Título
                            </label>

                            <input type="text"
                                   id="TituloDocumento"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="Ej. Evaluación psicopedagógica inicial">

                            <div class="invalid-feedback">
                                Indique el título del documento.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label for="DescripcionDocumento" class="form-label">
                                Descripción
                                <span class="TextoSuave">(opcional)</span>
                            </label>

                            <textarea id="DescripcionDocumento"
                                      class="form-control"
                                      rows="2"
                                      maxlength="500"></textarea>

                        </div>

                        <div class="form-check form-switch InterruptorPortal">

                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="VisibleDocumento">

                            <label class="form-check-label" for="VisibleDocumento">

                                <strong>Visible para la familia</strong>

                                <span class="d-block TextoSuave small">
                                    Aparece en la pestaña Documentos del portal.
                                    Lo puede cambiar después.
                                </span>

                            </label>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                id="BotonSubirDocumento">

                            <span class="spinner-border spinner-border-sm me-1 d-none"
                                  aria-hidden="true"></span>
                            Subir

                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>

    <!-- Modal eliminar documento -->
    <div id="ModalEliminarDocumento"
         class="modal fade"
         tabindex="-1"
         aria-labelledby="TituloEliminarDocumento"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">

                    <h5 id="TituloEliminarDocumento" class="modal-title">
                        Desactivar documento
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>

                </div>

                <div class="modal-body">

                    <p class="fw-semibold mb-1" id="NombreEliminarDocumento"></p>

                    <p class="mb-0">
                        Dejará de aparecer en la ficha y en el portal de la familia.
                    </p>

                    <div id="AvisoEliminarDocumento"
                         class="alert alert-danger d-none mt-3"
                         role="alert"></div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="ConfirmarEliminarDocumento">

                        <span class="spinner-border spinner-border-sm me-1 d-none"
                              aria-hidden="true"></span>
                        Desactivar

                    </button>

                </div>

            </div>
        </div>
    </div>
}

