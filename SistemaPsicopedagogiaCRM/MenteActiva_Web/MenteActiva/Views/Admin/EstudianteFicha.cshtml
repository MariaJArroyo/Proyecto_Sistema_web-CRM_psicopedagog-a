     class="modal fade"
     tabindex="-1"
     aria-labelledby="TituloAgregarNecesidad"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form id="FormularioAgregarNecesidad"
                  data-url="@Url.Action("AgregarNecesidadEstudiante", "Admin")"
                  data-url-buscar="@Url.Action("BuscarNecesidadesApoyo", "Admin")">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 id="TituloAgregarNecesidad" class="modal-title">
                        Agregar necesidad de apoyo
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>

                </div>

                <div class="modal-body">

                    <div id="AlertaAgregarNecesidad"
                         class="alert d-none"
                         role="alert"></div>

                    <div class="mb-3">

                        <label for="NombreNecesidad" class="form-label">
                            Necesidad
                        </label>

                        <div class="position-relative">

                            <input id="NombreNecesidad"
