                    </button>

                    <button type="submit" class="btn btn-primary">
                        Agregar
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>


<!-- Modal editar necesidad de apoyo -->
<div id="ModalEditarNecesidad"
     class="modal fade"
     tabindex="-1"
     aria-labelledby="TituloEditarNecesidad"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form id="FormularioEditarNecesidad"
                  data-url="@Url.Action("EditarNecesidadEstudiante", "Admin")"
                  data-url-buscar="@Url.Action("BuscarNecesidadesApoyo", "Admin")">

                @Html.AntiForgeryToken()

                <input type="hidden" id="EditarIdNecesidad">

                <div class="modal-header">

                    <h5 id="TituloEditarNecesidad" class="modal-title">
                        Editar necesidad de apoyo
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>

                </div>

                <div class="modal-body">

                    <div id="AlertaEditarNecesidad"
                         class="alert d-none"
                         role="alert"></div>

                    <div class="mb-3">

                        <label for="EditarNombreNecesidad" class="form-label">
                            Necesidad
                        </label>

                        <div class="position-relative">

                            <input id="EditarNombreNecesidad"
                                   type="text"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   autocomplete="off">

                            <div id="ResultadosEditarNecesidad"
                                 class="list-group position-absolute w-100 shadow-sm d-none"
                                 style="z-index:1056;max-height:220px;overflow-y:auto;"></div>

                        </div>

                        <div id="AvisoLookupEditarNecesidad"
                             class="form-text"></div>

                    </div>

                    <div class="mb-1">

                        <label for="EditarObservacionNecesidad"
                               class="form-label">
                            Observación
                        </label>

                        <textarea id="EditarObservacionNecesidad"
                                  class="form-control"
                                  maxlength="500"
                                  rows="3"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
