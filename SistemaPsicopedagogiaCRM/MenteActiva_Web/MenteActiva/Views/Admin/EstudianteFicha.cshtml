    @if (puedeCambiarFoto)
    {
        <script src="~/js/fotoEstudiante.js" asp-append-version="true"></script>
    }

    <script src="~/js/lookupCatalogo.js" asp-append-version="true"></script>
    <script src="~/js/estudianteFicha.js" asp-append-version="true"></script>
    <script src="~/js/necesidadesApoyo.js" asp-append-version="true"></script>
    <script src="~/js/infoAcademica.js" asp-append-version="true"></script>
    <script src="~/js/areasEstado.js" asp-append-version="true"></script>

    @if (puedeVerDocumentos)
    {
        <script src="~/js/documentosEstudiante.js" asp-append-version="true"></script>
    }

}