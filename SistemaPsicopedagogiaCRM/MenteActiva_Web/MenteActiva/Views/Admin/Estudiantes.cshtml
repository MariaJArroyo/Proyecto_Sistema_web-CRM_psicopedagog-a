          <div class="EstadoVacio d-none" data-tabla-vacio="TablaEstudiantes">
            <i class="bi bi-mortarboard"></i>
            <p class="mb-3">No se encontraron estudiantes con ese criterio de búsqueda.</p>
          </div>
        </div>
      </main>

      <div class="modal fade" id="ModalNuevoEstudiante" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <!-- Razor: asp-controller="Estudiantes" asp-action="Crear" method="post" -->
            <form id="FormularioNuevoEstudiante" novalidate>
              <div class="modal-header">
                <h5 class="modal-title">Nuevo estudiante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="NombreEstudiante" class="form-label CampoObligatorio">Nombre completo</label>
                    <input type="text" class="form-control" id="NombreEstudiante" name="NombreEstudiante">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-3">
                    <label for="EdadEstudiante" class="form-label CampoObligatorio">Edad</label>
                    <input type="number" class="form-control" id="EdadEstudiante" name="Edad" min="3" max="25">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-3">
                    <label for="NivelEducativo" class="form-label CampoObligatorio">Nivel educativo</label>
                    <select class="form-select" id="NivelEducativo" name="NivelEducativo">
                      <option value="" selected>Seleccione</option>
                      <option value="Preescolar">Preescolar</option>
                      <option value="Primaria">Primaria</option>
                      <option value="Secundaria">Secundaria</option>
                    </select>
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-6">
                    <label for="Institucion" class="form-label CampoObligatorio">Institución</label>
                    <input type="text" class="form-control" id="Institucion" name="Institucion">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-6">
                    <!-- Razor: <select> vendrá de un SelectList de Model.Clientes -->
                    <label for="PersonaEncargada" class="form-label CampoObligatorio">Persona encargada</label>
                    <select class="form-select" id="PersonaEncargada" name="PersonaEncargada">
                      <option value="" selected>Seleccione un cliente registrado</option>
                      <option value="CarlosJimenez">Carlos Jiménez</option>
                      <option value="RodolfoVargas">Rodolfo Vargas</option>
                      <option value="MarjorieCastro">Marjorie Castro</option>
                      <option value="JoseFernandez">José Fernández</option>
                      <option value="LauraMendez">Laura Méndez</option>
                      <option value="MartaMora">Marta Mora</option>
                      <option value="PatriciaAraya">Patricia Araya</option>
                      <option value="OscarSolis">Óscar Solís</option>
                    </select>
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-12">
                    <label for="ObservacionesEstudiante" class="form-label">Observaciones</label>
                    <textarea class="form-control" id="ObservacionesEstudiante" name="Observaciones"
                      rows="3"></textarea>
                  </div>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar estudiante</button>
              </div>
            </form>
          </div>
        </div>
      </div>

@section Scripts {
  <script src="~/js/Validaciones.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var formulario = document.getElementById("FormularioNuevoEstudiante");
      formulario.addEventListener("submit", function (evento) {
        evento.preventDefault();
        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("NombreEstudiante"), "Ingrese el nombre del estudiante.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("EdadEstudiante"), "Ingrese la edad del estudiante.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("NivelEducativo"), "Seleccione el nivel educativo.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("Institucion"), "Ingrese la institución.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("PersonaEncargada"), "Seleccione la persona encargada.") && esValido;
        if (!esValido) {
          return;
        }
        formulario.reset();
        formulario.querySelectorAll(".is-valid").forEach(function (campo) { campo.classList.remove("is-valid"); });
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalNuevoEstudiante")).hide();
        MostrarToast("Estudiante registrado correctamente.");
      });
    });
  </script>
}
