@{
    ViewData["Title"] = "Estudiantes";
}

      <main class="PrincipalAdmin">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
          <div>
            <h2 class="mb-1">Estudiantes</h2>
            <p class="TextoSuave mb-0">Estudiantes registrados y su información general.</p>
          </div>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ModalNuevoEstudiante">
            <i class="bi bi-plus-lg me-1"></i>Nuevo estudiante
          </button>
        </div>

        <div class="Tarjeta p-3 p-md-4">

          <div class="row g-2 mb-3" data-tabla-buscador="TablaEstudiantes">
            <div class="col-md-7">
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" data-buscar-texto
                  placeholder="Buscar por nombre, institución o encargado">
              </div>
            </div>
            <div class="col-md-5">
              <select class="form-select" data-buscar-estado aria-label="Filtrar por nivel educativo">
                <option value="">Todos los niveles</option>
                <option value="Preescolar">Preescolar</option>
                <option value="Primaria">Primaria</option>
                <option value="Secundaria">Secundaria</option>
              </select>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaEstudiantes">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Edad</th>
                  <th>Nivel educativo</th>
                  <th>Institución</th>
                  <th>Encargado</th>
                  <th class="TablaAcciones">Acciones</th>
                </tr>
              </thead>
