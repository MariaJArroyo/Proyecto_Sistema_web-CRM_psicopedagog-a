@model List<MenteActiva.Models.EstudianteViewModel>

@{
    ViewData["Title"] = "Estudiantes";

    var estudiantes = Model
        ?? new List<MenteActiva.Models.EstudianteViewModel>();

    var niveles = ViewBag.NivelesEducativos
        as List<MenteActiva.Models.NivelEducativoViewModel>
        ?? new List<MenteActiva.Models.NivelEducativoViewModel>();

    var parentescos = ViewBag.Parentescos
        as List<MenteActiva.Models.ParentescoViewModel>
        ?? new List<MenteActiva.Models.ParentescoViewModel>();
}

<main class="PrincipalAdmin">

    <div id="ContenedorMensaje"></div>

    <!-- Encabezado -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">

        <div>
            <h2 class="mb-1">Estudiantes</h2>

            <p class="TextoSuave mb-0">
                Estudiantes registrados y su información general.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#ModalNuevoEstudiante">

            <i class="bi bi-plus-lg me-1"></i>
            Nuevo estudiante

        </button>

    </div>

    <!-- Filtros, tabla y paginación -->
    <div class="Tarjeta p-3 p-md-4">

        <div class="row g-3 align-items-end mb-3"
             data-tabla-buscador="TablaEstudiantes"
             data-tabla-paginar="10">

            <div class="col-md-8">

                <label for="BuscarEstudiante" class="form-label">
                    Buscar estudiante
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           id="BuscarEstudiante"
                           class="form-control"
                           data-buscar-texto
                           placeholder="Buscar por nombre, institución o encargado">

                </div>

            </div>

            <div class="col-md-4">

                <label for="FiltroNivel" class="form-label">
                    Nivel educativo
                </label>

                <select id="FiltroNivel"
                        class="form-select"
                        data-buscar-estado>

                    <option value="">Todos los niveles</option>

                    @foreach (var nivel in estudiantes
                        .Select(e => e.NivelEducativo)
                        .Where(n => !string.IsNullOrWhiteSpace(n))
                        .Distinct()
                        .OrderBy(n => n))
                    {
                        <option value="@nivel">@nivel</option>
                    }

                </select>

            </div>

        </div>

        <!-- Tabla -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   id="TablaEstudiantes">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Edad</th>
                        <th>Nivel educativo</th>
                        <th>Institución</th>
                        <th>Encargado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var estudiante in estudiantes)
                    {
                        var edad = 0;

                        if (estudiante.FechaNacimiento.HasValue)
                        {
                            var nacimiento = estudiante.FechaNacimiento.Value.Date;
                            var hoy = DateTime.Today;

                            edad = hoy.Year - nacimiento.Year;

                            if (nacimiento.AddYears(edad) > hoy)
                            {
                                edad--;
                            }
                        }

                        <tr data-fila
                            data-estado="@estudiante.NivelEducativo">

                            <td>
                                <div class="fw-semibold">
                                    @estudiante.Estudiante
                                </div>
                            </td>

                            <td>
                                @(estudiante.FechaNacimiento.HasValue
                                    ? $"{edad} años"
                                    : "-")
                            </td>

                            <td>
                                @(estudiante.NivelEducativo ?? "-")
                            </td>

                            <td>
                                @(estudiante.Institucion ?? "-")
                            </td>

                            <td>
                                @(estudiante.Encargado ?? "-")
                            </td>

                            <td class="TablaAcciones text-center">

                                <a href="@Url.Action("EstudianteFicha", "Admin", new { id = estudiante.IdEstudiante })"
                                   class="btn btn-sm btn-outline-secondary border-0"
                                   data-bs-toggle="tooltip"
                                   title="Ver ficha"
                                   aria-label="Ver ficha de @estudiante.Estudiante">

                                    <i class="bi bi-file-earmark-person"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- Main.js inserta aquí la paginación automáticamente -->
        <!-- Sin coincidencias al buscar o filtrar -->
        <div id="EstadoVacio"
             data-tabla-vacio="TablaEstudiantes"
             class="text-center py-5 d-none">

            <i class="bi bi-people fs-1 text-muted"></i>

            <h5 class="mt-3">
                No se encontraron estudiantes
            </h5>

            <p class="text-muted mb-0">
                Intenta cambiar los filtros o el texto de búsqueda.
            </p>

        </div>

        <!-- Sin estudiantes registrados -->
        @if (!estudiantes.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-people fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No hay estudiantes registrados
                </h5>

                <p class="text-muted mb-0">
                    Usá el botón Nuevo estudiante para registrar uno.
                </p>

            </div>
        }

    </div>

</main>

<!-- Modal nuevo estudiante -->
<div class="modal fade"
     id="ModalNuevoEstudiante"
     tabindex="-1"
     aria-labelledby="ModalNuevoEstudianteLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form id="FormularioNuevoEstudiante"
                  novalidate
                  data-url="@Url.Action("CrearEstudiante", "Admin")"
                  data-url-encargados="@Url.Action("BuscarEncargadosEstudiante", "Admin")">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <div>

                        <h5 class="modal-title"
                            id="ModalNuevoEstudianteLabel">
                            Nuevo estudiante
                        </h5>

                        <small class="text-muted">
                            Registre al estudiante y asócielo a una persona encargada.
                        </small>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label for="NombreEstudiante"
                                   class="form-label">
                                Nombre
                            </label>

                            <input type="text"
                                   id="NombreEstudiante"
                                   class="form-control"
                                   maxlength="100"
                                   required>

                        </div>

                        <div class="col-md-4">

                            <label for="PrimerApellidoEstudiante"
                                   class="form-label">
                                Primer apellido
                            </label>

                            <input type="text"
                                   id="PrimerApellidoEstudiante"
                                   class="form-control"
                                   maxlength="100"
                                   required>

                        </div>

                        <div class="col-md-4">

                            <label for="SegundoApellidoEstudiante"
                                   class="form-label">
                                Segundo apellido
                            </label>

                            <input type="text"
                                   id="SegundoApellidoEstudiante"
                                   class="form-control"
                                   maxlength="100">

                        </div>

                        <div class="col-md-4">

                            <label for="FechaNacimientoEstudiante"
                                   class="form-label">
                                Fecha de nacimiento
                            </label>

                            <input type="text"
                                   id="FechaNacimientoEstudiante"
                                   class="form-control"
                                   inputmode="numeric"
                                   maxlength="10"
                                   autocomplete="off"
                                   placeholder="dd/mm/aaaa">

                        </div>

                        <div class="col-md-4">

                            <label for="NivelEducativo"
                                   class="form-label">
                                Nivel educativo
                            </label>

                            <select id="NivelEducativo"
                                    class="form-select">

                                <option value="">Sin especificar</option>

                                @foreach (var nivel in niveles)
                                {
                                    <option value="@nivel.IdNivelEducativo">
                                        @nivel.Nombre
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-4">

                            <label for="Institucion"
                                   class="form-label">
                                Institución
                            </label>

                            <input type="text"
                                   id="Institucion"
                                   class="form-control"
                                   maxlength="100">

                        </div>

                        <!-- Búsqueda de persona encargada -->
                        <div class="col-md-8">

                            <label for="BuscarEncargadoLookup"
                                   class="form-label">
                                Persona encargada
                            </label>

                            <div class="position-relative">

                                <input type="text"
                                       id="BuscarEncargadoLookup"
                                       class="form-control"
                                       placeholder="Escriba nombre, cédula o correo para buscar..."
                                       autocomplete="off">

                                <input type="hidden"
                                       id="IdEncargadoSeleccionado">

                                <div id="ResultadosEncargado"
                                     class="list-group position-absolute w-100 shadow-sm d-none"
                                     style="z-index: 1056; max-height: 220px; overflow-y: auto;">
                                </div>

                            </div>

                            <div id="EncargadoSeleccionado"
                                 class="form-text">
                            </div>

                        </div>

                        <div class="col-md-4">

                            <label for="ParentescoEstudiante"
                                   class="form-label">
                                Parentesco
                            </label>

                            <select id="ParentescoEstudiante"
                                    class="form-select">

                                <option value="">Seleccione...</option>

                                @foreach (var parentesco in parentescos)
                                {
                                    <option value="@parentesco.IdParentesco">
                                        @parentesco.Nombre
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-12">

                            <label for="ObservacionesEstudiante"
                                   class="form-label">
                                Observaciones
                            </label>

                            <textarea id="ObservacionesEstudiante"
                                      class="form-control"
                                      maxlength="1000"
                                      rows="3"></textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar estudiante
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/estudiantes.js" asp-append-version="true"></script>
}