                    <a href="/Admin/EstudianteFicha" class="btn btn-sm btn-outline-secondary border-0"
                      data-bs-toggle="tooltip" title="Ver ficha"><i class="bi bi-file-earmark-person"></i></a>
                  </td>
                </tr>
                <tr data-fila data-estado="Secundaria">
                  <td>Diego Vargas</td>
                  <td>14 años</td>
                  <td>Secundaria</td>
                  <td>Liceo de Costa Rica</td>
                  <td>Rodolfo Vargas</td>
                  <td class="TablaAcciones">
                    <a href="/Admin/EstudianteFicha" class="btn btn-sm btn-outline-secondary border-0"
                      data-bs-toggle="tooltip" title="Ver ficha"><i class="bi bi-file-earmark-person"></i></a>
                  </td>
                </tr>
                <tr data-fila data-estado="Primaria">
                  <td>Ana Castro</td>
                  <td>8 años</td>
                  <td>Primaria</td>
                  <td>Escuela República de Costa Rica</td>
                  <td>Marjorie Castro</td>
                  <td class="TablaAcciones">
                    <a href="/Admin/EstudianteFicha" class="btn btn-sm btn-outline-secondary border-0"
                      data-bs-toggle="tooltip" title="Ver ficha"><i class="bi bi-file-earmark-person"></i></a>
                  </td>
                </tr>
                <tr data-fila data-estado="Secundaria">
                  <td>Kevin Fernández</td>
                  <td>16 años</td>
                  <td>Secundaria</td>
                  <td>Colegio Técnico Don Bosco</td>
                  <td>José Fernández</td>
