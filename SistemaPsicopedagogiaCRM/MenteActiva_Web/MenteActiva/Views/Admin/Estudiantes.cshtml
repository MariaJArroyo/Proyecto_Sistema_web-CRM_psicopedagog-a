@model List<MenteActiva.Models.EstudianteViewModel>

@{
    ViewData["Title"] = "Estudiantes";

    var niveles = ViewBag.NivelesEducativos as List<MenteActiva.Models.NivelEducativoViewModel>
                  ?? new List<MenteActiva.Models.NivelEducativoViewModel>();

    var parentescos = ViewBag.Parentescos as List<MenteActiva.Models.ParentescoViewModel>
                      ?? new List<MenteActiva.Models.ParentescoViewModel>();
}

<div class="container-fluid">

    <div id="ContenedorMensaje"></div>

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Estudiantes</h1>
            <p class="text-muted mb-0">
                Estudiantes registrados y su información general.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#ModalNuevoEstudiante">
            <i class="bi bi-plus-lg me-1"></i>
            Nuevo estudiante
        </button>
    </div>

    <!-- Buscador y filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-8">
                    <label for="BuscarEstudiante" class="form-label">
                        Buscar estudiante
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="BuscarEstudiante"
                               class="form-control"
                               placeholder="Buscar por nombre, institución o encargado">
                    </div>
                </div>

                <div class="col-md-4">
                    <label for="FiltroNivel" class="form-label">
                        Nivel educativo
                    </label>

                    <select id="FiltroNivel"
                            class="form-select"
                            data-buscar-estado>
                        <option value="">Todos los niveles</option>
                        <option value="Preescolar">Preescolar</option>
                        <option value="Primaria">Primaria</option>
                        <option value="Secundaria">Secundaria</option>
                    </select>
                </div>

            </div>

        </div>
    </div>

    <!-- Tabla de estudiantes -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="TablaEstudiantes">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Edad</th>
                            <th>Nivel educativo</th>
                            <th>Institución</th>
                            <th>Encargado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var estudiante in Model)
                            {
                                var edad = estudiante.FechaNacimiento.HasValue
                                    ? DateTime.Today.Year
                                      - estudiante.FechaNacimiento.Value.Year
                                      - (
                                          DateTime.Today.DayOfYear
                                          < estudiante.FechaNacimiento.Value.DayOfYear
                                            ? 1
                                            : 0
                                        )
                                    : 0;

                                <tr data-fila
                                    data-estado="@estudiante.NivelEducativo">

                                    <td>
                                        <div class="fw-semibold">
                                            @estudiante.Estudiante
                                        </div>
                                    </td>

                                    <td>
                                        @(edad > 0 ? $"{edad} años" : "-")
                                    </td>

                                    <td>
                                        @estudiante.NivelEducativo
                                    </td>

                                    <td>
                                        @estudiante.Institucion
                                    </td>

                                    <td>
                                        @estudiante.Encargado
                                    </td>

                                    <td class="TablaAcciones text-center">

                                        <a href="@Url.Action("EstudianteFicha", "Admin", new { id = estudiante.IdEstudiante })"
                                           class="btn btn-sm btn-outline-secondary border-0"
                                           data-bs-toggle="tooltip"
                                           title="Ver ficha">

                                            <i class="bi bi-file-earmark-person"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Estado vacío -->
            <div id="EstadoVacio"
                 class="text-center py-5 d-none">

                <i class="bi bi-people fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No se encontraron estudiantes
                </h5>

                <p class="text-muted mb-0">
                    Intenta cambiar los filtros o el texto de búsqueda.
                </p>

            </div>

        </div>

    </div>

</div>


<!-- Modal nuevo estudiante -->
<div class="modal fade"
     id="ModalNuevoEstudiante"
     tabindex="-1"
     aria-labelledby="ModalNuevoEstudianteLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form id="FormularioNuevoEstudiante"
                  novalidate
                  data-url="@Url.Action("CrearEstudiante", "Admin")"
                  data-url-encargados="@Url.Action("BuscarEncargadosEstudiante", "Admin")">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <div>
                        <h5 class="modal-title" id="ModalNuevoEstudianteLabel">
                            Nuevo estudiante
                        </h5>

                        <small class="text-muted">
                            Registre al estudiante y asócielo a una persona encargada.
                        </small>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label for="NombreEstudiante" class="form-label">
                                Nombre
                            </label>

                            <input type="text"
                                   id="NombreEstudiante"
                                   class="form-control"
                                   maxlength="100"
                                   required>
                        </div>

                        <div class="col-md-4">
                            <label for="PrimerApellidoEstudiante" class="form-label">
                                Primer apellido
                            </label>

                            <input type="text"
                                   id="PrimerApellidoEstudiante"
                                   class="form-control"
                                   maxlength="100"
                                   required>
                        </div>

                        <div class="col-md-4">
                            <label for="SegundoApellidoEstudiante" class="form-label">
                                Segundo apellido
                            </label>

                            <input type="text"
                                   id="SegundoApellidoEstudiante"
                                   class="form-control"
                                   maxlength="100">
                        </div>

                        <div class="col-md-4">
                            <label for="FechaNacimientoEstudiante" class="form-label">
                                Fecha de nacimiento
                            </label>

                            <input type="text"
                                   id="FechaNacimientoEstudiante"
                                   class="form-control"
                                   inputmode="numeric"
                                   maxlength="10"
                                   autocomplete="off"
                                   placeholder="dd/mm/aaaa">
                        </div>

                        <div class="col-md-4">
                            <label for="NivelEducativo" class="form-label">
                                Nivel educativo
                            </label>

                            <select id="NivelEducativo"
                                    class="form-select">

                                <option value="">Sin especificar</option>

                                @foreach (var nivel in niveles)
                                {
                                    <option value="@nivel.IdNivelEducativo">
                                        @nivel.Nombre
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-4">
                            <label for="Institucion" class="form-label">
                                Institución
                            </label>

                            <input type="text"
                                   id="Institucion"
                                   class="form-control"
                                   maxlength="100">
                        </div>

                        <!-- Lookup de persona encargada -->
                        <div class="col-md-8">
                            <label for="BuscarEncargadoLookup" class="form-label">
                                Persona encargada
                            </label>

                            <div class="position-relative">

                                <input type="text"
                                       id="BuscarEncargadoLookup"
                                       class="form-control"
                                       placeholder="Escriba nombre, cédula o correo para buscar..."
                                       autocomplete="off">

                                <input type="hidden"
                                       id="IdEncargadoSeleccionado">

                                <div id="ResultadosEncargado"
                                     class="list-group position-absolute w-100 shadow-sm d-none"
                                     style="z-index: 1056; max-height: 220px; overflow-y: auto;">
                                </div>

                            </div>

                            <div id="EncargadoSeleccionado"
                                 class="form-text">
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label for="ParentescoEstudiante" class="form-label">
                                Parentesco
                            </label>

                            <select id="ParentescoEstudiante"
                                    class="form-select">

                                <option value="">Seleccione...</option>

                                @foreach (var parentesco in parentescos)
                                {
                                    <option value="@parentesco.IdParentesco">
                                        @parentesco.Nombre
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-12">
                            <label for="ObservacionesEstudiante"
                                   class="form-label">
                                Observaciones
                            </label>

                            <textarea id="ObservacionesEstudiante"
                                      class="form-control"
                                      maxlength="1000"
                                      rows="3"></textarea>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar estudiante
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <script src="~/js/estudiantes.js"></script>
}
