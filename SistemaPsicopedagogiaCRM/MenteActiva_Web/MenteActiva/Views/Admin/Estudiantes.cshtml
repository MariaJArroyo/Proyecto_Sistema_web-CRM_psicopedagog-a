@model List<MenteActiva.Models.EstudianteViewModel>

@{
    ViewData["Title"] = "Estudiantes";
}

<div class="container-fluid">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Estudiantes</h1>
            <p class="text-muted mb-0">
                Estudiantes registrados y su información general.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#ModalNuevoEstudiante">
            <i class="bi bi-plus-lg me-1"></i>
            Nuevo estudiante
        </button>
    </div>

    <!-- Buscador y filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-8">
                    <label for="BuscarEstudiante" class="form-label">
                        Buscar estudiante
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="BuscarEstudiante"
                               class="form-control"
                               placeholder="Buscar por nombre, institución o encargado">
                    </div>
                </div>

                <div class="col-md-4">
                    <label for="FiltroNivel" class="form-label">
                        Nivel educativo
                    </label>

                    <select id="FiltroNivel"
                            class="form-select"
                            data-buscar-estado>
                        <option value="">Todos los niveles</option>
                        <option value="Preescolar">Preescolar</option>
                        <option value="Primaria">Primaria</option>
                        <option value="Secundaria">Secundaria</option>
                    </select>
                </div>

            </div>

        </div>
    </div>

    <!-- Tabla de estudiantes -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="TablaEstudiantes">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Edad</th>
                            <th>Nivel educativo</th>
                            <th>Institución</th>
                            <th>Encargado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var estudiante in Model)
                            {
                                var edad = estudiante.FechaNacimiento.HasValue
                                    ? DateTime.Today.Year
                                      - estudiante.FechaNacimiento.Value.Year
                                      - (
                                          DateTime.Today.DayOfYear
                                          < estudiante.FechaNacimiento.Value.DayOfYear
                                            ? 1
                                            : 0
                                        )
                                    : 0;

                                <tr data-fila
                                    data-estado="@estudiante.NivelEducativo">

                                    <td>
                                        <div class="fw-semibold">
                                            @estudiante.Estudiante
                                        </div>
                                    </td>

                                    <td>
                                        @(edad > 0 ? $"{edad} años" : "-")
                                    </td>

                                    <td>
                                        @estudiante.NivelEducativo
                                    </td>

                                    <td>
                                        @estudiante.Institucion
                                    </td>

                                    <td>
                                        @estudiante.Encargado
                                    </td>

                                    <td class="TablaAcciones text-center">

                                        <a href="@Url.Action(
                                                                                       "EstudianteFicha",
                                                                                       "Admin",
                                                                                       new { id = estudiante.IdEstudiante })"
                                           class="btn btn-sm btn-outline-secondary border-0"
                                           data-bs-toggle="tooltip"
                                           title="Ver ficha">

                                            <i class="bi bi-file-earmark-person"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Estado vacío -->
            <div id="EstadoVacio"
                 class="text-center py-5 d-none">

                <i class="bi bi-people fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No se encontraron estudiantes
                </h5>

                <p class="text-muted mb-0">
                    Intenta cambiar los filtros o el texto de búsqueda.
                </p>

            </div>

        </div>

    </div>

</div>


<!-- Modal nuevo estudiante -->
<div class="modal fade"
     id="ModalNuevoEstudiante"
     tabindex="-1"
     aria-labelledby="ModalNuevoEstudianteLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title" id="ModalNuevoEstudianteLabel">
                        Nuevo estudiante
                    </h5>

                    <small class="text-muted">
                        Registre la información general del estudiante.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <form id="FormularioNuevoEstudiante">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label for="NombreEstudiante" class="form-label">
                                Nombre
                            </label>

                            <input type="text"
                                   id="NombreEstudiante"
                                   class="form-control">
                        </div>

                        <div class="col-md-6">
                            <label for="EdadEstudiante" class="form-label">
                                Edad
                            </label>

                            <input type="number"
                                   id="EdadEstudiante"
                                   class="form-control"
                                   min="0">
                        </div>

                        <div class="col-md-6">
                            <label for="NivelEducativo" class="form-label">
                                Nivel educativo
                            </label>

                            <select id="NivelEducativo"
                                    class="form-select">

                                <option value="">
                                    Seleccione...
                                </option>

                                <option value="Preescolar">
                                    Preescolar
                                </option>

                                <option value="Primaria">
                                    Primaria
                                </option>

                                <option value="Secundaria">
                                    Secundaria
                                </option>

                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="Institucion" class="form-label">
                                Institución
                            </label>

                            <input type="text"
                                   id="Institucion"
                                   class="form-control">
                        </div>

                        <div class="col-md-12">
                            <label for="PersonaEncargada" class="form-label">
                                Persona encargada
                            </label>

                            <input type="text"
                                   id="PersonaEncargada"
                                   class="form-control">
                        </div>

                        <div class="col-md-12">
                            <label for="ObservacionesEstudiante"
                                   class="form-label">
                                Observaciones
                            </label>

                            <textarea id="ObservacionesEstudiante"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-primary">
                    Guardar estudiante
                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <script src="~/js/estudiantes.js"></script>
}