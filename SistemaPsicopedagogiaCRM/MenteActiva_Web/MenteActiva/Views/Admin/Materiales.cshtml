@{
    ViewData["Title"] = "Materiales educativos";

    // JsonSerializer suelto escribe PascalCase y el JavaScript de la pantalla lee
    // camelCase, igual que lo que devuelve el API
    var jsonCamel = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };

    var niveles = (List<NivelEducativoViewModel>)ViewBag.Niveles;
    var estudiantes = (List<EstudianteViewModel>)ViewBag.Estudiantes;
}

<main class="PrincipalAdmin">
  @Html.AntiForgeryToken()

  <div class="mb-4">
    <h2 class="mb-1">Materiales educativos</h2>
    <p class="TextoSuave mb-0">Documentos, guías, tareas, actividades y enlaces para los estudiantes.</p>
  </div>

  <partial name="_AvisoCarga" />

  <div class="alert alert-danger d-none" id="AlertaMateriales" role="alert"></div>

  <ul class="nav nav-pills mb-3 flex-wrap" id="SelectorMateriales">
    <li class="nav-item"><button type="button" class="nav-link active" data-vista="Pdf">Materiales PDF</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-vista="Guias">Guías educativas</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-vista="Tareas">Tareas</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-vista="Actividades">Actividades</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-vista="Enlaces">Enlaces útiles</button></li>
  </ul>

  @* ---------- PDF ---------- *@
  <div class="Tarjeta p-3 p-md-4" id="VistaPdf">
    <h3 class="mb-3">Subir material en PDF</h3>
    <form id="FormularioSubirPdf" class="row g-3 mb-4" novalidate>
      <div class="col-md-6">
        <label for="ArchivoPdf" class="form-label CampoObligatorio">Archivo (solo PDF)</label>
        <input type="file" class="form-control" id="ArchivoPdf" accept=".pdf,application/pdf">
        <div class="invalid-feedback"></div>
        <div class="form-text">Tamaño máximo: @ViewBag.TamanoMaximoMb MB.</div>
      </div>
      <div class="col-md-6">
        <label for="TituloPdf" class="form-label">Título</label>
        <input type="text" class="form-control" id="TituloPdf" maxlength="150">
        <div class="invalid-feedback"></div>
        <div class="form-text">Si lo deja vacío se usa el nombre del archivo.</div>
      </div>
      <div class="col-md-6">
        <label for="NivelPdf" class="form-label">Nivel educativo</label>
        <select class="form-select" id="NivelPdf" data-selector-nivel></select>
      </div>
      <div class="col-md-6 d-flex align-items-end">
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="PublicarPdf">
          <label class="form-check-label" for="PublicarPdf">Publicar en el portal al subirlo</label>
        </div>
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-primary" id="BotonSubirPdf"><i class="bi bi-upload me-1"></i>Subir</button>
      </div>
    </form>

    <h6 class="mb-2">Materiales subidos</h6>
    <div class="list-group list-group-flush" id="ListaMaterialesPdf">
      <div class="list-group-item px-0 TextoSuave">Cargando…</div>
    </div>
  </div>

  @* ---------- Guias ---------- *@
  <div class="Tarjeta p-3 p-md-4 d-none" id="VistaGuias">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h3 class="mb-0">Guías educativas</h3>
      <button type="button" class="btn btn-primary" id="BotonNuevaGuia">
        <i class="bi bi-plus-lg me-1"></i>Nueva guía
      </button>
    </div>
    <div class="list-group list-group-flush" id="ListaGuias">
      <div class="list-group-item px-0 TextoSuave">Cargando…</div>
    </div>
  </div>

  @* ---------- Tareas ---------- *@
  <div class="Tarjeta p-3 p-md-4 d-none" id="VistaTareas">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h3 class="mb-0">Tareas asignadas</h3>
      <button type="button" class="btn btn-primary" id="BotonNuevaTarea">
        <i class="bi bi-plus-lg me-1"></i>Nueva tarea
      </button>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" id="TablaTareas">
        <thead>
          <tr>
            <th>Tarea</th>
            <th>Fecha límite</th>
            <th>Entregas</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody id="CuerpoTablaTareas">
          <tr><td colspan="4" class="TextoSuave text-center py-4">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  @* ---------- Actividades ---------- *@
  <div class="Tarjeta p-3 p-md-4 d-none" id="VistaActividades">
    <h3 class="mb-3">Registrar actividad educativa</h3>
    <form id="FormularioActividad" class="row g-3 mb-4" novalidate>
      <div class="col-md-6">
        <label for="NombreActividadEducativa" class="form-label CampoObligatorio">Nombre de la actividad</label>
        <input type="text" class="form-control" id="NombreActividadEducativa" maxlength="150">
        <div class="invalid-feedback"></div>
      </div>
      <div class="col-md-3">
        <label for="TipoActividadEducativa" class="form-label CampoObligatorio">Tipo</label>
        <select class="form-select" id="TipoActividadEducativa">
          <option value="" selected>Seleccione</option>
          <option value="Ludica">Lúdica</option>
          <option value="Cognitiva">Cognitiva</option>
          <option value="Motriz">Motriz</option>
        </select>
        <div class="invalid-feedback"></div>
      </div>
      <div class="col-md-3">
        <label for="FechaActividadEducativa" class="form-label CampoObligatorio">Fecha</label>
        <input type="date" class="form-control" id="FechaActividadEducativa">
        <div class="invalid-feedback"></div>
      </div>
      <div class="col-md-6">
        <label for="DescripcionActividad" class="form-label">Descripción</label>
        <input type="text" class="form-control" id="DescripcionActividad" maxlength="500">
        <div class="invalid-feedback"></div>
      </div>
      <div class="col-md-3">
        <label for="NivelActividad" class="form-label">Nivel educativo</label>
        <select class="form-select" id="NivelActividad" data-selector-nivel></select>
      </div>
      <div class="col-md-3 d-flex align-items-end">
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="PublicarActividad">
          <label class="form-check-label" for="PublicarActividad">Publicar al registrar</label>
        </div>
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-primary" id="BotonRegistrarActividad">
          <i class="bi bi-plus-lg me-1"></i>Registrar actividad
        </button>
      </div>
    </form>

    <h6 class="mb-2">Actividades registradas</h6>
    <div class="list-group list-group-flush" id="ListaActividadesEducativas">
      <div class="list-group-item px-0 TextoSuave">Cargando…</div>
    </div>
  </div>

  @* ---------- Enlaces ---------- *@
  <div class="Tarjeta p-3 p-md-4 d-none" id="VistaEnlaces">
    <h3 class="mb-3">Enlaces útiles</h3>
    <div class="list-group list-group-flush mb-4" id="ListaEnlaces">
      <div class="list-group-item px-0 TextoSuave">Cargando…</div>
    </div>

    <h6 class="mb-2">Agregar enlace</h6>
    <form id="FormularioNuevoEnlace" class="row g-3" novalidate>
      <div class="col-md-4">
        <label for="NombreEnlace" class="form-label CampoObligatorio">Nombre del enlace</label>
        <input type="text" class="form-control" id="NombreEnlace" maxlength="150">
        <div class="invalid-feedback"></div>
      </div>
      <div class="col-md-5">
        <label for="UrlEnlace" class="form-label CampoObligatorio">Dirección</label>
        <input type="url" class="form-control" id="UrlEnlace" maxlength="500" placeholder="https://ejemplo.com">
        <div class="invalid-feedback"></div>
      </div>
      <div class="col-md-3">
        <label for="NivelEnlace" class="form-label">Nivel educativo</label>
        <select class="form-select" id="NivelEnlace" data-selector-nivel></select>
      </div>
      <div class="col-md-9">
        <label for="DescripcionEnlace" class="form-label">Descripción</label>
        <input type="text" class="form-control" id="DescripcionEnlace" maxlength="500">
        <div class="invalid-feedback"></div>
      </div>
      <div class="col-md-3 d-flex align-items-end">
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="PublicarEnlace">
          <label class="form-check-label" for="PublicarEnlace">Publicar al agregar</label>
        </div>
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-primary" id="BotonAgregarEnlace">
          <i class="bi bi-plus-lg me-1"></i>Agregar enlace
        </button>
      </div>
    </form>
  </div>
</main>

@* ---------- Nueva guia ---------- *@
<div class="modal fade" id="ModalNuevaGuia" tabindex="-1" aria-labelledby="TituloModalNuevaGuia" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="FormularioNuevaGuia" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="TituloModalNuevaGuia">Nueva guía educativa</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" id="AlertaNuevaGuia" role="alert"></div>
          <div class="mb-3">
            <label for="TituloGuia" class="form-label CampoObligatorio">Título</label>
            <input type="text" class="form-control" id="TituloGuia" maxlength="150">
            <div class="invalid-feedback"></div>
          </div>
          <div class="mb-3">
            <label for="DescripcionGuia" class="form-label">Descripción</label>
            <textarea class="form-control" id="DescripcionGuia" rows="3" maxlength="500"></textarea>
            <div class="invalid-feedback"></div>
          </div>
          <div class="mb-3">
            <label for="NivelGuia" class="form-label CampoObligatorio">Nivel educativo</label>
            <select class="form-select" id="NivelGuia" data-selector-nivel data-obligatorio></select>
            <div class="invalid-feedback"></div>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="PublicarGuia">
            <label class="form-check-label" for="PublicarGuia">Publicar en el portal al guardar</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="BotonGuardarGuia">Guardar guía</button>
        </div>
      </form>
    </div>
  </div>
</div>

@* ---------- Editar material (los cuatro tipos) ---------- *@
<div class="modal fade" id="ModalEditarMaterial" tabindex="-1" aria-labelledby="TituloModalEditarMaterial" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="FormularioEditarMaterial" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="TituloModalEditarMaterial">Editar material</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" id="AlertaEditarMaterial" role="alert"></div>
          <div class="mb-3">
            <label for="EditarTituloMaterial" class="form-label CampoObligatorio">Título</label>
            <input type="text" class="form-control" id="EditarTituloMaterial" maxlength="150">
            <div class="invalid-feedback"></div>
          </div>
          <div class="mb-3">
            <label for="EditarDescripcionMaterial" class="form-label">Descripción</label>
            <textarea class="form-control" id="EditarDescripcionMaterial" rows="3" maxlength="500"></textarea>
            <div class="invalid-feedback"></div>
          </div>
          <div class="mb-3">
            <label for="EditarNivelMaterial" class="form-label" id="EtiquetaEditarNivel">Nivel educativo</label>
            <select class="form-select" id="EditarNivelMaterial" data-selector-nivel></select>
            <div class="invalid-feedback"></div>
          </div>
          <div class="mb-3 d-none" id="GrupoEditarUrl">
            <label for="EditarUrlMaterial" class="form-label CampoObligatorio">Dirección</label>
            <input type="url" class="form-control" id="EditarUrlMaterial" maxlength="500">
            <div class="invalid-feedback"></div>
          </div>
          <div class="row g-3 d-none" id="GrupoEditarActividad">
            <div class="col-md-6">
              <label for="EditarTipoActividad" class="form-label CampoObligatorio">Tipo</label>
              <select class="form-select" id="EditarTipoActividad">
                <option value="">Seleccione</option>
                <option value="Ludica">Lúdica</option>
                <option value="Cognitiva">Cognitiva</option>
                <option value="Motriz">Motriz</option>
              </select>
              <div class="invalid-feedback"></div>
            </div>
            <div class="col-md-6">
              <label for="EditarFechaActividad" class="form-label CampoObligatorio">Fecha</label>
              <input type="date" class="form-control" id="EditarFechaActividad">
              <div class="invalid-feedback"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="BotonGuardarMaterial">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

@* ---------- Tarea (nueva y editar) ---------- *@
<div class="modal fade" id="ModalTarea" tabindex="-1" aria-labelledby="TituloModalTarea" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="FormularioTarea" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="TituloModalTarea">Nueva tarea</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" id="AlertaTarea" role="alert"></div>
          <div class="row g-3">
            <div class="col-md-8">
              <label for="TituloTarea" class="form-label CampoObligatorio">Título de la tarea</label>
              <input type="text" class="form-control" id="TituloTarea" maxlength="150">
              <div class="invalid-feedback"></div>
            </div>
            <div class="col-md-4">
              <label for="FechaLimiteTarea" class="form-label CampoObligatorio">Fecha límite</label>
              <input type="date" class="form-control" id="FechaLimiteTarea">
              <div class="invalid-feedback"></div>
            </div>
            <div class="col-12">
              <label for="DescripcionTarea" class="form-label">Descripción</label>
              <textarea class="form-control" id="DescripcionTarea" rows="3" maxlength="1000"></textarea>
              <div class="invalid-feedback"></div>
            </div>
            <div class="col-12">
              <label for="MaterialTarea" class="form-label">Material de apoyo</label>
              <select class="form-select" id="MaterialTarea">
                <option value="">Sin material</option>
              </select>
            </div>
            <div class="col-12">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="form-label CampoObligatorio mb-0" id="EtiquetaEstudiantesTarea">Asignar a</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="BotonTodosEstudiantesTarea">
                  Marcar todos
                </button>
              </div>
              <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;" id="EstudiantesTarea"
                   role="group" aria-labelledby="EtiquetaEstudiantesTarea"></div>
              <div class="text-danger small mt-1 d-none" id="ErrorEstudiantesTarea"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="BotonGuardarTarea">Asignar tarea</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    window.MATERIALES_NIVELES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(niveles, jsonCamel));
    window.MATERIALES_ESTUDIANTES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(estudiantes, jsonCamel));
    window.MATERIALES_TAMANO_MAXIMO_MB = @ViewBag.TamanoMaximoMb;
  </script>
  <script src="~/js/materiales.js" asp-append-version="true"></script>
}
