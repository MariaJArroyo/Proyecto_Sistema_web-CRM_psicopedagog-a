@{
    ViewData["Title"] = "Mi perfil";
}

      <main class="PrincipalAdmin">
        <div class="mb-4">
          <h2 class="mb-1">Mi perfil</h2>
          <p class="TextoSuave mb-0">Sus datos de cuenta dentro del panel administrativo.</p>
        </div>

        <div class="row g-3">
          <div class="col-lg-7">

            <!-- Datos personales -->
            <div class="Tarjeta p-3 p-md-4 mb-3">
              <h3 class="h5 mb-3">Datos personales</h3>
              <!-- Razor: asp-controller="Cuenta" asp-action="ActualizarPerfil" method="post" -->
              <form id="FormularioDatosPersonales" novalidate>
                <div class="row g-3">
                  <div class="col-12">
                    <label for="NombrePerfilAdmin" class="form-label CampoObligatorio">Nombre completo</label>
                    <input type="text" class="form-control" id="NombrePerfilAdmin" name="Nombre" value="Marcela Solano">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-6">
                    <label for="TelefonoPerfilAdmin" class="form-label CampoObligatorio">Teléfono</label>
                    <input type="tel" class="form-control" id="TelefonoPerfilAdmin" name="Telefono" value="8888-0000">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-6">
                    <label for="CorreoPerfilAdmin" class="form-label CampoObligatorio">Correo electrónico</label>
                    <input type="email" class="form-control" id="CorreoPerfilAdmin" name="CorreoElectronico"
                      value="marcela.solano@@menteactiva.cr">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-12">
                    <label class="form-label">Rol</label>
                    <input type="text" class="form-control" value="Administradora" disabled>
                    <div class="form-text">El rol lo asigna otra persona administradora desde "Usuarios internos".</div>
                  </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">
                  <i class="bi bi-save me-1"></i>Guardar cambios
                </button>
              </form>
            </div>

            <!-- Cambiar contraseña -->
            <div class="Tarjeta p-3 p-md-4">
              <h3 class="h5 mb-3">Cambiar contraseña</h3>
              <!-- Razor: asp-controller="Cuenta" asp-action="CambiarContrasena" method="post" -->
              <form id="FormularioCambiarContrasenaAdmin" novalidate>
                <div class="row g-3">
                  <div class="col-12">
                    <label for="ContrasenaActualAdmin" class="form-label CampoObligatorio">Contraseña actual</label>
                    <input type="password" class="form-control" id="ContrasenaActualAdmin"
                      autocomplete="current-password">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-6">
                    <label for="ContrasenaNuevaAdmin" class="form-label CampoObligatorio">Nueva contraseña</label>
                    <input type="password" class="form-control" id="ContrasenaNuevaAdmin" autocomplete="new-password">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-6">
                    <label for="ContrasenaConfirmarAdmin" class="form-label CampoObligatorio">Confirmar nueva
                      contraseña</label>
                    <input type="password" class="form-control" id="ContrasenaConfirmarAdmin"
                      autocomplete="new-password">
                    <div class="invalid-feedback"></div>
                  </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">
                  <i class="bi bi-key me-1"></i>Actualizar contraseña
                </button>
              </form>
            </div>
          </div>
        </div>
      </main>
      <!-- Razor: /fin de contenido de la vista -->

@section Scripts {
  <script src="~/js/Validaciones.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      document.getElementById("FormularioDatosPersonales").addEventListener("submit", function (evento) {
        evento.preventDefault();
        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("NombrePerfilAdmin"), "Ingrese su nombre completo.") && esValido;
        esValido = ValidarTelefono(document.getElementById("TelefonoPerfilAdmin")) && esValido;
        esValido = ValidarCorreo(document.getElementById("CorreoPerfilAdmin")) && esValido;
        if (!esValido) {
          return;
        }
        MostrarToast("Datos actualizados correctamente.");
      });
      document.getElementById("FormularioCambiarContrasenaAdmin").addEventListener("submit", function (evento) {
        evento.preventDefault();
        var campoActual = document.getElementById("ContrasenaActualAdmin");
        var campoNueva = document.getElementById("ContrasenaNuevaAdmin");
        var campoConfirmar = document.getElementById("ContrasenaConfirmarAdmin");
        var esValido = true;
        esValido = ValidarObligatorio(campoActual, "Ingrese su contraseña actual.") && esValido;
        if (!campoNueva.value || campoNueva.value.length < 8) {
          MarcarCampoInvalido(campoNueva, "La nueva contraseña debe tener al menos 8 caracteres.");
          esValido = false;
        } else {
          MarcarCampoValido(campoNueva);
        }
        if (!campoConfirmar.value || campoConfirmar.value !== campoNueva.value) {
          MarcarCampoInvalido(campoConfirmar, "Las contraseñas no coinciden.");
          esValido = false;
        } else {
          MarcarCampoValido(campoConfirmar);
        }
        if (!esValido) {
          return;
        }
        evento.target.reset();
        evento.target.querySelectorAll(".is-valid").forEach(function (campo) { campo.classList.remove("is-valid"); });
        MostrarToast("Contraseña actualizada correctamente.");
      });
    });
  </script>
}
