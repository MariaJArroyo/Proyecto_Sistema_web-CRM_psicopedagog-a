
@model MiPerfilViewModel

@{
    ViewData["Title"] = "Mi perfil";
}

<main class="PrincipalAdmin">

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success" role="alert">
            @mensaje
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    @if (ViewBag.ErrorCarga is string errorCarga)
    {
        <div class="alert alert-danger" role="alert">
            @errorCarga
        </div>
    }

    <div class="mb-4">
        <h2 class="mb-1">Mi perfil</h2>
        <p class="TextoSuave mb-0">Sus datos de cuenta dentro del panel administrativo.</p>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">

            <!-- Datos personales -->
            <div class="Tarjeta p-3 p-md-4 mb-3">
                <h3 class="h5 mb-3">Datos personales</h3>

                <form id="FormularioDatosPersonales" asp-controller="Admin"
                      asp-action="ActualizarMiPerfil" method="post" novalidate>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="NombrePerfilAdmin" class="form-label CampoObligatorio"> Nombre completo </label>

                            <input type="text"
                                   class="form-control"
                                   id="NombrePerfilAdmin"
                                   name="NombreCompleto"
                                   value="@Model.NombreCompleto">

                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="TelefonoPerfilAdmin" class="form-label">Teléfono</label>

                            <input type="tel" class="form-control" id="TelefonoPerfilAdmin" 
                            name="Telefono" value="@Model.Telefono" maxlength="15">

                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="CorreoPerfilAdmin"
                                   class="form-label CampoObligatorio">
                                Correo electrónico
                            </label>

                            <input type="email"
                                   class="form-control"
                                   id="CorreoPerfilAdmin"
                                   name="Correo"
                                   value="@Model.Correo">

                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Rol</label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.Rol"
                                   disabled>

                            <div class="form-text">
                                El rol lo asigna otra persona administradora desde "Usuarios internos".
                            </div>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-save me-1"></i>Guardar cambios
                    </button>

                </form>
            </div>

            <!-- Cambiar contraseña -->
            <div class="Tarjeta p-3 p-md-4">
                <h3 class="h5 mb-3">Cambiar contraseña</h3>

                <form id="FormularioCambiarContrasenaAdmin"
                      asp-controller="Admin"
                      asp-action="CambiarContrasena"
                      method="post"
                      novalidate>

                    <div class="row g-3">

                        <div class="col-12">
                            <label for="ContrasenaActualAdmin"
                                   class="form-label CampoObligatorio">
                                Contraseña actual
                            </label>

                            <input type="password"
                                   class="form-control"
                                   id="ContrasenaActualAdmin"
                                   name="ContrasenaActual"
                                   autocomplete="current-password">

                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="ContrasenaNuevaAdmin"
                                   class="form-label CampoObligatorio">
                                Nueva contraseña
                            </label>

                            <input type="password"
                                   class="form-control"
                                   id="ContrasenaNuevaAdmin"
                                   name="ContrasenaNueva"
                                   autocomplete="new-password">

                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="ContrasenaConfirmarAdmin"
                                   class="form-label CampoObligatorio">
                                Confirmar nueva contraseña
                            </label>

                            <input type="password"
                                   class="form-control"
                                   id="ContrasenaConfirmarAdmin"
                                   name="ConfirmarContrasena"
                                   autocomplete="new-password">

                            <div class="invalid-feedback"></div>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-key me-1"></i>Actualizar contraseña
                    </button>

                </form>
            </div>

        </div>
    </div>
</main>

@section Scripts {

    <script src="~/js/Validaciones.js"></script>
    <script src="~/js/MiPerfil.js"></script>

    }
    
