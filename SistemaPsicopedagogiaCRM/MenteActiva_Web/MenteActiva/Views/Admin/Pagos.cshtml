@{
    ViewData["Title"] = "Pagos";
}

      <main class="PrincipalAdmin">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
          <div>
            <h2 class="mb-1">Facturación y pagos</h2>
            <p class="TextoSuave mb-0">Historial de pagos ordenado por fecha.</p>
          </div>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ModalRegistrarPago">
            <i class="bi bi-plus-lg me-1"></i>Registrar pago
          </button>
        </div>

        <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
          <i class="bi bi-exclamation-triangle-fill fs-5"></i>
          <span>Hay <strong>2 pagos pendientes</strong> y <strong>1 pago vencido</strong> que requieren
            seguimiento.</span>
        </div>

        <div class="Tarjeta p-3 p-md-4">

          <div class="row g-2 mb-3" data-tabla-buscador="TablaPagos">
            <div class="col-md-7">
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" data-buscar-texto placeholder="Buscar por estudiante">
              </div>
            </div>
            <div class="col-md-5">
              <select class="form-select" data-buscar-estado aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                <option value="Pagado">Pagado</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Vencido">Vencido</option>
              </select>
            </div>
          </div>

          <!-- Razor: reemplazar por @@foreach (var pago in Model.Pagos.OrderByDescending(p => p.Fecha)) -->
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaPagos">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Estudiante</th>
                  <th>Monto</th>
                  <th>Método</th>
                  <th>Estado</th>
                  <th class="TablaAcciones">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <tr data-fila data-estado="Pagado" data-modal-detalle="ModalDetallePago"
                  data-valor-fecha="10 de julio, 2026" data-valor-estudiante="María Rodríguez"
                  data-valor-encargado="Carlos Jiménez" data-valor-monto="₡15 000" data-valor-metodo="Sinpe Móvil"
                  data-valor-concepto="Sesión individual" data-valor-estado="Pagado">
                  <td>10 jul 2026</td>
                  <td>María Rodríguez</td>
                  <td>₡15 000</td>
                  <td>Sinpe Móvil</td>
                  <td><span class="badge badge-pago-pagado">Pagado</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip"
                      title="Ver detalle"><i class="bi bi-eye"></i></button>
                  </td>
                </tr>
                <tr data-fila data-estado="Pagado" data-modal-detalle="ModalDetallePago"
                  data-valor-fecha="8 de julio, 2026" data-valor-estudiante="Diego Vargas"
                  data-valor-encargado="Rodolfo Vargas" data-valor-monto="₡15 000" data-valor-metodo="Efectivo"
                  data-valor-concepto="Sesión individual" data-valor-estado="Pagado">
                  <td>8 jul 2026</td>
                  <td>Diego Vargas</td>
                  <td>₡15 000</td>
                  <td>Efectivo</td>
                  <td><span class="badge badge-pago-pagado">Pagado</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip"
                      title="Ver detalle"><i class="bi bi-eye"></i></button>
                  </td>
                </tr>
                <tr data-fila data-estado="Pendiente" data-modal-detalle="ModalDetallePago"
                  data-valor-fecha="5 de julio, 2026" data-valor-estudiante="Ana Castro"
                  data-valor-encargado="Marjorie Castro" data-valor-monto="₡60 000" data-valor-metodo="Transferencia"
                  data-valor-concepto="Paquete de sesiones" data-valor-estado="Pendiente">
                  <td>5 jul 2026</td>
                  <td>Ana Castro</td>
                  <td>₡60 000</td>
                  <td>Transferencia</td>
                  <td><span class="badge badge-pago-pendiente">Pendiente</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip"
                      title="Ver detalle"><i class="bi bi-eye"></i></button>
                  </td>
                </tr>
                <tr data-fila data-estado="Pagado" data-modal-detalle="ModalDetallePago"
                  data-valor-fecha="1 de julio, 2026" data-valor-estudiante="Valeria Mora"
                  data-valor-encargado="Marta Mora" data-valor-monto="₡15 000" data-valor-metodo="Tarjeta"
                  data-valor-concepto="Sesión individual" data-valor-estado="Pagado">
                  <td>1 jul 2026</td>
                  <td>Valeria Mora</td>
                  <td>₡15 000</td>
                  <td>Tarjeta</td>
                  <td><span class="badge badge-pago-pagado">Pagado</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip"
                      title="Ver detalle"><i class="bi bi-eye"></i></button>
                  </td>
                </tr>
                <tr data-fila data-estado="Vencido" data-modal-detalle="ModalDetallePago"
                  data-valor-fecha="28 de junio, 2026" data-valor-estudiante="Kevin Fernández"
                  data-valor-encargado="José Fernández" data-valor-monto="₡15 000" data-valor-metodo="Efectivo"
                  data-valor-concepto="Sesión individual" data-valor-estado="Vencido">
                  <td>28 jun 2026</td>
                  <td>Kevin Fernández</td>
                  <td>₡15 000</td>
                  <td>Efectivo</td>
                  <td><span class="badge badge-pago-vencido">Vencido</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip"
                      title="Ver detalle"><i class="bi bi-eye"></i></button>
                  </td>
                </tr>
                <tr data-fila data-estado="Pendiente" data-modal-detalle="ModalDetallePago"
                  data-valor-fecha="20 de junio, 2026" data-valor-estudiante="Fabián Méndez"
                  data-valor-encargado="Laura Méndez" data-valor-monto="₡15 000" data-valor-metodo="Sinpe Móvil"
                  data-valor-concepto="Sesión individual" data-valor-estado="Pendiente">
                  <td>20 jun 2026</td>
                  <td>Fabián Méndez</td>
                  <td>₡15 000</td>
                  <td>Sinpe Móvil</td>
                  <td><span class="badge badge-pago-pendiente">Pendiente</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="tooltip"
                      title="Ver detalle"><i class="bi bi-eye"></i></button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <!-- /Razor -->

          <!-- Estado vacío: sin resultados de búsqueda -->
          <div class="EstadoVacio d-none" data-tabla-vacio="TablaPagos">
            <i class="bi bi-cash-coin"></i>
            <p class="mb-3">No se encontraron pagos con ese criterio de búsqueda.</p>
          </div>
        </div>
      </main>
      <!-- Razor: /fin de contenido de la vista -->

      <div class="modal fade" id="ModalRegistrarPago" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <!-- Razor: asp-controller="Pagos" asp-action="Crear" method="post" -->
            <form id="FormularioRegistrarPago" novalidate>
              <div class="modal-header">
                <h5 class="modal-title">Registrar pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="EstudiantePago" class="form-label CampoObligatorio">Estudiante</label>
                    <select class="form-select" id="EstudiantePago" name="EstudianteId">
                      <option value="" selected>Seleccione un estudiante</option>
                      <option value="MariaRodriguez">María Rodríguez</option>
                      <option value="DiegoVargas">Diego Vargas</option>
                      <option value="AnaCastro">Ana Castro</option>
                      <option value="KevinFernandez">Kevin Fernández</option>
                      <option value="FabianMendez">Fabián Méndez</option>
                      <option value="ValeriaMora">Valeria Mora</option>
                      <option value="EmilyAraya">Emily Araya</option>
                      <option value="FabianSolis">Fabián Solís</option>
                    </select>
                    <div class="invalid-feedback"></div>
                    <div class="form-text" id="AsociacionEncargado"></div>
                  </div>
                  <div class="col-md-6">
                    <label for="MontoPago" class="form-label CampoObligatorio">Monto (₡)</label>
                    <input type="number" class="form-control" id="MontoPago" name="Monto" min="0" step="1000"
                      placeholder="15000">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-4">
                    <label for="FechaPago" class="form-label CampoObligatorio">Fecha</label>
                    <input type="date" class="form-control" id="FechaPago" name="Fecha" value="2026-07-12">
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-4">
                    <label for="MetodoPago" class="form-label CampoObligatorio">Método</label>
                    <select class="form-select" id="MetodoPago" name="Metodo">
                      <option value="" selected>Seleccione</option>
                      <option value="Efectivo">Efectivo</option>
                      <option value="Transferencia">Transferencia</option>
                      <option value="Tarjeta">Tarjeta</option>
                      <option value="SinpeMovil">Sinpe Móvil</option>
                    </select>
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-4">
                    <label for="ConceptoPago" class="form-label CampoObligatorio">Concepto</label>
                    <select class="form-select" id="ConceptoPago" name="Concepto">
                      <option value="" selected>Seleccione</option>
                      <option value="SesionIndividual">Sesión individual</option>
                      <option value="PaqueteSesiones">Paquete de sesiones</option>
                    </select>
                    <div class="invalid-feedback"></div>
                  </div>
                  <div class="col-md-4">
                    <label for="EstadoPago" class="form-label CampoObligatorio">Estado</label>
                    <select class="form-select" id="EstadoPago" name="Estado">
                      <option value="Pagado" selected>Pagado</option>
                      <option value="Pendiente">Pendiente</option>
                    </select>
                    <div class="invalid-feedback"></div>
                    <div class="form-text">Use "Pendiente" si aún no se ha recibido el pago.</div>
                  </div>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar pago</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="modal fade" id="ModalDetallePago" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Detalle del pago</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <dl class="row mb-0">
                <dt class="col-5 TextoSuave fw-normal">Fecha</dt>
                <dd class="col-7" data-campo="fecha"></dd>
                <dt class="col-5 TextoSuave fw-normal">Estudiante</dt>
                <dd class="col-7" data-campo="estudiante"></dd>
                <dt class="col-5 TextoSuave fw-normal">Encargado</dt>
                <dd class="col-7" data-campo="encargado"></dd>
                <dt class="col-5 TextoSuave fw-normal">Monto</dt>
                <dd class="col-7" data-campo="monto"></dd>
                <dt class="col-5 TextoSuave fw-normal">Método</dt>
                <dd class="col-7" data-campo="metodo"></dd>
                <dt class="col-5 TextoSuave fw-normal">Concepto</dt>
                <dd class="col-7" data-campo="concepto"></dd>
              </dl>

              <hr>

              <label for="EstadoPagoSeleccionado" class="form-label">Estado del pago</label>
              <div class="input-group">
                <select class="form-select" id="EstadoPagoSeleccionado">
                  <option value="Pagado">Pagado</option>
                  <option value="Pendiente">Pendiente</option>
                  <option value="Vencido">Vencido</option>
                </select>
                <button type="button" class="btn btn-outline-primary" id="BotonGuardarEstadoPago">Guardar</button>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
          </div>
        </div>
      </div>

@section Scripts {
  <script src="~/js/Validaciones.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var nombresEncargados = {
        MariaRodriguez: "Carlos Jiménez", DiegoVargas: "Rodolfo Vargas", AnaCastro: "Marjorie Castro",
        KevinFernandez: "José Fernández", FabianMendez: "Laura Méndez", ValeriaMora: "Marta Mora",
        EmilyAraya: "Patricia Araya", FabianSolis: "Óscar Solís"
      };
      document.getElementById("EstudiantePago").addEventListener("change", function () {
        var encargado = nombresEncargados[this.value];
        document.getElementById("AsociacionEncargado").textContent = encargado ? "Encargado asociado: " + encargado : "";
      });
      var mapaBadgePago = {
        Pagado: "badge-pago-pagado",
        Pendiente: "badge-pago-pendiente",
        Vencido: "badge-pago-vencido"
      };
      var tablaPagos = document.getElementById("TablaPagos");
      var filaPagoSeleccionada = null;
      tablaPagos.addEventListener("click", function (evento) {
        var fila = evento.target.closest("[data-modal-detalle]");
        if (!fila) {
          return;
        }
        filaPagoSeleccionada = fila;
        document.getElementById("EstadoPagoSeleccionado").value = fila.getAttribute("data-estado");
      });
      document.getElementById("BotonGuardarEstadoPago").addEventListener("click", function () {
        if (!filaPagoSeleccionada) {
          return;
        }
        var nuevoEstado = document.getElementById("EstadoPagoSeleccionado").value;
        var insignia = filaPagoSeleccionada.querySelector(".badge");
        insignia.className = "badge " + mapaBadgePago[nuevoEstado];
        insignia.textContent = nuevoEstado;
        filaPagoSeleccionada.setAttribute("data-estado", nuevoEstado);
        filaPagoSeleccionada.setAttribute("data-valor-estado", nuevoEstado);
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalDetallePago")).hide();
        MostrarToast("Estado del pago actualizado a \"" + nuevoEstado + "\".");
      });
      document.getElementById("FormularioRegistrarPago").addEventListener("submit", function (evento) {
        evento.preventDefault();
        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("EstudiantePago"), "Seleccione un estudiante.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("MontoPago"), "Ingrese el monto.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("FechaPago"), "Seleccione la fecha.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("MetodoPago"), "Seleccione el método de pago.") && esValido;
        esValido = ValidarObligatorio(document.getElementById("ConceptoPago"), "Seleccione el concepto.") && esValido;
        if (!esValido) {
          return;
        }
        evento.target.reset();
        document.getElementById("FechaPago").value = "2026-07-12";
        document.getElementById("AsociacionEncargado").textContent = "";
        evento.target.querySelectorAll(".is-valid").forEach(function (campo) { campo.classList.remove("is-valid"); });
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalRegistrarPago")).hide();
        MostrarToast("Pago registrado correctamente.");
      });
    });
  </script>
}
