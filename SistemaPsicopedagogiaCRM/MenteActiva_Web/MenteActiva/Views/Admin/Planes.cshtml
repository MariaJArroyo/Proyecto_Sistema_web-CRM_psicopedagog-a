@model IEnumerable<MenteActiva.Models.PlanViewModel>

@{
    ViewData["Title"] = "Planes de intervención";
}

<main class="PrincipalAdmin">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1">Planes de intervención</h2>
            <p class="TextoSuave mb-0">Listado ordenado alfabéticamente por título del plan.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ModalNuevoPlan">
            <i class="bi bi-plus-lg me-1"></i>Nuevo plan
        </button>
    </div>

    <div class="Tarjeta p-3 p-md-4">

        <div class="row g-2 mb-3" data-tabla-buscador="TablaPlanes">
            <div class="col-12">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" data-buscar-texto
                           placeholder="Buscar por título de plan o estudiante">
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaPlanes">

                <thead>
                    <tr>
                        <th>Título del plan</th>
                        <th>Estudiante</th>
                        <th>Inicio</th>
                        <th>Finalización</th>
                        <th>Estado</th>
                        <th class="TablaAcciones">Acciones</th>
                    </tr>
                </thead>


                <tbody>

                    @foreach (var plan in Model)
                    {

                        <tr data-fila
                            data-id-plan="@plan.IdPlan"
                            data-valor-titulo="@plan.Titulo"
                            data-valor-estudiante="@plan.Estudiante"
                            data-valor-objetivo="@plan.ObjetivoGeneral"
                            data-valor-observaciones="@plan.Observaciones"
                            data-valor-inicio="@plan.FechaInicio.ToString("dd-MM-yyyy")"
                            data-valor-fecha-inicio-api="@plan.FechaInicio.ToString("yyyy-MM-dd")"
                            data-valor-fin="@(plan.FechaFin.HasValue ? plan.FechaFin.Value.ToString("dd/MM/yyyy") : "No definida")"
                            data-valor-fecha-fin="@(plan.FechaFin.HasValue ? plan.FechaFin.Value.ToString("yyyy-MM-dd") : "")"
                            data-valor-estado="@plan.Estado">


                            <td data-campo="titulo">
                                @plan.Titulo
                            </td>

                            <td data-campo="estudiante">
                                @plan.Estudiante
                            </td>

                            <td data-campo="inicio">
                                @plan.FechaInicio.ToString("dd MMM yyyy")
                            </td>

                            <td data-campo="fin">
                                @(plan.FechaFin.HasValue
                                    ? plan.FechaFin.Value.ToString("dd MMM yyyy")
                                    : "No definida")
                            </td>

                            <td data-campo="estado">
                                @plan.Estado
                            </td>


                            <td class="TablaAcciones">

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary border-0"
                                        data-accion="ver"
                                        data-bs-toggle="tooltip"
                                        title="Ver detalle">
                                    <i class="bi bi-eye"></i>
                                </button>

                                
                                <button type="button"
                                        class="btn btn-sm border-0"
                                        data-accion="cambiar-estado"
                                        data-bs-toggle="tooltip"
                                        title="Inactivar plan">
                                    <i class="bi bi-archive"></i>
                                </button>

                                
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger border-0"
                                        data-accion="eliminar-plan"
                                        data-bs-toggle="tooltip"
                                        title="Eliminar plan">
                                    <i class="bi bi-trash"></i>
                                </button>


                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>


        <div class="EstadoVacio @(Model.Any() ? "d-none" : "")"
             data-tabla-vacio="TablaPlanes">
            <i class="bi bi-clipboard2-pulse"></i>
            <p class="mb-3">
                @(Model.Any()
                    ? "No se encontraron planes con ese criterio de búsqueda."
                    : "No hay planes de intervención registrados.")
            </p>
        </div>


    </div>
</main>


<!-- ========================================================= -->
<!-- MODAL NUEVO PLAN -->
<!-- ========================================================= -->

<div class="modal fade" id="ModalNuevoPlan" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <form id="FormularioNuevoPlan"
                  method="post"
                  action="@Url.Action("CrearPlan", "Admin")"
                  novalidate>

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Nuevo plan de intervención</h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <!-- TÍTULO -->
                        <div class="col-md-8">
                            <label for="TituloNuevoPlan"
                                   class="form-label CampoObligatorio">
                                Título del plan
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="TituloNuevoPlan"
                                   name="Titulo">

                            <div class="invalid-feedback"></div>
                        </div>


                        <!-- FECHA DE INICIO -->
                        <div class="col-md-4">
                            <label for="InicioNuevoPlan"
                                   class="form-label CampoObligatorio">
                                Fecha de inicio
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="InicioNuevoPlan"
                                   name="FechaInicio">

                            <div class="invalid-feedback"></div>
                        </div>


                        <!-- ESTUDIANTE -->
                        <div class="col-md-4">
                            <label for="EstudianteNuevoPlan"
                                   class="form-label CampoObligatorio">
                                Estudiante
                            </label>

                            <select class="form-select"
                                    id="EstudianteNuevoPlan"
                                    name="IdEstudiante">

                                <option value="" selected>
                                    Seleccione un estudiante
                                </option>

                                @if (ViewBag.Estudiantes != null)
                                {
                                    foreach (var estudiante in ViewBag.Estudiantes)
                                    {
                                        <option value="@estudiante.IdEstudiante">
                                            @estudiante.Estudiante
                                        </option>
                                    }
                                }

                            </select>

                            <div class="invalid-feedback"></div>
                        </div>


                        <!-- FECHA DE FINALIZACIÓN -->
                        <div class="col-md-4">
                            <label for="FinNuevoPlan"
                                   class="form-label CampoObligatorio">
                                Fecha de finalización
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="FinNuevoPlan"
                                   name="FechaFin">

                            <div class="invalid-feedback"></div>
                        </div>


                        <!-- ESTADO -->
                        <div class="col-md-4">
                            <label for="EstadoNuevoPlan"
                                   class="form-label CampoObligatorio">
                                Estado
                            </label>

                            <select class="form-select"
                                    id="EstadoNuevoPlan"
                                    name="IdEstadoPlan">

                                <option value="" selected>
                                    Seleccione un estado
                                </option>

                                <option value="1">
                                    Borrador
                                </option>

                                <option value="2">
                                    Activo
                                </option>

                                <option value="3">
                                    Finalizado
                                </option>

                                <option value="4">
                                    Suspendido
                                </option>

                            </select>

                            <div class="invalid-feedback"></div>
                        </div>


                        <!-- OBJETIVO -->
                        <div class="col-12">
                            <label for="ObjetivoNuevoPlan"
                                   class="form-label CampoObligatorio">
                                Objetivo general
                            </label>

                            <textarea class="form-control"
                                      id="ObjetivoNuevoPlan"
                                      name="ObjetivoGeneral"
                                      rows="3"></textarea>

                            <div class="invalid-feedback"></div>
                        </div>

                        <!-- OBSERVACIONES -->
                        <div class="col-12">
                            <label for="Observaciones" class="form-label">
                                Observaciones
                            </label>

                            <textarea class="form-control"
                                      id="ObservacionesNuevoPlan"
                                      name="Observaciones"
                                      rows="3"
                                      maxlength="1000"
                                      placeholder="Ingrese las observaciones del plan"></textarea>
                        </div>


                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar plan
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>


