        async function CargarActividadesPlan(estrategias) {
            var lista = document.getElementById("ListaActividades");
            lista.innerHTML = "";

            if (!estrategias || estrategias.length === 0) {
                lista.innerHTML = `
                    <li class="list-group-item px-0">
                        Este plan todavía no tiene actividades.
                    </li>`;
                return;
            }

            try {
                var resultados = await Promise.all(
                    estrategias.map(async function (estrategia) {
                        var respuesta = await fetch(
                            "@Url.Action("ListarActividades", "Admin")?idEstrategia=" +
                            estrategia.idEstrategia
                        );

                        if (!respuesta.ok) {
                            throw new Error(
                                "No se pudieron consultar las actividades de la estrategia " +
                                estrategia.idEstrategia
                            );
                        }

                        var actividades = await respuesta.json();

                        return actividades.map(function (actividad) {
                            return {
                                ...actividad,
                                descripcionEstrategia: estrategia.descripcion
                            };
                        });
                    })
                );

                var actividadesPlan = resultados.flat();

                if (actividadesPlan.length === 0) {
                    lista.innerHTML = `
                        <li class="list-group-item px-0">
                            Este plan todavía no tiene actividades.
                        </li>`;
                    return;
                }

                actividadesPlan.forEach(function (actividad) {
                    var item = document.createElement("li");

                    item.className =
                        "list-group-item px-0 d-flex justify-content-between align-items-center";

                    item.dataset.tipoItem = "actividad";
                    item.dataset.idActividad = actividad.idActividad;
                    item.dataset.idEstrategia = actividad.idEstrategia;

                    var contenido = document.createElement("div");

                    var nombre = document.createElement("div");
                    nombre.textContent = actividad.nombre;

                    var detalle = document.createElement("div");
                    detalle.className = "TextoSuave small";
                    detalle.textContent =
                        "Vinculada a: " + actividad.descripcionEstrategia;

                    contenido.appendChild(nombre);
                    contenido.appendChild(detalle);
                    item.appendChild(contenido);

                    lista.appendChild(item);
                });

            } catch (error) {
                console.error("Error al cargar las actividades:", error);

                lista.innerHTML = `
                    <li class="list-group-item px-0 text-danger">
                        No se pudieron cargar las actividades.
                    </li>`;
            }
        }





