            /* =====================================================
               AGREGAR ACTIVIDAD
               ===================================================== */

            
        document.getElementById(
            "FormularioAgregarActividad"
        ).addEventListener("submit", async function (evento) {

            evento.preventDefault();

            var campoNombre =
                document.getElementById("NombreActividad");

            var selector =
                document.getElementById("EstrategiaVinculada");

            if (!ValidarObligatorio(
                campoNombre,
                "Ingrese el nombre de la actividad."
            )) {
                return;
            }

            if (!filaSeleccionada) {
                MostrarToast(
                    "Primero debe seleccionar un plan.",
                    "error"
                );
                return;
            }

            var idEstrategia = Number(selector.value);

            if (!idEstrategia || idEstrategia <= 0) {
                MostrarToast(
                    "Seleccione una estrategia para vincular la actividad.",
                    "error"
                );
                return;
            }

            var datos = {
                IdEstrategia: idEstrategia,
                Nombre: campoNombre.value.trim(),
                Descripcion: null
            };

            try {
                var respuesta = await fetch(
                    "@Url.Action("CrearActividad", "Admin")",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": document.querySelector(
                                '#FormularioAgregarActividad input[name="__RequestVerificationToken"]'
                            ).value
                        },
                        body: JSON.stringify(datos)
                    }
                );

                var resultado = await respuesta.json();

                if (!respuesta.ok) {
                    MostrarToast(
                        resultado.mensaje ||
                        "No se pudo agregar la actividad.",
                        "error"
                    );
                    return;
                }

                        var idPlan = Number(
            filaSeleccionada.getAttribute("data-id-plan")
        );

        await CargarEstrategiasPlan(idPlan);

                evento.target.reset();
                campoNombre.classList.remove("is-valid");

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("ModalAgregarActividad")
                ).hide();

                MostrarToast(
                    resultado.mensaje ||
                    "Actividad agregada correctamente."
                );

            } catch (error) {
                console.error(error);

                MostrarToast(
                    "No se pudo conectar con el servidor.",
                    "error"
                );
            }
        });



            /* =====================================================
               ELIMINAR ELEMENTOS DEL PLAN
               ===================================================== */

            
        /* =====================================================
           ELIMINAR ELEMENTOS DEL PLAN
           ===================================================== */

        modalDetalleElemento.addEventListener(
            "click",
            function (evento) {

                var boton = evento.target.closest(
                    '[data-accion="eliminar-item"]'
                );

                if (!boton) {
                    return;
                }

                itemAEliminar = boton.closest("li");

                if (!itemAEliminar) {
                    return;
                }

                instanciaConfirmarEliminarItem.show();
            }
        );


        document.getElementById(
            "BotonConfirmarEliminarItem"
        ).addEventListener("click", async function () {

            if (!itemAEliminar) {
                return;
            }

            var item = itemAEliminar;
            var esEstrategia = item.dataset.tipoItem === "estrategia";

            if (esEstrategia) {

                var idEstrategia = Number(item.dataset.idEstrategia);

                if (!idEstrategia || idEstrategia <= 0) {
                    MostrarToast(
                        "No se pudo identificar la estrategia.",
                        "error"
                    );
                    return;
                }

                try {
                    var token = document.querySelector(
                        '#FormularioAgregarEstrategia input[name="__RequestVerificationToken"]'
                    ).value;

                    var respuesta = await fetch(
                        "@Url.Action("EliminarEstrategia", "Admin")?idEstrategia=" + idEstrategia,
                        {
                            method: "DELETE",
                            headers: {
                                "RequestVerificationToken": token
                            }
                        }
                    );

                    var resultado = await respuesta.json();

                    if (!respuesta.ok) {
                        MostrarToast(
                            resultado.mensaje ||
                            "No se pudo eliminar la estrategia.",
                            "error"
                        );
                        return;
                    }

                    var selector = document.getElementById("EstrategiaVinculada");

                    var opcion = selector.querySelector(
                        'option[value="' + idEstrategia + '"]'
                    );

                    if (opcion) {
                        opcion.remove();
                    }

                    item.remove();

                    MostrarToast(
                        resultado.mensaje ||
                        "Estrategia eliminada correctamente."
                    );

                } catch (error) {
                    console.error(error);

                    MostrarToast(
                        "No se pudo conectar con el servidor.",
                        "error"
                    );

                    return;
                }

            } else {

                // Las actividades todavía son elementos locales de la pantalla.
                item.remove();

                MostrarToast(
                    "Elemento eliminado del plan.",
                    "error"
                );
            }

            itemAEliminar = null;
            instanciaConfirmarEliminarItem.hide();

            });

        }); // Cierre de DOMContentLoaded


    </script>
}