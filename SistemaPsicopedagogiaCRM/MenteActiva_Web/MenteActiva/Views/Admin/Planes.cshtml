@section Scripts {

    <script src="~/js/Validaciones.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            console.log("Planes.js se está ejecutando");

            var tabla = document.getElementById("TablaPlanes");

            var modalDetalleElemento =
                document.getElementById("ModalDetallePlan");

            var instanciaDetalle =
                bootstrap.Modal.getOrCreateInstance(modalDetalleElemento);

            var instanciaEditar =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("ModalEditarPlan")
                );

            var instanciaEliminarPlan =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("ModalEliminarPlan")
                );

            var instanciaConfirmarEliminarItem =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("ModalConfirmarEliminarItem")
                );

            var filaSeleccionada = null;
            var estadoDestinoPlan = null;
            var itemAEliminar = null;
            var accionConfirmadaPlan = "estado";


                        async function CargarHistorialPlan(idPlan) {

                var listaHistorial =
                    document.getElementById("ListaHistorialPlan");

                listaHistorial.innerHTML = `
                    <li class="mb-1">
                        <i class="bi bi-hourglass-split me-1"></i>
                        Cargando historial...
                    </li>
                `;

                try {

                    var respuesta = await fetch(
                        "@Url.Action("HistorialPlan", "Admin")?id=" + idPlan
                    );

                    if (!respuesta.ok) {
                        throw new Error("No se pudo consultar el historial.");
                    }

                    var historial = await respuesta.json();

                    listaHistorial.innerHTML = "";

                    if (!historial || historial.length === 0) {

                        listaHistorial.innerHTML = `
                            <li class="mb-1">
                                <i class="bi bi-clock-history me-1"></i>
                                No hay registros de cambios.
                            </li>
                        `;

                        return;
                    }

                    historial.forEach(function (registro) {

                        var fecha = new Date(registro.fechaHora);

                        var fechaFormateada =
                            fecha.toLocaleDateString("es-CR", {
                                day: "numeric",
                                month: "long",
                                year: "numeric"
                            });

                        var horaFormateada =
                            fecha.toLocaleTimeString("es-CR", {
                                hour: "2-digit",
                                minute: "2-digit"
                            });

                        var elemento = document.createElement("li");

                        elemento.className = "mb-2";

                        elemento.innerHTML = `
                            <i class="bi bi-clock-history me-1"></i>
                            <strong>${fechaFormateada}, ${horaFormateada}</strong>
                            — ${registro.accion}
                            — ${registro.usuario}
                        `;

                        listaHistorial.appendChild(elemento);

                    });

                }
                catch (error) {

                    console.error(error);

                    listaHistorial.innerHTML = `
                        <li class="mb-1 text-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            No se pudo cargar el historial.
                        </li>
                    `;
                }
            }

            
        
        async function CargarEstrategiasPlan(idPlan) {

            var lista = document.getElementById("ListaEstrategias");
            var selector = document.getElementById("EstrategiaVinculada");

            lista.innerHTML = `
                <li class="list-group-item px-0">
                    Cargando estrategias...
                </li>
            `;

            try {
                var respuesta = await fetch(
