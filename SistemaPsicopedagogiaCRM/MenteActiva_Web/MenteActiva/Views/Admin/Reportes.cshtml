@{
    ViewData["Title"] = "Reportes";
}

<main class="PrincipalAdmin">

    <div class="mb-4">
        <h2 class="mb-1">Reportes de estudiante</h2>
        <p class="TextoSuave mb-0" id="ResumenReportes" aria-live="polite">&nbsp;</p>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ModalGenerarReporte">
            <i class="bi bi-plus-lg me-1"></i>Generar reporte
        </button>
    </div>
    <div class="Tarjeta p-3 p-md-4">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaReportes">
                <thead>
                    <tr>
                        <th>Reporte</th>
                        <th>Estudiante</th>
                        <th>Período</th>
                        <th>Generado</th>
                        <th>Generado por</th>
                        <th class="TablaAcciones">Acciones</th>
                    </tr>
                </thead>
                <tbody id="CuerpoTablaReportes"></tbody>
            </table>
        </div>

        <div class="EstadoVacio d-none" id="VacioReportes">
            <i class="bi bi-bar-chart-line"></i>
            <p class="mb-0">No hay reportes generados todavía.</p>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
            <div class="d-flex align-items-center gap-2">
                <label for="CantidadReportes" class="mb-0">Mostrar</label>
                <select id="CantidadReportes" class="form-select form-select-sm w-auto">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span id="RangoReportes" class="TextoSuave" role="status" aria-live="polite"></span>
            </div>
            <nav aria-label="Paginación de reportes" class="d-flex align-items-center gap-2">
                <button id="AnteriorReportes" type="button" class="btn btn-sm btn-outline-secondary" aria-controls="TablaReportes" disabled>Anterior</button>
                <span id="PaginaReportes" class="TextoSuave">Página 1 de 1</span>
                <button id="SiguienteReportes" type="button" class="btn btn-sm btn-outline-secondary" aria-controls="TablaReportes" disabled>Siguiente</button>
            </nav>
        </div>
        <div class="alert d-none mt-3" id="AlertaReportes" role="alert"></div>

    </div>
</main>

<!-- HU-M7-4: detalle del reporte -->
<div class="modal fade" id="ModalDetalleReporte" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="TituloDetalleReporte">Detalle del reporte</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-3" id="DatosDetalleReporte"></dl>
                <hr>
                <div id="ContenidoDetalleReporte"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalGenerarReporte" tabindex="-1"
     aria-labelledby="TituloGenerarReporte" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="TituloGenerarReporte">Generar reporte del estudiante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="FormularioGenerarReporte" action="@Url.Action("GenerarReporte", "Admin")" method="post"
                  data-url-estudiantes="@Url.Action("EstudiantesReporte", "Admin")"
                  data-url-ficha="@Url.Action("FichaEstudianteReporte", "Admin")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div id="AlertaGenerarReporte" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="EstudianteReporte" class="form-label">Estudiante</label>
                        <select id="EstudianteReporte" name="IdEstudiante" class="form-select" required disabled>
                            <option value="">Cargando estudiantes…</option>
                        </select>
                        <button id="RecargarEstudiantesReporte" type="button" class="btn btn-link btn-sm px-0">Actualizar estudiantes</button>
                    </div>
                    <div id="FichaEstudianteReporte" class="border rounded bg-light p-3 mb-3 d-none">
                        <h6>Información del estudiante</h6>
                        <div id="DatosEstudianteReporte"></div>
                    </div>
                    <div class="mb-3">
                        <label for="TituloReporte" class="form-label">Título del reporte</label>
                        <input id="TituloReporte" name="Titulo" class="form-control" maxlength="150" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="InicioReporte" class="form-label">Fecha inicial</label>
                            <input id="InicioReporte" name="PeriodoInicio" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="FinReporte" class="form-label">Fecha final</label>
                            <input id="FinReporte" name="PeriodoFin" type="date" class="form-control" required />
                        </div>
                    </div>
                    <p class="TextoSuave small mt-3 mb-0">El reporte incluirá las sesiones y los planes del período seleccionado, junto con el estado de pagos.</p>
                </div>
                <div class="modal-footer">
                    <button id="CerrarGenerarReporte" type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button id="GenerarReporteBtn" type="submit" class="btn btn-primary" disabled>Generar reporte</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/Reportes.js" asp-append-version="true"></script>
}