@{
    ViewData["Title"] = "Reportes";
}

      <main class="PrincipalAdmin">
        <div class="mb-4">
          <h2 class="mb-1">Reportes de estudiante</h2>
          <p class="TextoSuave mb-0">Sesiones, avances y progreso general por estudiante.</p>
        </div>

        <div class="Tarjeta p-3 p-md-4 mb-3 NoImprimir">
          <div class="row g-3 align-items-end">
            <div class="col-md-5">
              <label for="FiltroEstudianteReporte" class="form-label">Estudiante</label>
              <select class="form-select" id="FiltroEstudianteReporte">
                <option value="" selected>Seleccione un estudiante</option>
                <option value="MariaRodriguez">María Rodríguez</option>
                <option value="DiegoVargas">Diego Vargas</option>
                <option value="AnaCastro">Ana Castro</option>
                <option value="KevinFernandez">Kevin Fernández</option>
                <option value="FabianMendez">Fabián Méndez</option>
                <option value="ValeriaMora">Valeria Mora</option>
                <option value="EmilyAraya">Emily Araya</option>
                <option value="FabianSolis">Fabián Solís</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="FiltroDesde" class="form-label">Desde</label>
              <input type="date" class="form-control" id="FiltroDesde" value="2026-06-01">
            </div>
            <div class="col-md-3">
              <label for="FiltroHasta" class="form-label">Hasta</label>
              <input type="date" class="form-control" id="FiltroHasta" value="2026-07-12">
            </div>
            <div class="col-md-1 text-end">
              <button type="button" class="btn btn-outline-primary w-100" id="BotonExportarPdf" title="Exportar PDF"
                data-bs-toggle="tooltip" disabled>
                <i class="bi bi-file-earmark-pdf"></i>
              </button>
            </div>
          </div>
          <div class="alert alert-warning d-none mt-3 mb-0" id="AvisoRangoInvalido">
            <i class="bi bi-exclamation-triangle me-1"></i>
            La fecha "Desde" no puede ser posterior a la fecha "Hasta".
          </div>
        </div>

        <!-- Estado vacío: ningún estudiante seleccionado -->
        <div class="EstadoVacio" id="ReporteSinSeleccion">
          <i class="bi bi-bar-chart-line"></i>
          <p class="mb-0">Seleccione un estudiante para generar el reporte.</p>
        </div>

        <div class="Tarjeta p-3 p-md-4 ReporteImprimible d-none" id="ContenidoReporte">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
              <h3 class="mb-1" id="ReporteNombreEstudiante"></h3>
              <p class="TextoSuave mb-0" id="ReporteDatosEstudiante"></p>
            </div>
            <button type="button" class="btn btn-primary NoImprimir" id="BotonExportarPdfPrincipal">
              <i class="bi bi-download me-1"></i>Exportar PDF
            </button>
          </div>

          <h6 class="mb-2">Sesiones en el período seleccionado</h6>
          <div class="table-responsive mb-3">
            <table class="table table-sm align-middle">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Tipo de atención</th>
                  <th>Tema trabajado</th>
                  <th>Avances</th>
                </tr>
              </thead>
              <tbody id="ReporteTablaSesiones"></tbody>
            </table>
          </div>
          <p class="TextoSuave small d-none" id="ReporteSinSesiones">
            Sin sesiones registradas para este estudiante en el rango de fechas seleccionado.
          </p>

          <h6 class="mb-2">Resumen de progreso</h6>
          <p class="mb-0" id="ReporteResumenProgreso"></p>
        </div>
      </main>

@section Scripts {
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var infoEstudiantes = {
        MariaRodriguez: {
          nombre: "María Rodríguez", nivel: "Primaria", institucion: "Escuela Buenaventura Corrales", encargado: "Carlos Jiménez",
          resumen: "María muestra avances constantes en comprensión lectora y mantiene una actitud motivada en cada sesión."
        },
        DiegoVargas: {
          nombre: "Diego Vargas", nivel: "Secundaria", institucion: "Liceo de Costa Rica", encargado: "Rodolfo Vargas",
          resumen: "Diego ha mejorado su capacidad de atención sostenida, aunque aún requiere apoyo en sesiones largas."
        },
        AnaCastro: {
          nombre: "Ana Castro", nivel: "Primaria", institucion: "Escuela República de Costa Rica", encargado: "Marjorie Castro",
          resumen: "Ana se encuentra en la etapa inicial de reconocimiento de lectoescritura, con buena disposición al trabajo."
        },
        KevinFernandez: {
          nombre: "Kevin Fernández", nivel: "Secundaria", institucion: "Colegio Técnico Don Bosco", encargado: "José Fernández",
          resumen: "La familia de Kevin implementó una rutina de estudio en casa que ha mostrado resultados positivos."
        },
        FabianMendez: { nombre: "Fabián Méndez", nivel: "Primaria", institucion: "Escuela Los Ángeles", encargado: "Laura Méndez", resumen: "" },
        ValeriaMora: {
          nombre: "Valeria Mora", nivel: "Primaria", institucion: "Escuela Roosevelt", encargado: "Marta Mora",
          resumen: "Valeria domina progresivamente las operaciones básicas y muestra seguridad al resolver ejercicios."
        },
        EmilyAraya: { nombre: "Emily Araya", nivel: "Secundaria", institucion: "Liceo Franco Costarricense", encargado: "Patricia Araya", resumen: "" },
        FabianSolis: { nombre: "Fabián Solís", nivel: "Primaria", institucion: "Escuela Ricardo Jiménez", encargado: "Óscar Solís", resumen: "" }
      };
      var sesionesReporte = [
        { estudiante: "MariaRodriguez", fecha: "2026-07-10", fechaTexto: "10 jul 2026", tipo: "Tutoría académica", tema: "Fracciones", avances: "Logró resolver problemas básicos de fracciones." },
        { estudiante: "MariaRodriguez", fecha: "2026-06-20", fechaTexto: "20 jun 2026", tipo: "Tutoría académica", tema: "Fracciones equivalentes", avances: "Identifica fracciones equivalentes con apoyo visual." },
        { estudiante: "DiegoVargas", fecha: "2026-07-08", fechaTexto: "8 jul 2026", tipo: "Sesión psicopedagógica", tema: "Atención sostenida", avances: "Mejoró el tiempo de concentración a 15 minutos." },
        { estudiante: "AnaCastro", fecha: "2026-07-05", fechaTexto: "5 jul 2026", tipo: "Evaluación", tema: "Lectoescritura inicial", avances: "Reconoce la mayoría de las vocales." },
        { estudiante: "ValeriaMora", fecha: "2026-07-01", fechaTexto: "1 jul 2026", tipo: "Tutoría académica", tema: "Multiplicación", avances: "Domina las tablas del 2 al 5." },
        { estudiante: "KevinFernandez", fecha: "2026-06-28", fechaTexto: "28 jun 2026", tipo: "Orientación a padres", tema: "Organización de horarios", avances: "La familia definió una rutina de estudio semanal." }
      ];
      var selectEstudiante = document.getElementById("FiltroEstudianteReporte");
      var campoDesde = document.getElementById("FiltroDesde");
      var campoHasta = document.getElementById("FiltroHasta");
      var estadoSinSeleccion = document.getElementById("ReporteSinSeleccion");
      var contenidoReporte = document.getElementById("ContenidoReporte");
      function ActualizarReporte() {
        var idEstudiante = selectEstudiante.value;
        var botonExportar = document.getElementById("BotonExportarPdf");
        var avisoRangoInvalido = document.getElementById("AvisoRangoInvalido");
        botonExportar.disabled = !idEstudiante;
        if (!idEstudiante) {
          estadoSinSeleccion.classList.remove("d-none");
          contenidoReporte.classList.add("d-none");
          avisoRangoInvalido.classList.add("d-none");
          return;
        }
        estadoSinSeleccion.classList.add("d-none");
        contenidoReporte.classList.remove("d-none");
        var info = infoEstudiantes[idEstudiante];
        document.getElementById("ReporteNombreEstudiante").textContent = info.nombre;
        document.getElementById("ReporteDatosEstudiante").textContent = info.nivel + " · " + info.institucion + " · Encargado: " + info.encargado;
        document.getElementById("ReporteResumenProgreso").textContent = info.resumen || "Aún no hay suficiente información para generar un resumen de progreso.";
        var desde = campoDesde.value;
        var hasta = campoHasta.value;
        if (desde && hasta && desde > hasta) {
          avisoRangoInvalido.classList.remove("d-none");
          document.getElementById("ReporteTablaSesiones").innerHTML = "";
          document.getElementById("ReporteSinSesiones").classList.add("d-none");
          return;
        }
        avisoRangoInvalido.classList.add("d-none");
        var sesiones = sesionesReporte.filter(function (sesion) {
          return sesion.estudiante === idEstudiante && (!desde || sesion.fecha >= desde) && (!hasta || sesion.fecha <= hasta);
        });
        sesiones.sort(function (a, b) { return b.fecha.localeCompare(a.fecha); });
        var cuerpoTabla = document.getElementById("ReporteTablaSesiones");
        cuerpoTabla.innerHTML = "";
        sesiones.forEach(function (sesion) {
          var fila = document.createElement("tr");
          fila.innerHTML =
            "<td></td><td></td><td></td><td></td>";
          fila.children[0].textContent = sesion.fechaTexto;
          fila.children[1].textContent = sesion.tipo;
          fila.children[2].textContent = sesion.tema;
          fila.children[3].textContent = sesion.avances;
          cuerpoTabla.appendChild(fila);
        });
        document.getElementById("ReporteSinSesiones").classList.toggle("d-none", sesiones.length !== 0);
      }
      selectEstudiante.addEventListener("change", ActualizarReporte);
      campoDesde.addEventListener("change", ActualizarReporte);
      campoHasta.addEventListener("change", ActualizarReporte);
      function ExportarPdf() {
        window.print();
      }
      document.getElementById("BotonExportarPdf").addEventListener("click", ExportarPdf);
      document.getElementById("BotonExportarPdfPrincipal").addEventListener("click", ExportarPdf);
    });
  </script>
}
