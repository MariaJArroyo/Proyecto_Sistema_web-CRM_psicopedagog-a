@model MenteActiva.Models.CatalogosSesionViewModel

@{
    ViewData["Title"] = "Sesiones";
    var hayCatalogos = Model.TiposSesion.Any() && Model.TiposAtencion.Any();
}

<main class="PrincipalAdmin">

  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
      <h2 class="mb-1">Seguimiento de sesiones</h2>
      <p class="TextoSuave mb-0" id="ResumenSesiones" aria-live="polite">&nbsp;</p>
    </div>
    <button type="button" class="btn btn-primary" id="BotonNuevaSesion"
            data-bs-toggle="modal" data-bs-target="#ModalNuevaSesion"
            @(hayCatalogos ? "" : "disabled")>
      <i class="bi bi-plus-lg me-1"></i>Registrar sesión
    </button>
  </div>

  @if (ViewBag.ErrorCarga is string errorCarga)
  {
    <div class="alert alert-warning">@errorCarga</div>
  }

  <div class="Tarjeta p-3 p-md-4">

    <!-- El estudiante se elige con el buscador, no con una lista fija de nombres -->
    <div class="row g-2 mb-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label">Estudiante</label>
        <div id="BuscadorEstudianteFiltro"></div>
      </div>
      <div class="col-md-3">
        <label for="FiltroDesde" class="form-label">Desde</label>
        <input type="date" class="form-control" id="FiltroDesde">
      </div>
      <div class="col-md-3">
        <label for="FiltroHasta" class="form-label">Hasta</label>
        <input type="date" class="form-control" id="FiltroHasta">
      </div>
      <div class="col-md-1">
        <button type="button" class="btn btn-outline-secondary w-100" id="BotonLimpiarFiltros"
                title="Limpiar filtros" aria-label="Limpiar filtros">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="TabHistorial" data-bs-toggle="tab"
                data-bs-target="#PanelHistorial" type="button" role="tab"
                aria-controls="PanelHistorial" aria-selected="true">
          Historial de sesiones
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="TabAvances" data-bs-toggle="tab"
                data-bs-target="#PanelAvances" type="button" role="tab"
                aria-controls="PanelAvances" aria-selected="false">
          Historial de avances
        </button>
      </li>
    </ul>

    <div class="tab-content">

      <div class="tab-pane fade show active" id="PanelHistorial" role="tabpanel"
           aria-labelledby="TabHistorial">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" id="TablaSesiones">
            <thead>
              <tr>
                <th>Fecha y hora</th>
                <th>Estudiante</th>
                <th>Tipo de sesión</th>
                <th>Atención</th>
                <th>Tema trabajado</th>
                <th class="TablaAcciones">Acciones</th>
              </tr>
            </thead>
            <tbody id="CuerpoTablaSesiones"></tbody>
          </table>
        </div>
      </div>

      <div class="tab-pane fade" id="PanelAvances" role="tabpanel" aria-labelledby="TabAvances">
        <p class="TextoSuave">
          Avances registrados en cada sesión, de la más reciente a la más antigua.
        </p>
        <div id="ListaAvances"></div>
      </div>

    </div>

    <div class="EstadoVacio d-none" id="VacioSesiones">
      <i class="bi bi-journal-text"></i>
      <p class="mb-0" id="TextoVacioSesiones">No hay sesiones registradas.</p>
    </div>

    <div class="alert d-none mt-3" id="AlertaSesiones" role="alert"></div>

  </div>
</main>

<div class="modal fade" id="ModalNuevaSesion" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <form id="FormularioNuevaSesion" novalidate>
        <div class="modal-header">
          <h5 class="modal-title">Registrar sesión</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">

          <div class="alert d-none" id="AlertaNuevaSesion" role="alert"></div>

          <div class="row g-3">

            <div class="col-md-6">
              <label class="form-label CampoObligatorio">Estudiante</label>
              <div id="BuscadorEstudianteSesion"></div>
            </div>

            <div class="col-md-6">
              <label for="CitaOrigenSesion" class="form-label">Cita de origen</label>
              <select class="form-select" id="CitaOrigenSesion" name="IdCita" disabled>
                <option value="">Sin cita (sesión suelta)</option>
              </select>
              <div class="form-text">
                Si la sesión nace de una cita, al elegirla se llenan la fecha, la hora,
                la duración y el tipo de sesión.
              </div>
            </div>

            <div class="col-md-4">
              <label for="FechaHoraNuevaSesion" class="form-label CampoObligatorio">Fecha y hora</label>
              <input type="datetime-local" class="form-control" id="FechaHoraNuevaSesion"
                     name="FechaHoraInicio">
              <div class="invalid-feedback">Indique la fecha y la hora de la sesión.</div>
            </div>

            <div class="col-md-2">
              <label for="DuracionNuevaSesion" class="form-label CampoObligatorio">Duración</label>
              <div class="input-group">
                <input type="number" class="form-control" id="DuracionNuevaSesion"
                       name="DuracionMinutos" min="15" max="240" step="5" value="60">
                <span class="input-group-text">min</span>
              </div>
              <div class="invalid-feedback">Entre 15 y 240 minutos.</div>
            </div>

            <div class="col-md-3">
              <label for="TipoSesionNuevaSesion" class="form-label CampoObligatorio">Tipo de sesión</label>
              <select class="form-select" id="TipoSesionNuevaSesion" name="IdTipoSesion">
                <option value="">Seleccione</option>
                @foreach (var tipo in Model.TiposSesion)
                {
                  <option value="@tipo.IdTipoSesion" data-duracion="@tipo.DuracionMinutos">@tipo.Nombre</option>
                }
              </select>
              <div class="invalid-feedback">Seleccione el tipo de sesión.</div>
            </div>

            <div class="col-md-3">
              <label for="TipoAtencionNuevaSesion" class="form-label CampoObligatorio">Atención</label>
              <select class="form-select" id="TipoAtencionNuevaSesion" name="IdTipoAtencion">
                <option value="">Seleccione</option>
                @foreach (var tipo in Model.TiposAtencion)
                {
                  <option value="@tipo.IdTipoAtencion">@tipo.Nombre</option>
                }
              </select>
              <div class="invalid-feedback">Seleccione el tipo de atención.</div>
            </div>

            <div class="col-12">
              <label for="ObjetivoNuevaSesion" class="form-label CampoObligatorio">Objetivo de la sesión</label>
              <input type="text" class="form-control" id="ObjetivoNuevaSesion" name="Objetivo"
                     maxlength="500" placeholder="Ej. Reforzar la comprensión lectora inferencial">
              <div class="invalid-feedback">Indique el objetivo de la sesión.</div>
            </div>

            <div class="col-12">
              <label for="TemaNuevaSesion" class="form-label CampoObligatorio">Tema trabajado</label>
              <input type="text" class="form-control" id="TemaNuevaSesion" name="TemaTrabajado"
                     maxlength="500" placeholder="Ej. Inferencias en textos cortos">
              <div class="invalid-feedback">Indique el tema trabajado.</div>
            </div>

            <div class="col-md-6">
              <label for="ActividadesNuevaSesion" class="form-label">Actividades realizadas</label>
              <textarea class="form-control" id="ActividadesNuevaSesion" name="ActividadesRealizadas"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="AcuerdosNuevaSesion" class="form-label">Acuerdos</label>
              <textarea class="form-control" id="AcuerdosNuevaSesion" name="Acuerdos"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-12"><hr class="my-1"></div>

            <div class="col-md-6">
              <label for="ObjetivosAlcanzadosNuevaSesion" class="form-label">Objetivos alcanzados</label>
              <textarea class="form-control" id="ObjetivosAlcanzadosNuevaSesion"
                        name="ObjetivosAlcanzados" rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="HabilidadesNuevaSesion" class="form-label">Habilidades desarrolladas</label>
              <textarea class="form-control" id="HabilidadesNuevaSesion"
                        name="HabilidadesDesarrolladas" rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="AvancesNuevaSesion" class="form-label">Avances</label>
              <textarea class="form-control" id="AvancesNuevaSesion" name="Avances"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="RecomendacionesNuevaSesion" class="form-label">Recomendaciones</label>
              <textarea class="form-control" id="RecomendacionesNuevaSesion" name="Recomendaciones"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-12">
              <label for="ObservacionesNuevaSesion" class="form-label">Observaciones</label>
              <textarea class="form-control" id="ObservacionesNuevaSesion" name="Observaciones"
                        rows="2" maxlength="1000"></textarea>
            </div>

          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar sesión</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="ModalDetalleSesion" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Detalle de la sesión</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-secondary d-none" id="DetalleSesionInactiva">
          Esta sesión está inactiva. Se conserva en el historial, pero no aparece en los listados.
        </div>
        <dl class="row mb-0" id="DetalleSesionCampos"></dl>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="ModalEditarSesion" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <form id="FormularioEditarSesion" novalidate>
        <div class="modal-header">
          <h5 class="modal-title">Editar sesión</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">

          <div class="alert d-none" id="AlertaEditarSesion" role="alert"></div>

          <p class="TextoSuave" id="EditarSesionEstudiante"></p>

          <div class="row g-3">

            <div class="col-md-4">
              <label for="EditarFechaHoraSesion" class="form-label CampoObligatorio">Fecha y hora</label>
              <input type="datetime-local" class="form-control" id="EditarFechaHoraSesion"
                     name="FechaHoraInicio">
              <div class="invalid-feedback">Indique la fecha y la hora de la sesión.</div>
            </div>

            <div class="col-md-2">
              <label for="EditarDuracionSesion" class="form-label CampoObligatorio">Duración</label>
              <div class="input-group">
                <input type="number" class="form-control" id="EditarDuracionSesion"
                       name="DuracionMinutos" min="15" max="240" step="5">
                <span class="input-group-text">min</span>
              </div>
              <div class="invalid-feedback">Entre 15 y 240 minutos.</div>
            </div>

            <div class="col-md-3">
              <label for="EditarTipoSesionSesion" class="form-label CampoObligatorio">Tipo de sesión</label>
              <select class="form-select" id="EditarTipoSesionSesion" name="IdTipoSesion">
                <option value="">Seleccione</option>
                @foreach (var tipo in Model.TiposSesion)
                {
                  <option value="@tipo.IdTipoSesion">@tipo.Nombre</option>
                }
              </select>
              <div class="invalid-feedback">Seleccione el tipo de sesión.</div>
            </div>

            <div class="col-md-3">
              <label for="EditarTipoAtencionSesion" class="form-label CampoObligatorio">Atención</label>
              <select class="form-select" id="EditarTipoAtencionSesion" name="IdTipoAtencion">
                <option value="">Seleccione</option>
                @foreach (var tipo in Model.TiposAtencion)
                {
                  <option value="@tipo.IdTipoAtencion">@tipo.Nombre</option>
                }
              </select>
              <div class="invalid-feedback">Seleccione el tipo de atención.</div>
            </div>

            <div class="col-12">
              <label for="EditarObjetivoSesion" class="form-label CampoObligatorio">Objetivo de la sesión</label>
              <input type="text" class="form-control" id="EditarObjetivoSesion" name="Objetivo"
                     maxlength="500">
              <div class="invalid-feedback">Indique el objetivo de la sesión.</div>
            </div>

            <div class="col-12">
              <label for="EditarTemaSesion" class="form-label CampoObligatorio">Tema trabajado</label>
              <input type="text" class="form-control" id="EditarTemaSesion" name="TemaTrabajado"
                     maxlength="500">
              <div class="invalid-feedback">Indique el tema trabajado.</div>
            </div>

            <div class="col-md-6">
              <label for="EditarActividadesSesion" class="form-label">Actividades realizadas</label>
              <textarea class="form-control" id="EditarActividadesSesion" name="ActividadesRealizadas"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="EditarAcuerdosSesion" class="form-label">Acuerdos</label>
              <textarea class="form-control" id="EditarAcuerdosSesion" name="Acuerdos"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-12"><hr class="my-1"></div>

            <div class="col-md-6">
              <label for="EditarObjetivosAlcanzadosSesion" class="form-label">Objetivos alcanzados</label>
              <textarea class="form-control" id="EditarObjetivosAlcanzadosSesion"
                        name="ObjetivosAlcanzados" rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="EditarHabilidadesSesion" class="form-label">Habilidades desarrolladas</label>
              <textarea class="form-control" id="EditarHabilidadesSesion"
                        name="HabilidadesDesarrolladas" rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="EditarAvancesSesion" class="form-label">Avances</label>
              <textarea class="form-control" id="EditarAvancesSesion" name="Avances"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-md-6">
              <label for="EditarRecomendacionesSesion" class="form-label">Recomendaciones</label>
              <textarea class="form-control" id="EditarRecomendacionesSesion" name="Recomendaciones"
                        rows="2" maxlength="1000"></textarea>
            </div>

            <div class="col-12">
              <label for="EditarObservacionesSesion" class="form-label">Observaciones</label>
              <textarea class="form-control" id="EditarObservacionesSesion" name="Observaciones"
                        rows="2" maxlength="1000"></textarea>
            </div>

          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- No dice "Eliminar": la sesion nunca se borra, se marca inactiva (HU-M5-3) -->
<div class="modal fade" id="ModalInactivarSesion" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Inactivar sesión</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="alert d-none" id="AlertaInactivarSesion" role="alert"></div>
        <p class="mb-2">
          ¿Seguro que desea inactivar la sesión de
          <strong id="NombreSesionInactivar"></strong>?
        </p>
        <p class="TextoSuave mb-0">
          La sesión deja de aparecer en el historial y en el portal del encargado,
          pero no se borra: su información se conserva.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="BotonConfirmarInactivarSesion">Inactivar</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/buscadorEstudiantes.js" asp-append-version="true"></script>
  <script src="~/js/sesiones.js" asp-append-version="true"></script>
}
