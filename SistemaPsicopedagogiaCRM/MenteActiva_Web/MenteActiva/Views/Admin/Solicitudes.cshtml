@model List<MenteActiva.Models.SolicitudViewModel>

@{
    ViewData["Title"] = "Solicitudes";
}

<main class="PrincipalAdmin">

    <div class="mb-4">
        <h2 class="mb-1">Solicitudes de contacto</h2>
        <p class="TextoSuave mb-0">
            Mensajes recibidos desde el formulario del sitio web. Conviértalos en clientes cuando corresponda.
        </p>
    </div>

    <div class="Tarjeta p-3 p-md-4">

        <div class="row g-2 mb-3">

            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" data-buscar-texto
                           placeholder="Buscar por nombre, teléfono o correo">
                </div>
            </div>

            <div class="col-md-5">
                <select class="form-select" data-buscar-estado aria-label="Filtrar por estado">
                    <option value="">Todos los estados</option>
                    @if (ViewBag.EstadosSolicitud != null)
                    {
                        foreach (var estado in ViewBag.EstadosSolicitud)
                        {
                            if (estado.Nombre == "Pendiente")
                            {
                                <option value="@estado.Nombre" selected>@estado.Nombre</option>
                            }
                            else
                            {
                                <option value="@estado.Nombre">@estado.Nombre</option>
                            }
                        }
                    }
                </select>
            </div>

        </div>

        <div class="table-responsive">

            <table class="table align-middle mb-0" id="TablaSolicitudes">

                <thead>
                    <tr>
                        <th>Recibida</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Servicio de interés</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var s in Model)
                    {
                        var claseEstado = s.IdEstadoSolicitud switch
                        {
                            1 => "badge-solicitud-pendiente",
                            2 => "badge-solicitud-contactada",
                            3 => "badge-solicitud-convertida",
                            4 => "badge-solicitud-descartada",
                            _ => ""
                        };

                        <tr data-fila data-estado="@s.Estado" class="@(s.IdEstadoSolicitud == 1 ? "fw-semibold" : "")">

                            <td class="text-nowrap">@s.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@s.NombreCompleto</td>
                            <td>@s.Telefono</td>
                            <td>@s.Correo</td>
                            <td>@(s.Servicio ?? "-")</td>
                            <td><span class="badge @claseEstado">@s.Estado</span></td>

                            <td class="TablaAcciones text-nowrap">

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary border-0"
                                        data-accion="ver"
                                        data-id="@s.IdSolicitud"
                                        data-bs-toggle="tooltip"
                                        title="Ver solicitud">
                                    <i class="bi bi-eye"></i>
                                </button>

                                @if (s.IdEstadoSolicitud != 3)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success border-0"
                                            data-accion="convertir"
                                            data-id="@s.IdSolicitud"
                                            data-bs-toggle="tooltip"
                                            title="Convertir a cliente">
                                        <i class="bi bi-person-plus"></i>
                                    </button>
                                }

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div id="EstadoVacio" class="text-center py-4" style="display:@(Model.Any() ? "none" : "block");">
            <i class="bi bi-inbox fs-2 TextoSuave"></i>
            <p class="TextoSuave mt-2 mb-0">Todavía no han llegado solicitudes.</p>
        </div>

        <div id="SinResultados" class="text-center py-4" style="display:none;">
            <p class="TextoSuave mb-0">No hay solicitudes que coincidan con el filtro.</p>
        </div>

    </div>

</main>


<!-- ========================================================= -->
<!-- MODAL DETALLE DE SOLICITUD -->
<!-- ========================================================= -->

<div class="modal fade" id="ModalDetalleSolicitud" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0">
                        <span id="SolicitudNombre">-</span>
                        <span class="badge align-middle ms-2" id="SolicitudEstado">-</span>
                    </h5>
                    <small class="TextoSuave">Recibida el <span id="SolicitudFecha">-</span></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <div class="alert d-none" id="SolicitudMensaje" role="alert"></div>

                <!-- Ya convertida -->
                <div class="alert alert-success d-none" id="SolicitudVinculada"></div>

                <!-- Posibles duplicados -->
                <div class="alert alert-warning d-none" id="SolicitudCoincidencias">
                    <div class="fw-semibold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Ya existe un cliente con este teléfono o correo
                    </div>
                    <p class="small mb-2">
                        Puede vincular la solicitud a ese cliente (el mensaje se agrega a sus observaciones)
                        o crear un cliente nuevo de todas formas.
                    </p>
                    <div class="list-group" id="ListaCoincidencias"></div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="TextoSuave small">Teléfono</div>
                        <a id="SolicitudTelefono" href="#">-</a>
                    </div>
                    <div class="col-md-4">
                        <div class="TextoSuave small">Correo</div>
                        <a id="SolicitudCorreo" href="#" class="text-break">-</a>
                    </div>
                    <div class="col-md-4">
                        <div class="TextoSuave small">Servicio de interés</div>
                        <div id="SolicitudServicio">-</div>
                    </div>
                </div>

                <div class="TextoSuave small mb-1">Mensaje</div>
                <div class="border rounded-3 p-3 bg-light mb-3" id="SolicitudTexto" style="white-space:pre-line;">-</div>

                <label for="SolicitudNota" class="form-label small TextoSuave mb-1">Nota interna</label>
                <textarea class="form-control" id="SolicitudNota" rows="2" maxlength="1000"
                          placeholder="Ej.: Se llamó el martes, pidió información de precios."></textarea>

                <p class="small TextoSuave mt-2 mb-0 d-none" id="SolicitudAtencion"></p>

            </div>

            <div class="modal-footer justify-content-between">

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger" id="BotonDescartarSolicitud">
                        <i class="bi bi-x-circle me-1"></i>Descartar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="BotonPendienteSolicitud">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Volver a pendiente
                    </button>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="BotonGuardarNota">Guardar nota</button>
                    <button type="button" class="btn btn-outline-primary" id="BotonContactadaSolicitud">
                        <i class="bi bi-telephone-outbound me-1"></i>Marcar contactada
                    </button>
                    <button type="button" class="btn btn-success" id="BotonConvertirSolicitud">
                        <i class="bi bi-person-plus me-1"></i>Convertir a cliente
                    </button>
                </div>

            </div>

        </div>
    </div>

</div>


<partial name="_ModalNuevoCliente" />


@section Scripts {
    <script src="~/js/nuevoCliente.js"></script>
    <script src="~/js/solicitudes.js"></script>
}