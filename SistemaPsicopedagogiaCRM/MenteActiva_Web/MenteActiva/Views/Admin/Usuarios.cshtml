@model IEnumerable<MenteActiva.Models.UsuarioViewModel>
@{
    ViewData["Title"] = "Usuarios internos";
 
    // Los roles son fijos y no se configuran en caliente; Encargado no va aqui
    // porque esas cuentas se crean desde "Usuarios externos"
    var roles = new Dictionary<int, string>
    {
        [1] = "Administrador",
        [2] = "Psicopedagoga",
        [3] = "Asistente"
    };
 
    // Para no ofrecerle al administrador que se desactive a si mismo: el API
    // tambien lo rechaza, pero es mejor no mostrar el boton
    var idUsuarioActual = int.Parse(
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
 
    // Siempre debe quedar al menos un administrador activo: si hay uno solo,
    // su rol se muestra fijo (los SPs tambien lo validan)
    var administradoresActivos = Model.Count(u => u.Rol == "Administrador" && u.Estado == "Activo");
 
    bool RolBloqueado(UsuarioViewModel u)
        => u.Rol == "Administrador" && u.Estado == "Activo" && administradoresActivos == 1;
 
    string ClaseInsignia(string estado) => estado switch
    {
        "Activo" => "badge-estado-activo",
        "Pendiente de activación" => "badge-estado-nuevo",
        "Bloqueado" => "badge-estado-contactado",
        _ => "badge-estado-inactivo"
    };
}
 
      <main class="PrincipalAdmin">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
          <div>
            <h2 class="mb-1">Usuarios internos</h2>
            <p class="TextoSuave mb-0">
              Cuentas del personal que puede ingresar al panel administrativo. No confundir con
              "Clientes": esos son los contactos/leads del consultorio, no cuentas de acceso.
            </p>
          </div>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ModalNuevoUsuario">
            <i class="bi bi-plus-lg me-1"></i>Nuevo usuario
          </button>
        </div>
 
        @if (TempData["Mensaje"] is string aviso)
        {
          <div class="alert alert-success" role="alert">@aviso</div>
        }
        @if (TempData["Error"] is string problema)
        {
          <div class="alert alert-danger" role="alert">@problema</div>
        }
 
        <div class="Tarjeta p-3 p-md-4">
 
          <div class="row g-2 mb-3" data-tabla-buscador="TablaUsuarios" data-tabla-paginar="10">
            <div class="col-md-7">
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" data-buscar-texto placeholder="Buscar por nombre o correo">
              </div>
            </div>
            <div class="col-md-5">
              <select class="form-select" data-buscar-estado aria-label="Filtrar por estado">
                @* Los mismos textos que devuelve la base: el filtro compara
                   contra data-estado, asi que si no coinciden no filtra nada *@
                <option value="">Todos los estados</option>
                <option value="Activo" selected>Activo</option>
                <option value="Pendiente de activación">Pendiente de activación</option>
                <option value="Bloqueado">Bloqueado</option>
                <option value="Inactivo">Inactivo</option>
              </select>
            </div>
          </div>
 
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaUsuarios">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Correo</th>
                  <th>Rol</th>
                  <th>Estado</th>
                  <th class="TablaAcciones">Acciones</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var usuario in Model)
                {
                <tr data-fila data-estado="@usuario.Estado" data-valor-nombre="@usuario.NombreCompleto"
                  data-valor-correo="@usuario.Correo" data-valor-rol="@usuario.Rol"
                  data-id-usuario="@usuario.IdUsuario"
                  data-rol-bloqueado="@(RolBloqueado(usuario) ? "true" : "false")"
                  data-id-rol="@(roles.FirstOrDefault(r => r.Value == usuario.Rol).Key)">
                 <td>
                    <span data-campo="nombre">@usuario.NombreCompleto</span>
                    @if (usuario.IdUsuario == idUsuarioActual)
                    {
                      <span class="ChipEstado chip-cuenta-propia ms-2">
                        <i class="bi bi-person-check" aria-hidden="true"></i>Su cuenta
                      </span>
                    }
                  </td>
 
                  <td data-campo="correo">@usuario.Correo</td>
                  <td data-campo="rol">
                    @if (RolBloqueado(usuario))
                    {
                      @* Unico administrador activo: su rol no se puede cambiar *@
                      <span class="d-inline-flex align-items-center gap-1" title="Es el único administrador activo">
                        <i class="bi bi-lock TextoSuave" aria-hidden="true"></i>@usuario.Rol
                      </span>
                    }
                    else
                    {
                      <form asp-controller="Admin" asp-action="AsignarRol" method="post"
                        class="d-flex align-items-center gap-1">
                        <input type="hidden" name="idUsuario" value="@usuario.IdUsuario">
                        <select name="idRol" class="form-select form-select-sm" aria-label="Rol de @usuario.NombreCompleto">
                          @foreach (var rol in roles)
                          {
                            <option value="@rol.Key" selected="@(usuario.Rol == rol.Value)">@rol.Value</option>
                          }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip"
                          title="Guardar rol"><i class="bi bi-check-lg"></i></button>
                      </form>
                    }
                  </td>
                  <td><span class="badge @ClaseInsignia(usuario.Estado)" data-campo-badge="estado">@usuario.Estado</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-accion="editar"
                      data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></button>
 
                    @if (usuario.Estado != "Inactivo")
                    {
                      <form asp-controller="Admin" asp-action="ReenviarInvitacion" method="post" class="d-inline">
                        <input type="hidden" name="idUsuario" value="@usuario.IdUsuario">
                        <button type="submit" class="btn btn-sm btn-outline-secondary border-0"
                          data-bs-toggle="tooltip"
                          title="@(usuario.Estado == "Pendiente de activación" ? "Reenviar invitación" : "Enviar enlace para restablecer la contraseña")">
                          <i class="bi bi-envelope"></i>
                        </button>
                      </form>
                    }
 
                                       @* Su propia cuenta no se puede activar ni desactivar: no se muestran esos botones *@
                    @if (usuario.IdUsuario != idUsuarioActual)
                    {
                      if (usuario.Estado == "Inactivo")
                      {
                        <form asp-controller="Admin" asp-action="CambiarEstadoUsuario" method="post" class="d-inline">
                          <input type="hidden" name="idUsuario" value="@usuario.IdUsuario">
                          <input type="hidden" name="idEstadoUsuario" value="1">
                          <button type="submit" class="btn btn-sm btn-outline-primary border-0" data-bs-toggle="tooltip"
                            title="Activar"><i class="bi bi-person-check"></i></button>
                        </form>
                      }
                      else
                      {
                        <button type="button" class="btn btn-sm btn-outline-danger border-0" data-accion="desactivar"
                          data-bs-toggle="tooltip" title="Desactivar"><i class="bi bi-person-x"></i></button>
                      }
                    }
 
                  </td>
                </tr>
                }
              </tbody>
            </table>
          </div>
 
          <!-- Estado vacío: sin resultados de búsqueda -->
          <div class="EstadoVacio d-none" data-tabla-vacio="TablaUsuarios">
            <i class="bi bi-people"></i>
            <p class="mb-3">No se encontraron usuarios con ese criterio de búsqueda.</p>
          </div>
        </div>
      </main>
      <!-- Razor: /fin de contenido de la vista -->
 
      <div class="modal fade" id="ModalNuevoUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <form asp-controller="Admin" asp-action="CrearUsuario" method="post" id="FormularioNuevoUsuario">
              <div class="modal-header">
                <h5 class="modal-title">Nuevo usuario interno</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <label for="NombreCompleto" class="form-label CampoObligatorio">Nombre completo</label>
                  <input type="text" class="form-control" id="NombreCompleto" name="NombreCompleto" required>
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-3">
                  <label for="Correo" class="form-label CampoObligatorio">Correo electrónico</label>
                  <input type="email" class="form-control" id="Correo" name="Correo" required>
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-1">
                  <label for="IdRol" class="form-label CampoObligatorio">Rol</label>
                  <select class="form-select" id="IdRol" name="IdRol" required>
                    <option value="" selected>Seleccione</option>
                    @foreach (var rol in roles)
                    {
                      <option value="@rol.Key">@rol.Value</option>
                    }
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
                <div class="form-text mt-2">
                  Se enviará un correo de invitación para que la persona defina su propia contraseña.
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Enviar invitación</button>
              </div>
            </form>
          </div>
        </div>
      </div>
 
      <div class="modal fade" id="ModalEditarUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <form asp-controller="Admin" asp-action="EditarUsuario" method="post"
              id="FormularioEditarUsuario" novalidate>
              <input type="hidden" name="IdUsuario" id="EditarIdUsuario">
              <div class="modal-header">
                <h5 class="modal-title">Editar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <label for="EditarNombreUsuario" class="form-label CampoObligatorio">Nombre completo</label>
                  <input type="text" class="form-control" id="EditarNombreUsuario" name="NombreCompleto" required>
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-3">
                  <label for="EditarCorreoUsuario" class="form-label CampoObligatorio">Correo electrónico</label>
                  <input type="email" class="form-control" id="EditarCorreoUsuario" name="Correo" required>
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-1">
                  <label for="EditarRolUsuario" class="form-label CampoObligatorio">Rol</label>
                  <select class="form-select" id="EditarRolUsuario" name="IdRol" required>
                    @foreach (var rol in roles)
                    {
                      <option value="@rol.Key">@rol.Value</option>
                    }
                  </select>
                  @* Un select deshabilitado no se envia: cuando el rol esta bloqueado viaja por este campo *@
                  <input type="hidden" name="IdRol" id="EditarRolFijo" disabled>
                  <div class="form-text d-none" id="AvisoRolBloqueado">
                    <i class="bi bi-lock me-1"></i>Es el único administrador activo: su rol no se puede cambiar.
                  </div>
                </div>
                <div class="form-text mt-2">
                  Si cambia el correo, los enlaces de invitación o de restablecimiento que estén
                  pendientes dejan de servir: se enviaron a la dirección anterior.
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
              </div>
            </form>
          </div>
        </div>
      </div>
 
      <div class="modal fade" id="ModalDesactivarUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Desactivar usuario</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <p class="mb-0">
                ¿Seguro que desea desactivar a <strong id="NombreUsuarioDesactivar"></strong>?
                Esta persona ya no podrá iniciar sesión en el panel.
              </p>
            </div>
            <form asp-controller="Admin" asp-action="CambiarEstadoUsuario" method="post">
              <input type="hidden" name="idUsuario" id="DesactivarIdUsuario">
              <input type="hidden" name="idEstadoUsuario" value="2">
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">
                  <i class="bi bi-person-x me-1"></i>Desactivar
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
 
@section Scripts {
  <script src="~/js/Validaciones.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var tabla = document.getElementById("TablaUsuarios");
      var instanciaEditar = bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalEditarUsuario"));
      var instanciaDesactivar = bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalDesactivarUsuario"));
      function TextoCampo(fila, campo) {
        return fila.querySelector('[data-campo="' + campo + '"]').textContent.trim();
      }
      // Los dos modales solo recogen datos y arman el formulario. Quien decide
      // y quien guarda es el servidor; aqui no se toca la fila ni se avisa de
      // nada que no haya pasado de verdad.
      tabla.addEventListener("click", function (evento) {
        var boton = evento.target.closest("[data-accion]");
        if (!boton) {
          return;
        }
        var fila = boton.closest("tr");
        var accion = boton.getAttribute("data-accion");
        if (accion === "editar") {
          document.getElementById("EditarIdUsuario").value = fila.getAttribute("data-id-usuario");
          document.getElementById("EditarNombreUsuario").value = fila.getAttribute("data-valor-nombre");
          document.getElementById("EditarCorreoUsuario").value = fila.getAttribute("data-valor-correo");
          var idRol = fila.getAttribute("data-id-rol");
          var rolBloqueado = fila.getAttribute("data-rol-bloqueado") === "true";
          var selectRol = document.getElementById("EditarRolUsuario");
          var rolFijo = document.getElementById("EditarRolFijo");
 
          selectRol.value = idRol;
          selectRol.disabled = rolBloqueado;
          rolFijo.value = idRol;
          rolFijo.disabled = !rolBloqueado;
          document.getElementById("AvisoRolBloqueado").classList.toggle("d-none", !rolBloqueado);
          instanciaEditar.show();
        } else if (accion === "desactivar") {
          document.getElementById("DesactivarIdUsuario").value = fila.getAttribute("data-id-usuario");
          document.getElementById("NombreUsuarioDesactivar").textContent = TextoCampo(fila, "nombre");
          instanciaDesactivar.show();
        }
      });
      // El envio lo hace el navegador contra Admin/CrearUsuario. Aqui solo se
      // valida: si algo esta mal se frena, y si esta bien se deja pasar. El
      // aviso de resultado llega del servidor por TempData, no se inventa aqui.
      document.getElementById("FormularioNuevoUsuario").addEventListener("submit", function (evento) {
        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("NombreCompleto"), "Ingrese el nombre completo.") && esValido;
        esValido = ValidarCorreo(document.getElementById("Correo")) && esValido;
        esValido = ValidarObligatorio(document.getElementById("IdRol"), "Seleccione un rol.") && esValido;
        if (!esValido) {
          evento.preventDefault();
        }
      });
      document.getElementById("FormularioEditarUsuario").addEventListener("submit", function (evento) {
        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("EditarNombreUsuario"), "Ingrese el nombre completo.") && esValido;
        esValido = ValidarCorreo(document.getElementById("EditarCorreoUsuario")) && esValido;
        if (!esValido) {
          evento.preventDefault();
        }
      });
    });
  </script>
}
 