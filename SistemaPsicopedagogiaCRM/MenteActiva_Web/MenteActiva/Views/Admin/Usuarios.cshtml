@{
    ViewData["Title"] = "Usuarios internos";
}

      <main class="PrincipalAdmin">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
          <div>
            <h2 class="mb-1">Usuarios internos</h2>
            <p class="TextoSuave mb-0">
              Cuentas del personal que puede ingresar al panel administrativo. No confundir con
              "Clientes": esos son los contactos/leads del consultorio, no cuentas de acceso.
            </p>
          </div>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ModalNuevoUsuario">
            <i class="bi bi-plus-lg me-1"></i>Nuevo usuario
          </button>
        </div>

        <div class="Tarjeta p-3 p-md-4">

          <div class="row g-2 mb-3" data-tabla-buscador="TablaUsuarios">
            <div class="col-md-7">
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" data-buscar-texto placeholder="Buscar por nombre o correo">
              </div>
            </div>
            <div class="col-md-5">
              <select class="form-select" data-buscar-estado aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
              </select>
            </div>
          </div>

          <!-- Razor: reemplazar por @@foreach (var usuario in Model.UsuariosInternos) -->
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaUsuarios">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Correo</th>
                  <th>Rol</th>
                  <th>Estado</th>
                  <th class="TablaAcciones">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <tr data-fila data-estado="Activo" data-valor-nombre="Marcela Solano"
                  data-valor-correo="marcela.solano@@menteactiva.cr" data-valor-rol="Administradora">
                  <td data-campo="nombre">Marcela Solano</td>
                  <td data-campo="correo">marcela.solano@@menteactiva.cr</td>
                  <td data-campo="rol">Administradora</td>
                  <td><span class="badge badge-estado-activo" data-campo-badge="estado">Activo</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-accion="editar"
                      data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" data-accion="desactivar"
                      data-bs-toggle="tooltip" title="Desactivar"><i class="bi bi-person-x"></i></button>
                  </td>
                </tr>
                <tr data-fila data-estado="Activo" data-valor-nombre="Diana Rojas"
                  data-valor-correo="diana.rojas@@menteactiva.cr" data-valor-rol="Asistente">
                  <td data-campo="nombre">Diana Rojas</td>
                  <td data-campo="correo">diana.rojas@@menteactiva.cr</td>
                  <td data-campo="rol">Asistente</td>
                  <td><span class="badge badge-estado-activo" data-campo-badge="estado">Activo</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0" data-accion="editar"
                      data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" data-accion="desactivar"
                      data-bs-toggle="tooltip" title="Desactivar"><i class="bi bi-person-x"></i></button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Estado vacío: sin resultados de búsqueda -->
          <div class="EstadoVacio d-none" data-tabla-vacio="TablaUsuarios">
            <i class="bi bi-people"></i>
            <p class="mb-3">No se encontraron usuarios con ese criterio de búsqueda.</p>
          </div>
        </div>
      </main>
      <!-- Razor: /fin de contenido de la vista -->

      <div class="modal fade" id="ModalNuevoUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <!-- Razor: asp-controller="Usuarios" asp-action="Crear" method="post" -->
            <form id="FormularioNuevoUsuario" novalidate>
              <div class="modal-header">
                <h5 class="modal-title">Nuevo usuario interno</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <label for="NombreUsuario" class="form-label CampoObligatorio">Nombre completo</label>
                  <input type="text" class="form-control" id="NombreUsuario">
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-3">
                  <label for="CorreoUsuario" class="form-label CampoObligatorio">Correo electrónico</label>
                  <input type="email" class="form-control" id="CorreoUsuario">
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-1">
                  <label for="RolUsuario" class="form-label CampoObligatorio">Rol</label>
                  <select class="form-select" id="RolUsuario">
                    <option value="" selected>Seleccione</option>
                    <option value="Administradora">Administradora</option>
                    <option value="Asistente">Asistente</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
                <div class="form-text mt-2">
                  Se enviará un correo de invitación para que la persona defina su propia contraseña.
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Enviar invitación</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="modal fade" id="ModalEditarUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <!-- Razor: asp-controller="Usuarios" asp-action="Editar" method="post" -->
            <form id="FormularioEditarUsuario" novalidate>
              <div class="modal-header">
                <h5 class="modal-title">Editar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <label for="EditarNombreUsuario" class="form-label CampoObligatorio">Nombre completo</label>
                  <input type="text" class="form-control" id="EditarNombreUsuario">
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-3">
                  <label for="EditarCorreoUsuario" class="form-label CampoObligatorio">Correo electrónico</label>
                  <input type="email" class="form-control" id="EditarCorreoUsuario">
                  <div class="invalid-feedback"></div>
                </div>
                <div class="mb-1">
                  <label for="EditarRolUsuario" class="form-label CampoObligatorio">Rol</label>
                  <select class="form-select" id="EditarRolUsuario">
                    <option value="Administradora">Administradora</option>
                    <option value="Asistente">Asistente</option>
                  </select>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="modal fade" id="ModalDesactivarUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Desactivar usuario</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <p class="mb-0">
                ¿Seguro que desea desactivar a <strong id="NombreUsuarioDesactivar"></strong>?
                Esta persona ya no podrá iniciar sesión en el panel.
              </p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="button" class="btn btn-danger" id="BotonConfirmarDesactivarUsuario">
                <i class="bi bi-person-x me-1"></i>Desactivar
              </button>
            </div>
          </div>
        </div>
      </div>

@section Scripts {
  <script src="~/js/Validaciones.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var tabla = document.getElementById("TablaUsuarios");
      var instanciaEditar = bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalEditarUsuario"));
      var instanciaDesactivar = bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalDesactivarUsuario"));
      var filaSeleccionada = null;
      function TextoCampo(fila, campo) {
        return fila.querySelector('[data-campo="' + campo + '"]').textContent.trim();
      }
      tabla.addEventListener("click", function (evento) {
        var boton = evento.target.closest("[data-accion]");
        if (!boton) {
          return;
        }
        filaSeleccionada = boton.closest("tr");
        var accion = boton.getAttribute("data-accion");
        if (accion === "editar") {
          document.getElementById("EditarNombreUsuario").value = TextoCampo(filaSeleccionada, "nombre");
          document.getElementById("EditarCorreoUsuario").value = TextoCampo(filaSeleccionada, "correo");
          document.getElementById("EditarRolUsuario").value = TextoCampo(filaSeleccionada, "rol");
          instanciaEditar.show();
        } else if (accion === "desactivar") {
          document.getElementById("NombreUsuarioDesactivar").textContent = TextoCampo(filaSeleccionada, "nombre");
          instanciaDesactivar.show();
        }
      });
      document.getElementById("FormularioNuevoUsuario").addEventListener("submit", function (evento) {
        evento.preventDefault();
        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("NombreUsuario"), "Ingrese el nombre completo.") && esValido;
        esValido = ValidarCorreo(document.getElementById("CorreoUsuario")) && esValido;
        esValido = ValidarObligatorio(document.getElementById("RolUsuario"), "Seleccione un rol.") && esValido;
        if (!esValido) {
          return;
        }
        evento.target.reset();
        evento.target.querySelectorAll(".is-valid").forEach(function (campo) { campo.classList.remove("is-valid"); });
        bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalNuevoUsuario")).hide();
        MostrarToast("Invitación enviada correctamente.");
      });
      document.getElementById("FormularioEditarUsuario").addEventListener("submit", function (evento) {
        evento.preventDefault();
        var esValido = true;
        esValido = ValidarObligatorio(document.getElementById("EditarNombreUsuario"), "Ingrese el nombre completo.") && esValido;
        esValido = ValidarCorreo(document.getElementById("EditarCorreoUsuario")) && esValido;
        if (!esValido || !filaSeleccionada) {
          return;
        }
        filaSeleccionada.querySelector('[data-campo="nombre"]').textContent = document.getElementById("EditarNombreUsuario").value;
        filaSeleccionada.querySelector('[data-campo="correo"]').textContent = document.getElementById("EditarCorreoUsuario").value;
        filaSeleccionada.querySelector('[data-campo="rol"]').textContent = document.getElementById("EditarRolUsuario").value;
        instanciaEditar.hide();
        MostrarToast("Usuario actualizado correctamente.");
      });
      document.getElementById("BotonConfirmarDesactivarUsuario").addEventListener("click", function () {
        if (!filaSeleccionada) {
          return;
        }
        var insignia = filaSeleccionada.querySelector('[data-campo-badge="estado"]');
        insignia.className = "badge badge-estado-inactivo";
        insignia.textContent = "Inactivo";
        filaSeleccionada.setAttribute("data-estado", "Inactivo");
        instanciaDesactivar.hide();
        MostrarToast("Usuario desactivado.", "error");
      });
    });
  </script>
}
