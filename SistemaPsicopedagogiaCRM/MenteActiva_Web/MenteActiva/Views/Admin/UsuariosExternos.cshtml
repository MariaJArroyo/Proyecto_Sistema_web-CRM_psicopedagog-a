        </a>
        <!-- Razor: asp-controller="Clientes" asp-action="Index" -->
        <a href="/Admin/Clientes" class="SidebarAdmin-Enlace">
          <i class="bi bi-person-lines-fill"></i><span>Clientes</span>
        </a>
        <!-- Razor: asp-controller="Estudiantes" asp-action="Index" -->
        <a href="/Admin/Estudiantes" class="SidebarAdmin-Enlace">
          <i class="bi bi-mortarboard"></i><span>Estudiantes</span>
        </a>
        <!-- Razor: asp-controller="Agenda" asp-action="Index" -->
        <a href="/Admin/Agenda" class="SidebarAdmin-Enlace">
          <i class="bi bi-calendar3"></i><span>Agenda</span>
        </a>
        <!-- Razor: asp-controller="Sesiones" asp-action="Index" -->
        <a href="/Admin/Sesiones" class="SidebarAdmin-Enlace">
          <i class="bi bi-journal-text"></i><span>Sesiones</span>
        </a>
        <!-- Razor: asp-controller="Planes" asp-action="Index" -->
        <a href="/Admin/Planes" class="SidebarAdmin-Enlace">
          <i class="bi bi-clipboard2-pulse"></i><span>Planes de intervención</span>
        </a>
        <!-- Razor: asp-controller="Reportes" asp-action="Index" -->
        <a href="/Admin/Reportes" class="SidebarAdmin-Enlace">
          <i class="bi bi-bar-chart-line"></i><span>Reportes</span>
        </a>
        <!-- Razor: asp-controller="Pagos" asp-action="Index" -->
        <a href="/Admin/Pagos" class="SidebarAdmin-Enlace">
          <i class="bi bi-cash-coin"></i><span>Pagos</span>
        </a>
        <!-- Razor: asp-controller="Comunicacion" asp-action="Index" -->
        <a href="/Admin/Comunicacion" class="SidebarAdmin-Enlace">
          <i class="bi bi-chat-dots"></i><span>Comunicación</span>
        </a>
        <!-- Razor: asp-controller="Materiales" asp-action="Index" -->
        <a href="/Admin/Materiales" class="SidebarAdmin-Enlace">
          <i class="bi bi-folder2-open"></i><span>Materiales</span>
        </a>
        <!-- Razor: asp-controller="Usuarios" asp-action="Index" -->
        <a href="/Admin/Usuarios" class="SidebarAdmin-Enlace">
          <i class="bi bi-people-fill"></i><span>Usuarios internos</span>
        </a>
        <!-- Razor: asp-controller="UsuariosExternos" asp-action="Index" -->
        <a href="/Admin/UsuariosExternos" class="SidebarAdmin-Enlace">
          <i class="bi bi-person-badge"></i><span>Usuarios externos</span>
        </a>
      </nav>
    </aside>


    <div class="ContenidoAdmin">


      <header class="TopbarAdmin">
        <div class="d-flex align-items-center gap-3">
          <button type="button" class="BotonSidebarToggle" aria-label="Abrir menú">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="TopbarAdmin-Titulo">Usuarios externos</h1>
        </div>
        <div class="dropdown">
          <button type="button" class="TopbarAdmin-Usuario" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="d-none d-sm-inline">Marcela Solano</span>
            <div class="TopbarAdmin-Avatar">MS</div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <!-- Razor: asp-controller="Cuenta" asp-action="MiPerfil" -->
            <li><a class="dropdown-item" href="/Admin/MiPerfil"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <!-- Razor: asp-controller="Cuenta" asp-action="CerrarSesion" -->
            <li><a class="dropdown-item" href="/Cuenta/Login"><i class="bi bi-box-arrow-left me-2"></i>Cerrar sesión</a>
            </li>
          </ul>
        </div>
      </header>

      <!-- Razor: inicio de contenido de la vista -->
      <main class="PrincipalAdmin">
        <div class="mb-4">
          <h2 class="mb-1">Usuarios externos</h2>
          <p class="TextoSuave mb-0">
            Acceso al Portal de familias para los encargados registrados en "Clientes". Invitar a un
            cliente crea su cuenta de acceso; esto es independiente de su información de contacto en el CRM.
          </p>
        </div>

        <div class="Tarjeta p-3 p-md-4">

          <div class="row g-2 mb-3" data-tabla-buscador="TablaUsuariosExternos">
            <div class="col-md-7">
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" data-buscar-texto placeholder="Buscar por nombre o correo">
              </div>
            </div>
            <div class="col-md-5">
              <select class="form-select" data-buscar-estado aria-label="Filtrar por estado de acceso">
                <option value="">Todos los estados</option>
                <option value="Activo">Activo</option>
                <option value="Invitado">Invitado</option>
                <option value="Sin invitar">Sin invitar</option>
                <option value="Suspendido">Suspendido</option>
              </select>
            </div>
          </div>

          <!-- Razor: reemplazar por @@foreach (var acceso in Model.AccesosPortal) -->
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaUsuariosExternos">
              <thead>
                <tr>
                  <th>Encargado</th>
                  <th>Correo</th>
                  <th>Estudiante(s)</th>
                  <th>Acceso al portal</th>
                  <th class="TablaAcciones">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <tr data-fila data-estado="Activo" data-correo="carlos.jimenez@@example.com">
                  <td>Carlos Jiménez</td>
                  <td>carlos.jimenez@@example.com</td>
                  <td>María Rodríguez, Andrés Jiménez</td>
                  <td><span class="badge badge-estado-activo" data-campo-badge="estado">Activo</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-accion="restablecer">Restablecer
                      contraseña</button>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                      data-accion="suspender">Suspender</button>
                  </td>
                </tr>
                <tr data-fila data-estado="Invitado" data-correo="rodolfo.vargas@@example.com">
                  <td>Rodolfo Vargas</td>
                  <td>rodolfo.vargas@@example.com</td>
                  <td>Diego Vargas</td>
                  <td><span class="badge badge-etiqueta-morado" data-campo-badge="estado">Invitado</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-accion="reenviar">Reenviar
                      invitación</button>
                  </td>
                </tr>
                <tr data-fila data-estado="Suspendido" data-correo="marta.mora@@example.com">
                  <td>Marta Mora</td>
                  <td>marta.mora@@example.com</td>
                  <td>Valeria Mora</td>
                  <td><span class="badge badge-etiqueta-rojo" data-campo-badge="estado">Suspendido</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-primary"
                      data-accion="reactivar">Reactivar</button>
                  </td>
                </tr>
                <tr data-fila data-estado="Sin invitar" data-correo="marjorie.castro@@example.com">
                  <td>Marjorie Castro</td>
                  <td>marjorie.castro@@example.com</td>
                  <td>Ana Castro</td>
                  <td><span class="badge badge-estado-nuevo" data-campo-badge="estado">Sin invitar</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-accion="invitar">Invitar al
                      portal</button>
                  </td>
                </tr>
                <tr data-fila data-estado="Sin invitar" data-correo="jose.fernandez@@example.com">
                  <td>José Fernández</td>
                  <td>jose.fernandez@@example.com</td>
                  <td>Kevin Fernández</td>
                  <td><span class="badge badge-estado-nuevo" data-campo-badge="estado">Sin invitar</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-accion="invitar">Invitar al
                      portal</button>
                  </td>
                </tr>
                <tr data-fila data-estado="Sin invitar" data-correo="laura.mendez@@example.com">
                  <td>Laura Méndez</td>
                  <td>laura.mendez@@example.com</td>
                  <td>Fabián Méndez</td>
                  <td><span class="badge badge-estado-nuevo" data-campo-badge="estado">Sin invitar</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-accion="invitar">Invitar al
                      portal</button>
                  </td>
                </tr>
                <tr data-fila data-estado="Sin invitar" data-correo="patricia.araya@@example.com">
                  <td>Patricia Araya</td>
                  <td>patricia.araya@@example.com</td>
                  <td>Emily Araya</td>
                  <td><span class="badge badge-estado-nuevo" data-campo-badge="estado">Sin invitar</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-accion="invitar">Invitar al
                      portal</button>
                  </td>
                </tr>
                <tr data-fila data-estado="Sin invitar" data-correo="oscar.solis@@example.com">
                  <td>Óscar Solís</td>
                  <td>oscar.solis@@example.com</td>
                  <td>Fabián Solís</td>
                  <td><span class="badge badge-estado-nuevo" data-campo-badge="estado">Sin invitar</span></td>
                  <td class="TablaAcciones">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-accion="invitar">Invitar al
                      portal</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <!-- /Razor -->

          <!-- Estado vacío: sin resultados de búsqueda -->
          <div class="EstadoVacio d-none" data-tabla-vacio="TablaUsuariosExternos">
            <i class="bi bi-person-badge"></i>
            <p class="mb-3">No se encontraron usuarios con ese criterio de búsqueda.</p>
          </div>
        </div>
      </main>
      <!-- Razor: /fin de contenido de la vista -->

      <div class="modal fade" id="ModalSuspenderAcceso" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Suspender acceso al portal</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <p class="mb-0">
                ¿Seguro que desea suspender el acceso al portal de <strong id="NombreSuspenderAcceso"></strong>?
                Esta persona no podrá iniciar sesión hasta que se reactive su cuenta.
              </p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="button" class="btn btn-danger" id="BotonConfirmarSuspenderAcceso">
                <i class="bi bi-slash-circle me-1"></i>Suspender
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="ContenedorToasts"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/Main.js"></script>
  <script src="~/js/Validaciones.js"></script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var tabla = document.getElementById("TablaUsuariosExternos");
      var instanciaSuspender = bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalSuspenderAcceso"));
      var filaSeleccionada = null;

      function ActualizarAccionesFila(fila, estado) {
        var celdaAcciones = fila.querySelector(".TablaAcciones");
        if (estado === "Activo") {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-secondary" data-accion="restablecer">Restablecer contraseña</button>' +
            '<button type="button" class="btn btn-sm btn-outline-danger" data-accion="suspender">Suspender</button>';
        } else if (estado === "Invitado") {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-secondary" data-accion="reenviar">Reenviar invitación</button>';
        } else if (estado === "Suspendido") {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-primary" data-accion="reactivar">Reactivar</button>';
        } else {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-primary" data-accion="invitar">Invitar al portal</button>';
        }
      }

      var mapaBadgeAcceso = {
        Activo: "badge-estado-activo",
        Invitado: "badge-etiqueta-morado",
        Suspendido: "badge-etiqueta-rojo",
        "Sin invitar": "badge-estado-nuevo"
      };

      function CambiarEstadoAcceso(fila, nuevoEstado) {
        var insignia = fila.querySelector('[data-campo-badge="estado"]');
        insignia.className = "badge " + mapaBadgeAcceso[nuevoEstado];
        insignia.textContent = nuevoEstado;
        fila.setAttribute("data-estado", nuevoEstado);
        ActualizarAccionesFila(fila, nuevoEstado);
      }

      tabla.addEventListener("click", function (evento) {
        var boton = evento.target.closest("[data-accion]");
        if (!boton) {
          return;
        }
        filaSeleccionada = boton.closest("tr");
        var accion = boton.getAttribute("data-accion");
        var correo = filaSeleccionada.getAttribute("data-correo");
        var nombre = filaSeleccionada.querySelector("td").textContent.trim();

        if (accion === "invitar") {
          CambiarEstadoAcceso(filaSeleccionada, "Invitado");
          MostrarToast("Invitación enviada a " + correo + ".");
        } else if (accion === "reenviar") {
          MostrarToast("Invitación reenviada a " + correo + ".");
        } else if (accion === "restablecer") {
          MostrarToast("Se envió un enlace para restablecer la contraseña a " + correo + ".");
        } else if (accion === "reactivar") {
          CambiarEstadoAcceso(filaSeleccionada, "Activo");
          MostrarToast("Acceso reactivado para " + correo + ".");
        } else if (accion === "suspender") {
          document.getElementById("NombreSuspenderAcceso").textContent = nombre;
          instanciaSuspender.show();
        }
      });

      document.getElementById("BotonConfirmarSuspenderAcceso").addEventListener("click", function () {
        if (!filaSeleccionada) {
          return;
        }
        CambiarEstadoAcceso(filaSeleccionada, "Suspendido");
        instanciaSuspender.hide();
        MostrarToast("Acceso suspendido.", "error");
      });
    });
  </script>
</body>

</html>