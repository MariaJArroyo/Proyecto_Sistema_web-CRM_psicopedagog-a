@model IEnumerable<MenteActiva.Models.UsuarioExternoViewModel>
@{
    ViewData["Title"] = "Usuarios externos";

    string ClaseInsignia(string estado) => estado switch
    {
        "Activo" => "badge-estado-activo",
        "Pendiente de activación" => "badge-estado-nuevo",
        "Sin invitar" => "badge-estado-contactado",
        _ => "badge-estado-inactivo"
    };
}

      <main class="PrincipalAdmin">
        <div class="mb-4">
          <h2 class="mb-1">Usuarios externos</h2>
          <p class="TextoSuave mb-0">
            Acceso al Portal de familias para los encargados registrados en "Clientes". Invitar a un
            cliente crea su cuenta de acceso; esto es independiente de su información de contacto en el CRM.
          </p>
        </div>

        <div class="Tarjeta p-3 p-md-4">

          <div class="row g-2 mb-3" data-tabla-buscador="TablaUsuariosExternos">
            <div class="col-md-7">
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" data-buscar-texto placeholder="Buscar por nombre o correo">
              </div>
            </div>
            <div class="col-md-5">
              <select class="form-select" data-buscar-estado aria-label="Filtrar por estado de acceso">
                <option value="">Todos los estados</option>
                <option value="Activo">Activo</option>
                <option value="Invitado">Invitado</option>
                <option value="Sin invitar">Sin invitar</option>
                <option value="Suspendido">Suspendido</option>
              </select>
            </div>
          </div>

          @if (TempData["Mensaje"] is string aviso)
          {
            <div class="alert alert-success" role="alert">@aviso</div>
          }
          @if (TempData["Error"] is string problema)
          {
            <div class="alert alert-danger" role="alert">@problema</div>
          }

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="TablaUsuariosExternos">
              <thead>
                <tr>
                  <th>Encargado</th>
                  <th>Correo</th>
                  <th>Estudiante(s)</th>
                  <th>Acceso al portal</th>
                  <th class="TablaAcciones">Acciones</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var acceso in Model)
                {
                <tr data-fila data-estado="@acceso.Estado" data-correo="@acceso.Correo">
                  <td>@acceso.Encargado</td>
                  <td>@(acceso.Correo ?? "—")</td>
                  <td>@(acceso.Estudiante ?? "—")</td>
                  <td><span class="badge @ClaseInsignia(acceso.Estado)" data-campo-badge="estado">@acceso.Estado</span></td>
                  <td class="TablaAcciones">
                    @if (acceso.SePuedeInvitar)
                    {
                      <form asp-controller="Admin" asp-action="InvitarEncargado" method="post" class="d-inline">
                        <input type="hidden" name="idEncargado" value="@acceso.IdEncargado">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Invitar al portal</button>
                      </form>
                    }
                    else if (acceso.IdUsuario is null)
                    {
                      <span class="TextoSuave small">Falta el correo del encargado</span>
                    }
                    else
                    {
                      <button type="button" class="btn btn-sm btn-outline-secondary" data-accion="restablecer">Restablecer
                        contraseña</button>
                      <button type="button" class="btn btn-sm btn-outline-danger"
                        data-accion="suspender">Suspender</button>
                    }
                  </td>
                </tr>
                }
              </tbody>
            </table>
          </div>
          <!-- /Razor -->

          <!-- Estado vacío: sin resultados de búsqueda -->
          <div class="EstadoVacio d-none" data-tabla-vacio="TablaUsuariosExternos">
            <i class="bi bi-person-badge"></i>
            <p class="mb-3">No se encontraron usuarios con ese criterio de búsqueda.</p>
          </div>
        </div>
      </main>
      <!-- Razor: /fin de contenido de la vista -->

      <div class="modal fade" id="ModalSuspenderAcceso" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Suspender acceso al portal</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <p class="mb-0">
                ¿Seguro que desea suspender el acceso al portal de <strong id="NombreSuspenderAcceso"></strong>?
                Esta persona no podrá iniciar sesión hasta que se reactive su cuenta.
              </p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="button" class="btn btn-danger" id="BotonConfirmarSuspenderAcceso">
                <i class="bi bi-slash-circle me-1"></i>Suspender
              </button>
            </div>
          </div>
        </div>
      </div>

@section Scripts {
  <script src="~/js/Validaciones.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var tabla = document.getElementById("TablaUsuariosExternos");
      var instanciaSuspender = bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalSuspenderAcceso"));
      var filaSeleccionada = null;
      function ActualizarAccionesFila(fila, estado) {
        var celdaAcciones = fila.querySelector(".TablaAcciones");
        if (estado === "Activo") {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-secondary" data-accion="restablecer">Restablecer contraseña</button>' +
            '<button type="button" class="btn btn-sm btn-outline-danger" data-accion="suspender">Suspender</button>';
        } else if (estado === "Invitado") {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-secondary" data-accion="reenviar">Reenviar invitación</button>';
        } else if (estado === "Suspendido") {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-primary" data-accion="reactivar">Reactivar</button>';
        } else {
          celdaAcciones.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-primary" data-accion="invitar">Invitar al portal</button>';
        }
      }
      var mapaBadgeAcceso = {
        Activo: "badge-estado-activo",
        Invitado: "badge-etiqueta-morado",
        Suspendido: "badge-etiqueta-rojo",
        "Sin invitar": "badge-estado-nuevo"
      };
      function CambiarEstadoAcceso(fila, nuevoEstado) {
        var insignia = fila.querySelector('[data-campo-badge="estado"]');
        insignia.className = "badge " + mapaBadgeAcceso[nuevoEstado];
        insignia.textContent = nuevoEstado;
        fila.setAttribute("data-estado", nuevoEstado);
        ActualizarAccionesFila(fila, nuevoEstado);
      }
      tabla.addEventListener("click", function (evento) {
        var boton = evento.target.closest("[data-accion]");
        if (!boton) {
          return;
        }
        filaSeleccionada = boton.closest("tr");
        var accion = boton.getAttribute("data-accion");
        var correo = filaSeleccionada.getAttribute("data-correo");
        var nombre = filaSeleccionada.querySelector("td").textContent.trim();
        if (accion === "invitar") {
          CambiarEstadoAcceso(filaSeleccionada, "Invitado");
          MostrarToast("Invitación enviada a " + correo + ".");
        } else if (accion === "reenviar") {
          MostrarToast("Invitación reenviada a " + correo + ".");
        } else if (accion === "restablecer") {
          MostrarToast("Se envió un enlace para restablecer la contraseña a " + correo + ".");
        } else if (accion === "reactivar") {
          CambiarEstadoAcceso(filaSeleccionada, "Activo");
          MostrarToast("Acceso reactivado para " + correo + ".");
        } else if (accion === "suspender") {
          document.getElementById("NombreSuspenderAcceso").textContent = nombre;
          instanciaSuspender.show();
        }
      });
      document.getElementById("BotonConfirmarSuspenderAcceso").addEventListener("click", function () {
        if (!filaSeleccionada) {
          return;
        }
        CambiarEstadoAcceso(filaSeleccionada, "Suspendido");
        instanciaSuspender.hide();
        MostrarToast("Acceso suspendido.", "error");
      });
    });
  </script>
}
