@{ Layout = null; }\n<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuarios externos — Mente Activa Psicopedagogía</title>


  <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500&family=Poppins:wght@@600;700&display=swap"
    rel="stylesheet">


  <link href="~/css/Styles.css" rel="stylesheet">
</head>

<body>

  <div class="WrapperAdmin">


    <div class="FondoSidebarMovil"></div>


    <aside class="SidebarAdmin">
      <a href="/Admin/Dashboard" class="SidebarAdmin-Marca">
        <img src="~/img/LogoMenteActiva.jpeg" alt="Logo Mente Activa Psicopedagogía" class="LogoMarca">
        <span>Mente Activa</span>
      </a>

      <nav class="SidebarAdmin-Nav">
        <!-- Razor: asp-controller="Dashboard" asp-action="Index" -->
        <a href="/Admin/Dashboard" class="SidebarAdmin-Enlace">
