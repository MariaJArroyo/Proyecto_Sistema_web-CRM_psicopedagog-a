@{ ViewData["Title"] = "Acceso denegado"; }

<div class="text-center">
  <i class="bi bi-shield-lock text-danger" style="font-size: 2.5rem;"></i>
  <h1 class="h5 mt-3">No tiene permiso para ver esta página</h1>
  <p class="TextoSuave mb-4">
    Su cuenta inició sesión correctamente, pero su rol no tiene acceso a esta sección.
    Si cree que es un error, consulte con la administración.
  </p>

  <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
    <button type="submit" class="btn btn-outline-secondary w-100">
      <i class="bi bi-box-arrow-left me-1"></i>Cerrar sesión e ingresar con otra cuenta
    </button>
  </form>
</div>

<p class="text-center TextoSuave small mt-4 mb-0">
  <a href="/"><i class="bi bi-arrow-left me-1"></i>Volver al sitio público</a>
</p>
