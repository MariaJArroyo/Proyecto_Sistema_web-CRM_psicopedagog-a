@model MenteActiva.Models.LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }

@if (TempData["Mensaje"] is string aviso)
{
  <div class="alert alert-success" role="alert">@aviso</div>
}

@* La sesion vencida no es un exito: va en amarillo y no en verde *@
@if (TempData["Aviso"] is string advertencia)
{
  <div class="alert alert-warning" role="alert">@advertencia</div>
}

@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
{
  <div class="alert alert-danger" role="alert">
    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
    {
      <div>@error.ErrorMessage</div>
    }
  </div>
}

<form asp-controller="Cuenta" asp-action="Login" asp-route-urlRetorno="@ViewData["UrlRetorno"]" method="post" novalidate
  id="FormularioLogin">
  <div class="mb-3">
    <label for="CorreoElectronico" class="form-label CampoObligatorio">Correo electrónico</label>
    <input type="email" class="form-control" asp-for="CorreoElectronico" id="CorreoElectronico"
      placeholder="correo@@ejemplo.com" autocomplete="username">
    <div class="invalid-feedback"></div>
    <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
  </div>
  <div class="mb-2">
    <label for="Contrasena" class="form-label CampoObligatorio">Contraseña</label>
    <input type="password" class="form-control" asp-for="Contrasena" id="Contrasena" placeholder="Su contraseña"
      autocomplete="current-password">
    <div class="invalid-feedback"></div>
    <span asp-validation-for="Contrasena" class="text-danger small"></span>
  </div>
  <div class="text-end mb-4">
    <a asp-controller="Cuenta" asp-action="RecuperarContrasena" class="small">¿Olvidó su contraseña?</a>
  </div>
  <button type="submit" class="btn btn-primary w-100 btn-lg">
    <i class="bi bi-box-arrow-in-right me-1"></i>Ingresar
  </button>
</form>

<p class="text-center TextoSuave small mt-4 mb-0">
  <a href="/"><i class="bi bi-arrow-left me-1"></i>Volver al sitio público</a>
</p>
