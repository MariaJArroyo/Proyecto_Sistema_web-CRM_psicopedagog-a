@{ Layout = null; }<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar contraseña — Mente Activa Psicopedagogía</title>


  <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500&family=Poppins:wght@@600;700&display=swap"
    rel="stylesheet">


  <link href="~/css/Styles.css" rel="stylesheet">
</head>

<body>

  <!-- Razor: inicio de contenido de la vista -->
  <main class="PantallaLogin">
    <div class="TarjetaLogin">
      <a href="/" class="TarjetaLogin-Marca">
        <img src="~/img/LogoMenteActiva.jpeg" alt="Logo Mente Activa Psicopedagogía" class="LogoMarca">
        Mente Activa Psicopedagogía
      </a>

      <div id="PasoSolicitarCorreo">
        <p class="TextoSuave text-center mb-4">
          Ingrese el correo asociado a su cuenta y le enviaremos un enlace para restablecer su contraseña.
        </p>

        <!-- Razor: asp-controller="Cuenta" asp-action="RecuperarContrasena" method="post" -->
        <form id="FormularioRecuperar" novalidate>
          <div class="mb-4">
            <label for="CorreoRecuperar" class="form-label CampoObligatorio">Correo electrónico</label>
            <input type="email" class="form-control" id="CorreoRecuperar" name="CorreoElectronico"
              placeholder="correo@@ejemplo.com" autocomplete="username">
            <div class="invalid-feedback"></div>
          </div>
          <button type="submit" class="btn btn-primary w-100 btn-lg">
            <i class="bi bi-envelope me-1"></i>Enviar enlace de recuperación
          </button>
        </form>
      </div>

      <div id="PasoConfirmacion" class="d-none text-center">
        <i class="bi bi-check-circle text-success" style="font-size: 2.5rem;"></i>
        <p class="mt-3 mb-0">
          Si el correo <strong id="CorreoEnviadoA"></strong> está registrado, recibirá un enlace
          para restablecer su contraseña en los próximos minutos.
        </p>
      </div>

      <p class="text-center TextoSuave small mt-4 mb-0">
        <a href="/Cuenta/Login"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
      </p>
    </div>
  </main>
  <!-- Razor: /fin de contenido de la vista -->

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/Main.js"></script>
  <script src="~/js/Validaciones.js"></script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      document.getElementById("FormularioRecuperar").addEventListener("submit", function (evento) {
        evento.preventDefault();
        var campoCorreo = document.getElementById("CorreoRecuperar");
        if (!ValidarCorreo(campoCorreo)) {
          return;
        }
        document.getElementById("CorreoEnviadoA").textContent = campoCorreo.value;
        document.getElementById("PasoSolicitarCorreo").classList.add("d-none");
        document.getElementById("PasoConfirmacion").classList.remove("d-none");
      });
    });
  </script>
</body>

</html>