@model MenteActiva.Models.RecuperarContrasenaViewModel
@{ ViewData["Title"] = "Recuperar contraseña"; }

@if (ViewData["CorreoEnviadoA"] is string destinatario)
{
  <div id="PasoConfirmacion" class="text-center">
    <i class="bi bi-check-circle text-success" style="font-size: 2.5rem;"></i>
    <p class="mt-3 mb-0">
      Si el correo <strong>@destinatario</strong> está registrado, recibirá un enlace
      para restablecer su contraseña en los próximos minutos.
    </p>
  </div>
}
else
{
  <div id="PasoSolicitarCorreo">
    <p class="TextoSuave text-center mb-4">
      Ingrese el correo asociado a su cuenta y le enviaremos un enlace para restablecer su contraseña.
    </p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
      <div class="alert alert-danger" role="alert">
        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
        {
          <div>@error.ErrorMessage</div>
        }
      </div>
    }

    <form asp-controller="Cuenta" asp-action="RecuperarContrasena" method="post" novalidate id="FormularioRecuperar">
      <div class="mb-4">
        <label for="CorreoRecuperar" class="form-label CampoObligatorio">Correo electrónico</label>
        <input type="email" class="form-control" asp-for="CorreoElectronico" id="CorreoRecuperar"
          placeholder="correo@@ejemplo.com" autocomplete="username">
        <div class="invalid-feedback"></div>
        <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
      </div>
      <button type="submit" class="btn btn-primary w-100 btn-lg">
        <i class="bi bi-envelope me-1"></i>Enviar enlace de recuperación
      </button>
    </form>
  </div>
}

<p class="text-center TextoSuave small mt-4 mb-0">
  <a asp-controller="Cuenta" asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
</p>
