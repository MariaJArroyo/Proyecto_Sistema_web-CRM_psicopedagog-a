@{
    ViewData["Title"] = "Tutorías y apoyo psicopedagógico";
}

    <header class="Hero" id="inicio">
        <div class="container">
            <div class="row align-items-center gy-5 g-lg-5">

                <div class="col-lg-6">
                    <span class="badge badge-estado-activo mb-3">
                        Consultorio de psicopedagogía
                    </span>

                    <h1 class="mb-3">
                        Acompañamos el aprendizaje de cada estudiante, con calidez y compromiso
                    </h1>

                    <p class="TextoSuave mb-4">
                        Soy psicopedagoga especializada en tutoría académica y apoyo psicopedagógico
                        infantil y adolescente. Trabajo de la mano con familias y estudiantes para
                        fortalecer el aprendizaje, la confianza y el bienestar emocional en cada etapa
                        escolar.
                    </p>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="#contacto" class="btn btn-primary btn-lg">
                            <i class="bi bi-calendar-check me-1"></i>
                            Agendar una consulta
                        </a>

                        <a href="#servicios" class="btn btn-outline-primary btn-lg">
                            Conocer servicios
                        </a>
                    </div>
                </div>

                <div class="col-lg-6 text-center">
                    <div class="HeroLogoMarco mx-auto" style="max-width: 420px;">
                        <img src="~/img/LogoMenteActiva.jpeg"
                             alt="Logo Mente Activa Psicopedagogía">
                    </div>
                </div>

            </div>
        </div>
    </header>


    <!-- =========================
     SERVICIOS
========================== -->

    <section class="SeccionAlterna" id="servicios">
        <div class="container">

            <div class="text-center mb-5">
                <h2>Nuestros servicios</h2>

                <p class="TextoSuave">
                    Programas pensados para cada etapa y necesidad del estudiante.
                </p>
            </div>

            <div class="row g-4">

                @if (ViewBag.Servicios != null)
                {
                    foreach (var servicio in ViewBag.Servicios)
                    {
                        var categoria = "Servicio";
                        var icono = "bi-journal-bookmark";
                        var colorFondo = "#e0e7ff";
                        var colorTexto = "#3730a3";

                        switch (servicio.Nombre)
                        {
                            case "Tutoría académica":
                                categoria = "Académico";
                                icono = "bi-journal-bookmark";
                                colorFondo = "#dbeafe";
                                colorTexto = "#1d4ed8";
                                break;

                            case "Apoyo psicopedagógico":
                                categoria = "Psicopedagógico";
                                icono = "bi-heart";
                                colorFondo = "#ede9fe";
                                colorTexto = "#7c3aed";
                                break;

                            case "Evaluaciones":
                                categoria = "Evaluación";
                                icono = "bi-clipboard-data";
                                colorFondo = "#cffafe";
                                colorTexto = "#0891b2";
                                break;

                            case "Orientación a padres":
                                categoria = "Familia";
                                icono = "bi-people";
                                colorFondo = "#dcfce7";
                                colorTexto = "#15803d";
                                break;
                        }

                        <div class="col-md-6 col-lg-3">
                            <div class="TarjetaServicio">

                                <div class="TarjetaServicio-Icono">
                                    <i class="bi @icono"></i>
                                </div>

                                <span class="badge"
                                      style="background-color: @colorFondo; color: @colorTexto;">
                                    @categoria
                                </span>

                                <h3>
                                    @servicio.Nombre
                                </h3>

                                <p class="TextoSuave mb-0">
                                    @servicio.Descripcion
                                </p>

                            </div>
                        </div>
                    }
                }

            </div>

        </div>
    </section>


    <!-- =========================
         TESTIMONIOS
    ========================== -->

    <section class="SeccionFondo" id="testimonios">
        <div class="container">

            <div class="text-center mb-5">
                <h2>Lo que dicen las familias</h2>

                <p class="TextoSuave">
                    Experiencias de padres y estudiantes que han sido parte del proceso.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="TarjetaTestimonio">

                        <i class="bi bi-quote"></i>

                        <p class="mb-0">
                            “El acompañamiento fue clave para que mi hijo mejorara su confianza
                            y sus notas en matemáticas.”
                        </p>

                        <p class="TarjetaTestimonio-Autor mb-0">
                            Carlos J.
                        </p>

                        <small class="TextoSuave">
                            Encargado de estudiante
                        </small>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="TarjetaTestimonio">

                        <i class="bi bi-quote"></i>

                        <p class="mb-0">
                            “Muy profesional y cercana. Las sesiones se adaptaron a las
                            necesidades específicas de mi hija.”
                        </p>

                        <p class="TarjetaTestimonio-Autor mb-0">
                            María R.
                        </p>

                        <small class="TextoSuave">
                            Encargada de estudiante
                        </small>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="TarjetaTestimonio">

                        <i class="bi bi-quote"></i>

                        <p class="mb-0">
                            “Aprendí técnicas de estudio que me han servido en todas las materias,
                            no solo en la que reforzaba.”
                        </p>

                        <p class="TarjetaTestimonio-Autor mb-0">
                            D. Vargas
                        </p>

                        <small class="TextoSuave">
                            Estudiante de secundaria
                        </small>

                    </div>
                </div>

            </div>

        </div>
    </section>


    <!-- =========================
         CONTACTO
    ========================== -->

    <section class="SeccionAlterna" id="contacto">
        <div class="container">

            <div class="row gy-5 g-lg-5">

                <div class="col-lg-5">

                    <h2>Conversemos</h2>

                    <p class="TextoSuave">
                        Escribinos y con gusto te contamos más sobre el proceso, horarios
                        disponibles y cómo podemos apoyar a tu estudiante.
                    </p>

                    <ul class="list-unstyled TextoSuave">

                        <li class="mb-2">
                            <i class="bi bi-telephone me-2 text-primary"></i>
                            8888-8888
                        </li>

                        <li class="mb-2">
                            <i class="bi bi-envelope me-2 text-primary"></i>
                            contacto@@menteactiva.cr
                        </li>

                        <li class="mb-2">
                            <i class="bi bi-geo-alt me-2 text-primary"></i>
                            San José, Costa Rica
                        </li>

                    </ul>

                </div>


                <div class="col-lg-7">

                    <div class="Tarjeta p-4 p-md-5">

                        <div class="alert alert-success d-none"
                             role="alert"
                             id="ConfirmacionContacto">

                            <i class="bi bi-check-circle me-1"></i>
                            ¡Gracias por escribirnos! Te contactaremos muy pronto.

                        </div>


                        <div class="alert alert-danger d-none"
                             role="alert"
                             id="ErrorContacto">
                        </div>


                        <form id="FormularioContacto"
                              action="/Home/EnviarContacto"
                              method="post"
                              novalidate>

                            @Html.AntiForgeryToken()


                            <!-- Campo trampa para bots -->
                            <div style="position:absolute; left:-10000px; width:1px; height:1px; overflow:hidden;"
                                 aria-hidden="true">

                                <label for="SitioWeb">
                                    No llenar este campo
                                </label>

                                <input type="text"
                                       id="SitioWeb"
                                       name="SitioWeb"
                                       tabindex="-1"
                                       autocomplete="off">

                            </div>


                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label for="Nombre"
                                           class="form-label CampoObligatorio">
                                        Nombre
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="Nombre"
                                           name="Nombre"
                                           maxlength="100"
                                           autocomplete="given-name"
                                           placeholder="Su nombre">

                                    <div class="invalid-feedback"></div>

                                </div>


                                <div class="col-md-6">

                                    <label for="Apellido"
                                           class="form-label CampoObligatorio">
                                        Apellido
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="Apellido"
                                           name="Apellido"
                                           maxlength="100"
                                           autocomplete="family-name"
                                           placeholder="Su apellido">

                                    <div class="invalid-feedback"></div>

                                </div>


                                <div class="col-md-6">

                                    <label for="Telefono"
                                           class="form-label CampoObligatorio">
                                        Teléfono
                                    </label>

                                    <input type="tel"
                                           class="form-control"
                                           id="Telefono"
                                           name="Telefono"
                                           autocomplete="tel-national"
                                           placeholder="8888-8888">

                                    <div class="invalid-feedback"></div>

                                </div>


                                <div class="col-md-6">

                                    <label for="CorreoElectronico"
                                           class="form-label CampoObligatorio">
                                        Correo electrónico
                                    </label>

                                    <input type="email"
                                           class="form-control"
                                           id="CorreoElectronico"
                                           name="CorreoElectronico"
                                           maxlength="150"
                                           autocomplete="email"
                                           placeholder="correo@@ejemplo.com">

                                    <div class="invalid-feedback"></div>

                                </div>


                                <div class="col-12">

                                    <label for="ServicioInteres"
                                           class="form-label CampoObligatorio">
                                        Servicio de interés
                                    </label>

                                    <select class="form-select"
                                            id="ServicioInteres"
                                            name="IdServicioInteres">

                                        <option value="" selected>
                                            Seleccione una opción
                                        </option>

                                        @if (ViewBag.Servicios != null)
                                        {
                                            foreach (var servicio in ViewBag.Servicios)
                                            {
                                                <option value="@servicio.IdServicio">
                                                    @servicio.Nombre
                                                </option>
                                            }
                                        }

                                    </select>

                                    <div class="invalid-feedback"></div>

                                </div>


                                <div class="col-12">

                                    <label for="Mensaje"
                                           class="form-label CampoObligatorio">
                                        Mensaje
                                    </label>

                                    <textarea class="form-control"
                                              id="Mensaje"
                                              name="Mensaje"
                                              rows="4"
                                              maxlength="2000"
                                              placeholder="Contanos brevemente qué necesitás"></textarea>

                                    <div class="invalid-feedback"></div>

                                </div>

                            </div>


                            <button type="submit"
                                    class="btn btn-primary btn-lg mt-4"
                                    id="BotonEnviarContacto">

                                <i class="bi bi-send me-1"></i>
                                Enviar mensaje

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </section>
