@model PortalCitasViewModel
@{
    ViewData["Title"] = "Citas";
    var error = ViewBag.ErrorCarga as string;
}
<main class="PrincipalPortal" id="PortalCitas" data-portal-estudiante="@Model.IdEstudiante">
    <div class="container">
        <h2 class="mb-2">Citas del estudiante</h2>
        <p class="TextoSuave mb-4">Consulte las próximas citas y el historial.</p>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        else if (Model.Estudiantes.Count == 0)
        {
            <div class="alert alert-info">No hay estudiantes disponibles para consultar.</div>
        }
        else
        {
            <form asp-controller="Portal" asp-action="Citas" method="get" data-portal-filtros class="row g-3 align-items-end mb-4">
                <input type="hidden" name="idEstudiante" value="@Model.IdEstudiante" />
                <div class="col-md-6 col-lg-4">
                    <label asp-for="Filtro" class="form-label">Mostrar</label>
                    <select asp-for="Filtro" class="form-select">
                        <option value="proximas">Próximas programadas o confirmadas</option>
                        <option value="futuras">Todas las futuras</option>
                        <option value="pasadas">Pasadas</option>
                        <option value="canceladas">Canceladas</option>
                        <option value="completadas">Completadas</option>
                        <option value="todas">Todas</option>
                    </select>
                </div>
            </form>
            @if (Model.Citas.Count == 0)
            {
                <div class="EstadoVacio"><p class="mb-0">No hay citas para el filtro seleccionado.</p></div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var cita in Model.Citas)
                    {
                        <div class="col-md-6 col-lg-4">
                            <article class="Tarjeta p-3 h-100">
                                <div class="d-flex justify-content-between gap-2 mb-3">
                                    <h3 class="h5 mb-0">@cita.TipoSesion</h3>
                                    <span class="badge bg-secondary align-self-start">@cita.Estado</span>
                                </div>
                                <p><strong>Fecha:</strong> @cita.FechaHoraInicio.ToString("dd/MM/yyyy")</p>
                                <p><strong>Inicio:</strong> @cita.FechaHoraInicio.ToString("HH:mm")</p>
                                <p><strong>Fin:</strong> @cita.FechaHoraFin.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="mb-0"><strong>Modalidad:</strong> @cita.Modalidad</p>
                            </article>
                        </div>
                    }
                </div>
            }
        }
    </div>
</main>
@section Scripts {
    <script src="~/js/citasPortal.js" asp-append-version="true"></script>
}
