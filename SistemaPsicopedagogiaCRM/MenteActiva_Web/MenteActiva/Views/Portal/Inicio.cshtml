@model PortalInicioViewModel
@using System.Globalization
@using MenteActiva.Services
@inject IProveedorMoneda ProveedorMoneda
@{
    ViewData["Title"] = "Inicio del portal";
    var error = ViewBag.ErrorCarga as string;
    var moneda = await ProveedorMoneda.ObtenerAsync();
    var nombreEstudiante = Model.Estudiantes
        .FirstOrDefault(e => e.IdEstudiante == Model.Resumen.IdEstudiante)?.Estudiante ?? string.Empty;

    var primerNombre = nombreEstudiante.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nombreEstudiante;
    var iniciales = string.Concat(nombreEstudiante
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpperInvariant(p[0])));

    var hoy = DateTime.Today.ToString("dddd d 'de' MMMM", new CultureInfo("es-CR"));

    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 18 ? "Buenas tardes" : "Buenas noches";
}
<main class="PrincipalPortal" id="PortalInicio" data-portal-estudiante="@Model.Resumen.IdEstudiante">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            @await Html.PartialAsync("_EncabezadoPortal", new EncabezadoPortalViewModel("bi-house-heart", "Portal de familias", "Consulte la información del estudiante seleccionado en la parte superior."))
            <div class="alert alert-danger" role="alert">@error</div>
        }
        else if (Model.Estudiantes.Count == 0)
        {
            @await Html.PartialAsync("_EncabezadoPortal", new EncabezadoPortalViewModel("bi-house-heart", "Portal de familias", "Consulte la información del estudiante seleccionado en la parte superior."))
            <div class="EstadoVacio">
                <i class="bi bi-people" aria-hidden="true"></i>
                <p class="mb-0">No hay estudiantes disponibles. Consulte con el centro.</p>
            </div>
        }
        else
        {
            <section class="BienvenidaPortal" aria-labelledby="TituloBienvenidaPortal">
                <div class="position-relative" style="z-index: 1;">
                    <span class="BienvenidaPortal-Etiqueta">
                        <i class="bi bi-house-heart" aria-hidden="true"></i>@saludo
                    </span>
                    <h1 class="BienvenidaPortal-Titulo" id="TituloBienvenidaPortal">Así va @primerNombre</h1>
                    <p class="BienvenidaPortal-Texto">
                        Las próximas citas, las tareas y el avance de @nombreEstudiante, todo en un solo lugar.
                    </p>
                    <div class="BienvenidaPortal-Acciones">
                        <a class="btn btn-primary" asp-controller="Portal" asp-action="Citas" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="proximas">
                            <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Ver citas
                        </a>
                        <a class="btn btn-outline-primary bg-white" asp-controller="Portal" asp-action="Mensajes" asp-route-idEstudiante="@Model.Resumen.IdEstudiante">
                            <i class="bi bi-chat-dots me-1" aria-hidden="true"></i>Escribir al consultorio
                        </a>
                    </div>
                </div>

                <div class="BienvenidaPortal-Lado" aria-hidden="true">
                    <span class="Iniciales Iniciales-Grande">@iniciales</span>
                    <span class="fw-semibold">@nombreEstudiante</span>
                    <span class="BienvenidaPortal-Fecha"><i class="bi bi-calendar3 me-1"></i>@hoy</span>
                </div>
            </section>

            @if (Model.Resumen.SaldoPendiente > 0)
            {
                @* Aviso de saldo: solo aparece cuando hay algo por pagar *@
                <aside class="AvisoSaldoPortal" role="status" aria-labelledby="TituloAvisoSaldo">
                    <span class="AvisoSaldoPortal-Icono" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
                    <div class="AvisoSaldoPortal-Texto">
                        <h2 class="AvisoSaldoPortal-Titulo" id="TituloAvisoSaldo">Tiene pagos pendientes</h2>
                        <p>
                            El saldo pendiente de @primerNombre es de
                            <strong>@FormatoDinero.Escribir(Model.Resumen.SaldoPendiente, moneda)</strong>.
                            ¿Ya pagó por SINPE o transferencia? Repórtelo con la captura o el número de referencia.
                        </p>
                    </div>
                    <a class="btn AvisoSaldoPortal-Boton" asp-controller="Portal" asp-action="Pagos" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="pendientes">
                        Ver y reportar pagos<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                    </a>
                </aside>
            }

            <h2 class="visually-hidden">Resumen</h2>
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <article class="IndicadorPortal IndicadorPortal-Citas">
                        <span class="IndicadorPortal-Icono" aria-hidden="true"><i class="bi bi-calendar-check"></i></span>
                        <div class="IndicadorPortal-Cuerpo">
                            <p class="IndicadorPortal-Valor" data-contar="@Model.Resumen.CitasProximas">@Model.Resumen.CitasProximas</p>
                            <h3 class="IndicadorPortal-Etiqueta">
                                <a class="stretched-link text-reset text-decoration-none" asp-controller="Portal" asp-action="Citas" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="proximas">Próximas citas</a>
                            </h3>
                        </div>
                        <i class="bi bi-arrow-right IndicadorPortal-Flecha" aria-hidden="true"></i>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="IndicadorPortal IndicadorPortal-Tareas">
                        <span class="IndicadorPortal-Icono" aria-hidden="true"><i class="bi bi-journal-check"></i></span>
                        <div class="IndicadorPortal-Cuerpo">
                            <p class="IndicadorPortal-Valor" data-contar="@Model.Resumen.TareasPendientes">@Model.Resumen.TareasPendientes</p>
                            <h3 class="IndicadorPortal-Etiqueta">
                                <a class="stretched-link text-reset text-decoration-none" asp-controller="Portal" asp-action="Tareas" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="pendientes">Tareas pendientes</a>
                            </h3>
                        </div>
                        <i class="bi bi-arrow-right IndicadorPortal-Flecha" aria-hidden="true"></i>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="IndicadorPortal IndicadorPortal-Reportes">
                        <span class="IndicadorPortal-Icono" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
                        <div class="IndicadorPortal-Cuerpo">
                            <p class="IndicadorPortal-Valor" data-contar="@Model.Resumen.ReportesDisponibles">@Model.Resumen.ReportesDisponibles</p>
                            <h3 class="IndicadorPortal-Etiqueta">
                                <a class="stretched-link text-reset text-decoration-none" asp-controller="Portal" asp-action="Progreso" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtroReportes="todos">Reportes disponibles</a>
                            </h3>
                        </div>
                        <i class="bi bi-arrow-right IndicadorPortal-Flecha" aria-hidden="true"></i>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="IndicadorPortal IndicadorPortal-Pagos">
                        <span class="IndicadorPortal-Icono" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
                        <div class="IndicadorPortal-Cuerpo">
                            <p class="IndicadorPortal-Valor IndicadorPortal-Valor-Monto">@FormatoDinero.Escribir(Model.Resumen.SaldoPendiente, moneda)</p>
                            <h3 class="IndicadorPortal-Etiqueta">
                                <a class="stretched-link text-reset text-decoration-none" asp-controller="Portal" asp-action="Pagos" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="pendientes">Saldo pendiente</a>
                            </h3>
                        </div>
                        <i class="bi bi-arrow-right IndicadorPortal-Flecha" aria-hidden="true"></i>
                    </article>
                </div>
            </div>

            <div class="FranjaPortal">
                <span class="FranjaPortal-Icono" aria-hidden="true"><i class="bi bi-lightbulb"></i></span>
                <div class="flex-grow-1">
                    <h3>Recomendaciones para casa</h3>
                    <p>Ideas que la profesora deja después de cada sesión para apoyar a @primerNombre en casa.</p>
                </div>
                <a class="btn btn-outline-primary bg-white" asp-controller="Portal" asp-action="Progreso" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-fragment="Recomendaciones">
                    Ver recomendaciones<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            </div>
        }
    </div>
</main>
@section Scripts {
    <script src="~/js/inicioPortal.js" asp-append-version="true"></script>
}
