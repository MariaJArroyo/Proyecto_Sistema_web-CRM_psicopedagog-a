@{ Layout = null; }\n<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal de familias — Mente Activa Psicopedagogía</title>


  <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500&family=Poppins:wght@@600;700&display=swap"
    rel="stylesheet">


  <link href="~/css/Styles.css" rel="stylesheet">
</head>

<body>

  <nav class="navbar navbar-expand-lg NavbarPortal sticky-top py-2">
    <div class="container">
      <a class="navbar-brand" href="/Portal/Inicio">
        <img src="~/img/LogoMenteActiva.jpeg" alt="Logo Mente Activa Psicopedagogía" class="LogoMarca">
        Mente Activa Psicopedagogía
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#MenuPortal"
        aria-controls="MenuPortal" aria-expanded="false" aria-label="Abrir menú">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="MenuPortal">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <!-- Selector de estudiante: para encargados con más de un estudiante a cargo (HU-M3-5) -->
          <li class="nav-item dropdown" data-selector-estudiante>
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-mortarboard me-1"></i>Viendo a: <span data-estudiante-etiqueta>María Rodríguez</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="#" data-estudiante-valor="MariaRodriguez">María Rodríguez</a></li>
              <li><a class="dropdown-item" href="#" data-estudiante-valor="AndresJimenez">Andrés Jiménez</a></li>
            </ul>
          </li>
          <!-- Razor: asp-controller="Portal" asp-action="Inicio" -->
          <li class="nav-item"><a class="nav-link" href="/Portal/Inicio">Inicio</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Citas" -->
          <li class="nav-item"><a class="nav-link" href="/Portal/Citas">Citas</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Progreso" -->
          <li class="nav-item"><a class="nav-link" href="/Portal/Progreso">Progreso</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Tareas" -->
          <li class="nav-item"><a class="nav-link" href="/Portal/Tareas">Tareas</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Pagos" -->
          <li class="nav-item"><a class="nav-link" href="/Portal/Pagos">Pagos</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Perfil" -->
          <li class="nav-item"><a class="nav-link" href="/Portal/Perfil">Mi perfil</a></li>
          <li class="nav-item ms-lg-2">
            <!-- Razor: asp-controller="Cuenta" asp-action="CerrarSesion" -->
            <a class="btn btn-outline-secondary btn-sm" href="/Cuenta/Login">
              <i class="bi bi-box-arrow-left me-1"></i>Salir
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Razor: inicio de contenido de la vista -->
  <main class="PrincipalPortal">
    <div class="container">
      <!-- Razor: el bloque visible depende de Model.EstudianteSeleccionado -->
      <div data-bloque-estudiante="MariaRodriguez">
        <div class="mb-4">
          <h2 class="mb-1">Bienvenido, Carlos</h2>
          <p class="TextoSuave mb-0">Aquí puede revisar la información de María Rodríguez.</p>
        </div>

        <div class="row g-3">
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-calendar-check"></i></div>
              <h3 class="h6">Próxima cita</h3>
              <p class="TextoSuave small flex-grow-1">Lunes 13 de julio, 9:00 a. m. — Tutoría académica.</p>
              <a href="/Portal/Citas" class="small">Ver citas<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-graph-up-arrow"></i></div>
              <h3 class="h6">Progreso reciente</h3>
              <p class="TextoSuave small flex-grow-1">Última sesión: 10 de julio — Fracciones. ¡Buen avance!</p>
              <a href="/Portal/Progreso" class="small">Ver progreso<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-list-check"></i></div>
              <h3 class="h6">Tareas pendientes</h3>
              <p class="TextoSuave small flex-grow-1">1 tarea pendiente: hoja de ejercicios de fracciones (vence 18
                jul).</p>
              <a href="/Portal/Tareas" class="small">Ver tareas<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-cash-coin"></i></div>
              <h3 class="h6">Pagos</h3>
              <p class="TextoSuave small flex-grow-1">Último pago: ₡15 000 el 10 de julio. Sin pagos pendientes.</p>
              <a href="/Portal/Pagos" class="small">Ver pagos<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
        </div>
      </div>

      <div data-bloque-estudiante="AndresJimenez" class="d-none">
        <div class="mb-4">
          <h2 class="mb-1">Bienvenido, Carlos</h2>
          <p class="TextoSuave mb-0">Aquí puede revisar la información de Andrés Jiménez.</p>
        </div>

        <div class="row g-3">
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-calendar-check"></i></div>
              <h3 class="h6">Próxima cita</h3>
              <p class="TextoSuave small flex-grow-1">Miércoles 15 de julio, 9:00 a. m. — Evaluación inicial.</p>
              <a href="/Portal/Citas" class="small">Ver citas<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-graph-up-arrow"></i></div>
              <h3 class="h6">Progreso reciente</h3>
              <p class="TextoSuave small flex-grow-1">Aún no hay informes de progreso registrados.</p>
              <a href="/Portal/Progreso" class="small">Ver progreso<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-list-check"></i></div>
              <h3 class="h6">Tareas pendientes</h3>
              <p class="TextoSuave small flex-grow-1">Sin tareas pendientes por el momento.</p>
              <a href="/Portal/Tareas" class="small">Ver tareas<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="TarjetaResumen-Icono mb-2"><i class="bi bi-cash-coin"></i></div>
              <h3 class="h6">Pagos</h3>
              <p class="TextoSuave small flex-grow-1">Aún no se han registrado pagos.</p>
              <a href="/Portal/Pagos" class="small">Ver pagos<i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
        </div>
      </div>
      <!-- /Razor -->
    </div>
  </main>
  <!-- Razor: /fin de contenido de la vista -->

  <footer class="text-center TextoSuave small py-4 border-top mt-5">
    &copy; 2026 Mente Activa Psicopedagogía — Portal de familias
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/Main.js"></script>
</body>

</html>