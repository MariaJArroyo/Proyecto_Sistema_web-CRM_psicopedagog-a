@model PortalInicioViewModel
@using MenteActiva.Services
@inject IProveedorMoneda ProveedorMoneda
@{
    ViewData["Title"] = "Inicio del portal";
    var error = ViewBag.ErrorCarga as string;
    var moneda = await ProveedorMoneda.ObtenerAsync();
}
<main class="PrincipalPortal" id="PortalInicio" data-portal-estudiante="@Model.Resumen.IdEstudiante">
    <div class="container">
        <h2 class="mb-2">Portal de familias</h2>
        <p class="TextoSuave mb-4">Consulte la información del estudiante seleccionado en el menú superior.</p>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        else if (Model.Estudiantes.Count == 0)
        {
            <div class="alert alert-info">No hay estudiantes disponibles. Consulte con el centro.</div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <article class="Tarjeta p-3 h-100">
                        <h3 class="h6">Próximas citas</h3>
                        <p class="fs-3 fw-semibold">@Model.Resumen.CitasProximas</p>
                        <a asp-controller="Portal" asp-action="Citas" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="proximas">Consultar citas</a>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="Tarjeta p-3 h-100">
                        <h3 class="h6">Tareas pendientes</h3>
                        <p class="fs-3 fw-semibold">@Model.Resumen.TareasPendientes</p>
                        <a asp-controller="Portal" asp-action="Tareas" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="pendientes">Consultar tareas</a>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="Tarjeta p-3 h-100">
                        <h3 class="h6">Reportes disponibles</h3>
                        <p class="fs-3 fw-semibold">@Model.Resumen.ReportesDisponibles</p>
                        <a asp-controller="Portal" asp-action="Progreso" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtroReportes="todos">Consultar progreso</a>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="Tarjeta p-3 h-100">
                        <h3 class="h6">Saldo pendiente</h3>
                        <p class="fs-4 fw-semibold">@FormatoDinero.Escribir(Model.Resumen.SaldoPendiente, moneda)</p>
                        <a asp-controller="Portal" asp-action="Pagos" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-route-filtro="pendientes">Consultar pagos</a>
                    </article>
                </div>
            </div>
            <div class="Tarjeta p-3 mt-4">
                <h3 class="h5">Recomendaciones para casa</h3>
                <p>Consulte las recomendaciones que la profesora registra para apoyar al estudiante.</p>
                <a asp-controller="Portal" asp-action="Progreso" asp-route-idEstudiante="@Model.Resumen.IdEstudiante" asp-fragment="Recomendaciones">Ver recomendaciones</a>
            </div>
        }
    </div>
</main>
@section Scripts {
    <script src="~/js/inicioPortal.js" asp-append-version="true"></script>
}
