@{
    ViewData["Title"] = "Mis pagos";
}

  <main class="PrincipalPortal">
    <div class="container">
      <!-- Razor: el bloque visible depende de Model.EstudianteSeleccionado -->
      <div data-bloque-estudiante="MariaRodriguez">
        <div class="mb-4">
          <h2 class="mb-1">Pagos</h2>
          <p class="TextoSuave mb-0">Pagos pendientes e historial de pagos de María Rodríguez.</p>
        </div>

        <!-- Pagos pendientes (HU-MU9-05) -->
        <h3 class="h5 mb-3">Pagos pendientes</h3>
        <!-- Razor: reemplazar por @@foreach (var pago in Model.PagosPendientes) -->
        <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
          <div>
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Paquete de sesiones — Agosto 2026</strong>
            <div class="small">₡60 000 · Vence el 5 de agosto, 2026</div>
          </div>
          <span class="badge badge-pago-pendiente">Pendiente</span>
        </div>
        <!-- /Razor -->

        <h3 class="h5 mb-3">Historial de pagos</h3>
        <!-- Razor: reemplazar por @@foreach (var pago in Model.HistorialPagos.OrderByDescending(p => p.Fecha)) -->
        <div class="Tarjeta p-3 p-md-4">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Monto</th>
                  <th>Método</th>
                  <th>Concepto</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>5 ago 2026</td>
                  <td>₡60 000</td>
                  <td>—</td>
                  <td>Paquete de sesiones</td>
                  <td><span class="badge badge-pago-pendiente">Pendiente</span></td>
                </tr>
                <tr>
                  <td>10 jul 2026</td>
                  <td>₡15 000</td>
                  <td>Sinpe Móvil</td>
                  <td>Sesión individual</td>
                  <td><span class="badge badge-pago-pagado">Pagado</span></td>
                </tr>
                <tr>
                  <td>10 jun 2026</td>
                  <td>₡15 000</td>
                  <td>Efectivo</td>
                  <td>Sesión individual</td>
                  <td><span class="badge badge-pago-pagado">Pagado</span></td>
                </tr>
                <tr>
                  <td>10 may 2026</td>
                  <td>₡15 000</td>
                  <td>Transferencia</td>
                  <td>Sesión individual</td>
                  <td><span class="badge badge-pago-pagado">Pagado</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div data-bloque-estudiante="AndresJimenez" class="d-none">
        <div class="mb-4">
          <h2 class="mb-1">Pagos</h2>
          <p class="TextoSuave mb-0">Pagos pendientes e historial de pagos de Andrés Jiménez.</p>
        </div>
        <div class="EstadoVacio">
          <i class="bi bi-cash-coin"></i>
          <p class="mb-0">Aún no se han registrado pagos para Andrés.</p>
        </div>
      </div>
    </div>
  </main>
