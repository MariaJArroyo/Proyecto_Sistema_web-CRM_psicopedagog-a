@model PortalPagosViewModel
@using MenteActiva.Services
@inject IProveedorMoneda ProveedorMoneda
@{
    ViewData["Title"] = "Pagos";
    var error = ViewBag.ErrorCarga as string;
    var moneda = await ProveedorMoneda.ObtenerAsync();
}
<main class="PrincipalPortal" id="PortalPagos" data-portal-estudiante="@Model.IdEstudiante">
    <div class="container">
        <h2 class="mb-2">Estado de pagos</h2>
        <p class="TextoSuave mb-4">Consulte los cargos, saldos y abonos del estudiante.</p>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        else if (Model.Estudiantes.Count == 0)
        {
            <div class="alert alert-info">No hay estudiantes disponibles para consultar.</div>
        }
        else
        {
            <form asp-controller="Portal" asp-action="Pagos" method="get" data-portal-filtros class="row g-3 align-items-end mb-4">
                <input type="hidden" name="idEstudiante" value="@Model.IdEstudiante" />
                <div class="col-md-6 col-lg-4">
                    <label asp-for="Filtro" class="form-label">Mostrar</label>
                    <select asp-for="Filtro" class="form-select">
                        <option value="pendientes">Pendientes, vencidos y parciales</option>
                        <option value="pagados">Pagados</option>
                        <option value="todos">Todos, incluidos anulados</option>
                    </select>
                </div>
            </form>
            <div id="AlertaPagosPortal" class="alert" role="status" aria-live="polite" hidden></div>
            @if (Model.Pagos.Count == 0)
            {
                <div class="EstadoVacio"><p class="mb-0">No hay cargos para el filtro seleccionado.</p></div>
            }
            else
            {
                <p class="mb-3"><strong>Saldo de los cargos mostrados:</strong> @FormatoDinero.Escribir(Model.Pagos.Sum(p => p.Saldo), moneda)</p>
                <div class="Tarjeta p-3">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <caption>Los abonos mostrados corresponden a registros activos.</caption>
                            <thead><tr><th scope="col">Concepto</th><th scope="col">Emisión</th><th scope="col">Vencimiento</th><th scope="col">Monto</th><th scope="col">Abonado</th><th scope="col">Saldo</th><th scope="col">Estado</th><th scope="col">Detalle</th></tr></thead>
                            <tbody>
                                @foreach (var pago in Model.Pagos)
                                {
                                    <tr>
                                        <th scope="row">@pago.Concepto</th>
                                        <td>@pago.FechaEmision.ToString("dd/MM/yyyy")</td>
                                        <td>@(pago.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin vencimiento")</td>
                                        <td>@FormatoDinero.Escribir(pago.Monto, moneda)</td>
                                        <td>@FormatoDinero.Escribir(pago.Abonado, moneda)</td>
                                        <td>@FormatoDinero.Escribir(pago.Saldo, moneda)</td>
                                        <td><span class="badge bg-secondary">@pago.Estado</span></td>
                                        <td><button type="button" class="btn btn-sm btn-outline-primary" data-detalle-pago data-url="@Url.Action("DetallePago", "Portal", new { idEstudiante = Model.IdEstudiante, idPago = pago.IdPago })" aria-label="Ver detalle de @pago.Concepto">Ver detalle</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</main>
<div class="modal fade" id="ModalPagoPortal" tabindex="-1" aria-labelledby="TituloDetallePagoPortal" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="TituloDetallePagoPortal">Detalle del cargo</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="ContenidoDetallePagoPortal"></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/pagosPortal.js" asp-append-version="true"></script>
}
