@{
    ViewData["Title"] = "Progreso";
}

  <main class="PrincipalPortal">
    <div class="container">
      <!-- Razor: el bloque visible depende de Model.EstudianteSeleccionado -->
      <div data-bloque-estudiante="MariaRodriguez">
        <div class="mb-4">
          <h2 class="mb-1">Progreso de María</h2>
          <p class="TextoSuave mb-0">Informes de progreso y recomendaciones de la profesora.</p>
        </div>

        <h3 class="h5 mb-3">Informes de progreso</h3>
        <!-- Razor: reemplazar por @@foreach (var informe in Model.InformesProgreso) -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h4 class="h6 mb-0">Informe de progreso — Junio 2026</h4>
                <span class="TextoSuave small">30 jun 2026</span>
              </div>
              <p class="TextoSuave small flex-grow-1">
                María mostró avances constantes en comprensión lectora durante el mes de junio.
              </p>
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" data-modal-detalle="ModalDetalleInforme"
                  data-valor-titulo="Informe de progreso — Junio 2026" data-valor-fecha="30 de junio, 2026"
                  data-valor-resumen="María mostró avances constantes en comprensión lectora durante el mes de junio, con especial mejoría en la identificación de la idea principal de un texto."
                  data-valor-recomendaciones="Continuar con lectura diaria en casa y reforzar vocabulario con juegos de palabras.">
                  Ver detalle
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary BotonDescargarInforme">
                  <i class="bi bi-download me-1"></i>Descargar PDF
                </button>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="Tarjeta p-3 h-100 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h4 class="h6 mb-0">Informe de progreso — Mayo 2026</h4>
                <span class="TextoSuave small">31 may 2026</span>
              </div>
              <p class="TextoSuave small flex-grow-1">
                Se inició el plan de refuerzo en comprensión lectora con buena disposición de la estudiante.
              </p>
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" data-modal-detalle="ModalDetalleInforme"
                  data-valor-titulo="Informe de progreso — Mayo 2026" data-valor-fecha="31 de mayo, 2026"
                  data-valor-resumen="Se inició el plan de refuerzo en comprensión lectora. María mostró buena disposición y motivación durante las primeras sesiones."
                  data-valor-recomendaciones="Establecer un espacio de lectura tranquilo en casa, sin distracciones, de al menos 15 minutos diarios.">
                  Ver detalle
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary BotonDescargarInforme">
                  <i class="bi bi-download me-1"></i>Descargar PDF
                </button>
              </div>
            </div>
          </div>
        </div>
        <!-- /Razor -->

        <h3 class="h5 mb-3">Recomendaciones de la profesora</h3>
        <!-- Razor: reemplazar por @@foreach (var recomendacion in Model.Recomendaciones) -->
        <div class="list-group">
          <button type="button" class="list-group-item list-group-item-action"
            data-modal-detalle="ModalDetalleRecomendacion" data-valor-titulo="Practicar lectura en voz alta"
            data-valor-detalle="Practicar lectura en voz alta 10 minutos diarios ayuda a mejorar la fluidez y la comprensión lectora de María. Se recomienda hacerlo en un ambiente tranquilo, sin distracciones.">
            <i class="bi bi-lightbulb me-2 text-primary"></i>Practicar lectura en voz alta 10 minutos diarios.
          </button>
          <button type="button" class="list-group-item list-group-item-action"
            data-modal-detalle="ModalDetalleRecomendacion" data-valor-titulo="Reforzar tablas de multiplicar"
            data-valor-detalle="Reforzar las tablas de multiplicar del 2 al 5 con juegos y material visual, en sesiones cortas de 10 a 15 minutos.">
            <i class="bi bi-lightbulb me-2 text-primary"></i>Reforzar tablas de multiplicar del 2 al 5 con juegos.
          </button>
          <button type="button" class="list-group-item list-group-item-action"
            data-modal-detalle="ModalDetalleRecomendacion" data-valor-titulo="Rutina de estudio"
            data-valor-detalle="Establecer una rutina de estudio de 30 minutos después de la merienda, en un espacio fijo de la casa, ayuda a crear el hábito de estudio.">
            <i class="bi bi-lightbulb me-2 text-primary"></i>Establecer una rutina de estudio después de la merienda.
          </button>
        </div>
        <!-- /Razor -->
      </div>

      <div data-bloque-estudiante="AndresJimenez" class="d-none">
        <div class="mb-4">
          <h2 class="mb-1">Progreso de Andrés</h2>
          <p class="TextoSuave mb-0">Informes de progreso y recomendaciones de la profesora.</p>
        </div>

        <h3 class="h5 mb-3">Informes de progreso</h3>
        <div class="EstadoVacio">
          <i class="bi bi-graph-up-arrow"></i>
          <p class="mb-0">Aún no hay informes de progreso disponibles. Se generará el primero después de su evaluación
            inicial.</p>
        </div>

        <h3 class="h5 mb-3 mt-4">Recomendaciones de la profesora</h3>
        <div class="list-group">
          <button type="button" class="list-group-item list-group-item-action"
            data-modal-detalle="ModalDetalleRecomendacion" data-valor-titulo="Antes de la primera sesión"
            data-valor-detalle="Se recomienda familiarizar a Andrés con el espacio de trabajo antes de su evaluación inicial, para que se sienta cómodo el día de la cita.">
            <i class="bi bi-lightbulb me-2 text-primary"></i>Familiarizarse con el espacio de trabajo antes de la
            primera sesión.
          </button>
        </div>
      </div>
      <!-- /Razor -->
    </div>
  </main>
  <!-- Razor: /fin de contenido de la vista -->

  <div class="modal fade" id="ModalDetalleInforme" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-campo="titulo">Informe de progreso</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <p class="TextoSuave small mb-2" data-campo="fecha"></p>
          <p data-campo="resumen"></p>
          <p class="fw-semibold mb-1">Recomendaciones</p>
          <p class="mb-0" data-campo="recomendaciones"></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="ModalDetalleRecomendacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-campo="titulo">Recomendación</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0" data-campo="detalle"></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

@section Scripts {
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll(".BotonDescargarInforme").forEach(function (boton) {
        boton.addEventListener("click", function () {
          MostrarToast("Descarga simulada del informe en PDF.");
        });
      });
    });
  </script>
}
