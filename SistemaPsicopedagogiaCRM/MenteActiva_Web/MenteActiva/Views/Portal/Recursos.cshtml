@model PortalRecursosViewModel
@{
    ViewData["Title"] = "Recursos";
    var error = ViewBag.ErrorCarga as string;

    // Ids fijos de TB_TIPO_MATERIAL
    var secciones = new (int Tipo, string Titulo, string Icono, string Vacio)[]
    {
        (1, "Guías educativas", "bi-journal-text", "No hay guías publicadas."),
        (2, "Documentos PDF", "bi-file-earmark-pdf", "No hay documentos publicados."),
        (4, "Actividades educativas", "bi-puzzle", "No hay actividades publicadas."),
        (3, "Enlaces útiles", "bi-link-45deg", "No hay enlaces publicados.")
    };

    // La base guarda el tipo sin tilde (CK_Material_TipoActividad); igual que ETIQUETA_ACTIVIDAD en materiales.js
    var etiquetasActividad = new Dictionary<string, string>
    {
        ["Ludica"] = "Lúdica",
        ["Cognitiva"] = "Cognitiva",
        ["Motriz"] = "Motriz"
    };
}
<main class="PrincipalPortal" id="PortalRecursos" data-portal-estudiante="@Model.IdEstudiante">
    <div class="container">
        @await Html.PartialAsync("_EncabezadoPortal", new EncabezadoPortalViewModel("bi-book", "Recursos", "Guías, documentos, actividades y enlaces publicados por el consultorio."))
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        else
        {
            <div id="MensajeRecurso" class="alert alert-danger" role="alert" hidden></div>
            @foreach (var seccion in secciones)
            {
                var recursos = Model.Recursos.Where(r => r.IdTipoMaterial == seccion.Tipo).ToList();
                <section class="mb-5" aria-labelledby="Seccion@(seccion.Tipo)">
                    <h2 class="h4 mb-3" id="Seccion@(seccion.Tipo)"><i class="bi @seccion.Icono me-2" aria-hidden="true"></i>@seccion.Titulo</h2>
                    @if (recursos.Count == 0)
                    {
                        <div class="EstadoVacio"><p class="mb-0">@seccion.Vacio</p></div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var recurso in recursos)
                            {
                                <div class="col-md-6">
                                    <article class="Tarjeta p-3 h-100 d-flex flex-column">
                                        <div class="d-flex justify-content-between gap-2 mb-2">
                                            <h3 class="h5">@recurso.Titulo</h3>
                                            @if (!string.IsNullOrWhiteSpace(recurso.NivelEducativo))
                                            {
                                                <span class="badge badge-estado-nuevo align-self-start">@recurso.NivelEducativo</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(recurso.Descripcion))
                                        {
                                            <p style="white-space: pre-wrap">@recurso.Descripcion</p>
                                        }
                                        @if (seccion.Tipo == 4)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(recurso.TipoActividad))
                                            {
                                                <p class="mb-1"><strong>Tipo:</strong> @(etiquetasActividad.GetValueOrDefault(recurso.TipoActividad, recurso.TipoActividad))</p>
                                            }
                                            @if (recurso.FechaActividad.HasValue)
                                            {
                                                <p class="mb-1"><strong>Fecha:</strong> @recurso.FechaActividad.Value.ToString("dd/MM/yyyy")</p>
                                            }
                                        }
                                        <div class="d-flex flex-wrap justify-content-end gap-2 mt-auto pt-3">
                                            @if (seccion.Tipo == 2 && recurso.TieneArchivo)
                                            {
                                                <button type="button" class="btn btn-outline-primary"
                                                        data-descargar-recurso
                                                        data-url="@Url.Action("DescargarRecurso", "Portal", new { idMaterial = recurso.IdMaterial })">
                                                    <i class="bi bi-download me-1" aria-hidden="true"></i>Descargar PDF
                                                </button>
                                            }
                                            @if (seccion.Tipo == 3
                                                && Uri.TryCreate(recurso.Url, UriKind.Absolute, out var enlace)
                                                && (enlace.Scheme == Uri.UriSchemeHttps || enlace.Scheme == Uri.UriSchemeHttp))
                                            {
                                                <button type="button" class="btn btn-outline-primary"
                                                        data-abrir-enlace
                                                        data-destino="@enlace.AbsoluteUri"
                                                        data-url="@Url.Action("VerificarEnlaceRecurso", "Portal", new { idMaterial = recurso.IdMaterial })">
                                                    <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Abrir enlace
                                                </button>
                                            }
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }
    </div>
</main>
@section Scripts {
    <script src="~/js/recursosPortal.js" asp-append-version="true"></script>
}
