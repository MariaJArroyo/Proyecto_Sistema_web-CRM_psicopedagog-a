@{
    ViewData["Title"] = "Mis tareas";
}

  <main class="PrincipalPortal">
    <div class="container">
      <!-- Razor: el bloque visible depende de Model.EstudianteSeleccionado -->
      <div data-bloque-estudiante="MariaRodriguez">
        <div class="mb-4">
          <h2 class="mb-1">Tareas de María</h2>
          <p class="TextoSuave mb-0">Tareas pendientes asignadas por la profesora, con su fecha límite.</p>
        </div>

        <!-- Tareas pendientes con fecha límite y adjunto (HU-MU9-04) -->
        <!-- Razor: reemplazar por @@foreach (var tarea in Model.TareasPendientes) -->
        <div class="Tarjeta p-3 p-md-4">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Tarea</th>
                  <th>Fecha límite</th>
                  <th>Adjunto</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Resolver hoja de ejercicios de fracciones</td>
                  <td>18 jul 2026</td>
                  <td>
                    <button type="button" class="btn btn-sm btn-outline-primary BotonDescargarAdjunto">
                      <i class="bi bi-download me-1"></i>hoja-fracciones.pdf
                    </button>
                  </td>
                </tr>
                <tr>
                  <td>Practicar lectura en voz alta 10 minutos diarios</td>
                  <td>20 jul 2026</td>
                  <td><span class="TextoSuave small">Sin adjunto</span></td>
                </tr>
                <tr>
                  <td>Leer el capítulo 3 del libro de lectoescritura</td>
                  <td>25 jul 2026</td>
                  <td>
                    <button type="button" class="btn btn-sm btn-outline-primary BotonDescargarAdjunto">
                      <i class="bi bi-download me-1"></i>capitulo-3.pdf
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <!-- /Razor -->
      </div>

      <div data-bloque-estudiante="AndresJimenez" class="d-none">
        <div class="mb-4">
          <h2 class="mb-1">Tareas de Andrés</h2>
          <p class="TextoSuave mb-0">Tareas pendientes asignadas por la profesora, con su fecha límite.</p>
        </div>
        <div class="EstadoVacio">
          <i class="bi bi-list-check"></i>
          <p class="mb-0">Sin tareas pendientes por el momento.</p>
        </div>
      </div>
      <!-- /Razor -->
    </div>
  </main>

@section Scripts {
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll(".BotonDescargarAdjunto").forEach(function (boton) {
        boton.addEventListener("click", function () {
          MostrarToast("Descarga simulada del adjunto.");
        });
      });
    });
  </script>
}
