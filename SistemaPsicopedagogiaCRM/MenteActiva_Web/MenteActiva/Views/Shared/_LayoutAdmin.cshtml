@inject MenteActiva.Services.IProveedorMoneda ProveedorMoneda
@{
    var titulo = ViewData["Title"] as string ?? "Panel administrativo";

    // La moneda de TB_CONFIGURACION viaja en el body para que formato.js la lea de
    // ahi y no la tenga escrita a mano cada archivo de JavaScript
    var moneda = await ProveedorMoneda.ObtenerAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
  <partial name="_CabeceraComun" model="titulo" />
</head>
<body data-moneda="@moneda">

  <div class="WrapperAdmin">

    <div class="FondoSidebarMovil"></div>

    <partial name="_SidebarAdmin" />

    <div class="ContenidoAdmin">

      <partial name="_TopbarAdmin" />

      @RenderBody()

    </div>
  </div>

  <!-- Contenedor de toasts de confirmacion -->
  <div class="ContenedorToasts" aria-live="polite" aria-atomic="true"></div>

  <partial name="_ScriptsComunes" />
  <!-- Primero el gancho del 401: tiene que estar puesto antes de que cualquier pantalla pida datos -->
  <script src="~/js/sesionApi.js" asp-append-version="true"></script>
  <script src="~/js/formato.js" asp-append-version="true"></script>
  <script src="~/js/Main.js" asp-append-version="true"></script>
  <script src="~/js/contadores.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>