@{
  var titulo = ViewData["Title"] as string ?? "Acceso";
}<!DOCTYPE html>
<html lang="es">

<head>
  <partial name="_CabeceraComun" model="titulo" />
</head>

<body>

  <main class="PantallaLogin">
    <div class="TarjetaLogin">
      <a href="/" class="TarjetaLogin-Marca">
        <img src="~/img/LogoMenteActiva.jpeg" alt="Logo Mente Activa Psicopedagogía" class="LogoMarca">
        Mente Activa Psicopedagogía
      </a>

      @RenderBody()
    </div>
  </main>

  <partial name="_ScriptsComunes" />
  <script src="~/js/Main.js"></script>
  <script src="~/js/Validaciones.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
