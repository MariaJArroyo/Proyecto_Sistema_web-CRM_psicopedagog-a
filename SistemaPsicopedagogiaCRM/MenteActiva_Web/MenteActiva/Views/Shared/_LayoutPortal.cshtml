@inject MenteActiva.Services.IProveedorMoneda ProveedorMoneda
@{
    var titulo = ViewData["Title"] as string ?? "Portal de familias";

    // Igual que en el layout del panel: la moneda viaja en el body para formato.js
    var moneda = await ProveedorMoneda.ObtenerAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
  <partial name="_CabeceraComun" model="titulo" />
</head>

<body data-moneda="@moneda">

  <partial name="_NavbarPortal" />

  @RenderBody()

  <footer class="text-center TextoSuave small py-4 border-top mt-5">
    &copy; 2026 Mente Activa Psicopedagogía — Portal de familias
  </footer>

  <!-- Contenedor de toasts de confirmacion -->
  <div class="ContenedorToasts" aria-live="polite" aria-atomic="true"></div>

  <partial name="_ScriptsComunes" />

  <script src="~/js/formato.js" asp-append-version="true"></script>

  <script src="~/js/Main.js"></script>

  <script src="~/js/portalComun.js"
          asp-append-version="true"></script>

  <script src="~/js/contadores.js"
          asp-append-version="true"></script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>