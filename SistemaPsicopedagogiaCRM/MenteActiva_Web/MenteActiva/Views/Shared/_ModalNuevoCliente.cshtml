<!-- ========================================================= -->
<!-- MODAL NUEVO CLIENTE (compartido por Clientes y Solicitudes) -->
<!-- Necesita ViewBag.Servicios, ViewBag.Parentescos y ViewBag.NivelesEducativos -->
<!-- ========================================================= -->

<div class="modal fade" id="ModalNuevoCliente" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <form id="FormularioNuevoCliente"
                  asp-controller="Admin"
                  asp-action="RegistrarCliente"
                  method="post"
                  novalidate>

                <!-- Con valor = se esta convirtiendo una solicitud de contacto -->
                <input type="hidden" id="NuevoClienteIdSolicitud" name="IdSolicitud">

                <div class="modal-header">
                    <h5 class="modal-title" id="TituloNuevoCliente">Nuevo cliente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">

                    <div class="alert alert-info small d-none" id="NuevoClienteOrigen"></div>

                    <div class="alert d-none" id="NuevoClienteError" role="alert"></div>

                    <h6 class="text-uppercase small fw-semibold TextoSuave mb-3">
                        <i class="bi bi-person me-1"></i>Datos del encargado
                    </h6>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label for="NombreEncargado" class="form-label CampoObligatorio">Nombre</label>
                            <input type="text" class="form-control" id="NombreEncargado" name="NombreEncargado" maxlength="100" required>
                            <div class="invalid-feedback">El nombre del encargado es obligatorio.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="ApellidoEncargado" class="form-label CampoObligatorio">Apellido</label>
                            <input type="text" class="form-control" id="ApellidoEncargado" name="ApellidoEncargado" maxlength="100" required>
                            <div class="invalid-feedback">El apellido del encargado es obligatorio.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="TelefonoNuevoCliente" class="form-label CampoObligatorio">Teléfono</label>
                            <input type="tel" class="form-control" id="TelefonoNuevoCliente" name="Telefono" placeholder="8888-8888" required>
                            <div class="invalid-feedback">El teléfono debe tener 8 dígitos.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="CorreoNuevoCliente" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="CorreoNuevoCliente" name="Correo" maxlength="150">
                            <div class="invalid-feedback">El correo no es válido.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="ServicioInteresNuevoCliente" class="form-label CampoObligatorio">Servicio de interés</label>
                            <select class="form-select" id="ServicioInteresNuevoCliente" name="IdServicioInteres" required>
                                <option value="">Seleccione una opción</option>
                                @if (ViewBag.Servicios != null)
                                {
                                    foreach (var servicio in ViewBag.Servicios)
                                    {
                                        <option value="@servicio.IdServicio">@servicio.Nombre</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">Debe seleccionar un servicio de interés.</div>
                        </div>

                        <div class="col-12">
                            <label for="Observaciones" class="form-label">Observaciones</label>
                            <textarea class="form-control" id="Observaciones" name="Observaciones" rows="2" maxlength="1000"></textarea>
                        </div>

                    </div>

                    <hr class="my-4">

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="text-uppercase small fw-semibold TextoSuave mb-0">
                            <i class="bi bi-mortarboard me-1"></i>Estudiantes a cargo
                        </h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="BotonAgregarEstudianteNuevo">
                            <i class="bi bi-plus-lg me-1"></i>Agregar estudiante
                        </button>
                    </div>

                    <div class="vstack gap-3" id="ListaEstudiantesNuevo"></div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar cliente</button>
                </div>

            </form>

        </div>
    </div>

</div>

<!-- Plantilla de cada estudiante. Los name e id los pone nuevoCliente.js -->
<template id="PlantillaEstudianteNuevo">
    <div class="border rounded-3 p-3" data-estudiante-nuevo>

        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-semibold small" data-titulo>Estudiante</span>
            <button type="button" class="btn btn-sm btn-outline-danger border-0" data-quitar-estudiante title="Quitar estudiante">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="row g-2">

            <div class="col-md-6">
                <label class="form-label small CampoObligatorio" data-label-para="Nombre">Nombre</label>
                <input type="text" class="form-control form-control-sm" data-campo="Nombre" maxlength="100" required>
                <div class="invalid-feedback">Obligatorio.</div>
            </div>

            <div class="col-md-6">
                <label class="form-label small CampoObligatorio" data-label-para="Apellido">Apellido</label>
                <input type="text" class="form-control form-control-sm" data-campo="Apellido" maxlength="100" required>
                <div class="invalid-feedback">Obligatorio.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label small CampoObligatorio" data-label-para="IdParentesco">Parentesco</label>
                <select class="form-select form-select-sm" data-campo="IdParentesco" required>
                    <option value="">Seleccione</option>
                    @if (ViewBag.Parentescos != null)
                    {
                        foreach (var parentesco in ViewBag.Parentescos)
                        {
                            <option value="@parentesco.IdParentesco">@parentesco.Nombre</option>
                        }
                    }
                </select>
                <div class="invalid-feedback">Seleccione el parentesco.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label small" data-label-para="FechaNacimiento">Fecha de nacimiento</label>
                <input type="date" class="form-control form-control-sm" data-campo="FechaNacimiento">
                <div class="invalid-feedback">No puede ser una fecha futura.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label small" data-label-para="IdNivelEducativo">Nivel educativo</label>
                <select class="form-select form-select-sm" data-campo="IdNivelEducativo">
                    <option value="">Sin especificar</option>
                    @if (ViewBag.NivelesEducativos != null)
                    {
                        foreach (var nivel in ViewBag.NivelesEducativos)
                        {
                            <option value="@nivel.IdNivelEducativo">@nivel.Nombre</option>
                        }
                    }
                </select>
            </div>

        </div>
    </div>
</template>