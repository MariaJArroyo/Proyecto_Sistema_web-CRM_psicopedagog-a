@using MenteActiva.Models
@using Microsoft.AspNetCore.Routing
@{
    var accionPortal = ViewContext.RouteData.Values["action"]?.ToString() ?? "Inicio";
    object? modeloPortal = ViewData.Model;

    // Cada pantalla ya recibe los estudiantes autorizados desde su controlador.
    var datosEstudiante = modeloPortal switch
    {
        PortalInicioViewModel inicio => (Estudiantes: inicio.Estudiantes, IdEstudiante: inicio.Resumen.IdEstudiante),
        PortalCitasViewModel citas => (Estudiantes: citas.Estudiantes, IdEstudiante: citas.IdEstudiante),
        PortalProgresoViewModel progreso => (Estudiantes: progreso.Estudiantes, IdEstudiante: progreso.IdEstudiante),
        PortalTareasViewModel tareas => (Estudiantes: tareas.Estudiantes, IdEstudiante: tareas.IdEstudiante),
        PortalPagosViewModel pagos => (Estudiantes: pagos.Estudiantes, IdEstudiante: pagos.IdEstudiante),
        // Los mensajes no son por estudiante, pero la pantalla carga igual los
        // estudiantes para no perder el selector ni el enlace de las demas
        PortalMensajesViewModel mensajes => (Estudiantes: mensajes.Estudiantes, IdEstudiante: mensajes.IdEstudiante),
        _ => (Estudiantes: new List<PortalEstudianteViewModel>(), IdEstudiante: 0)
    };

    var estudianteActual = datosEstudiante.Estudiantes
        .FirstOrDefault(e => e.IdEstudiante == datosEstudiante.IdEstudiante);

    int? idActual = estudianteActual?.IdEstudiante;
    var filtroActual = Context.Request.Query["filtro"].ToString();
    var filtroReportesActual = Context.Request.Query["filtroReportes"].ToString();
}

<nav class="navbar navbar-expand-xl NavbarPortal sticky-top py-2">
    <div class="container">
        <a class="navbar-brand" asp-controller="Portal" asp-action="Inicio" asp-route-idEstudiante="@idActual">
            <img src="~/img/LogoMenteActiva.jpeg" alt="Logo Mente Activa Psicopedagogía" class="LogoMarca">
            Mente Activa Psicopedagogía
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#MenuPortal"
                aria-controls="MenuPortal" aria-expanded="false" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="MenuPortal">
            <ul class="navbar-nav ms-auto align-items-xl-center gap-xl-2">
                @if (estudianteActual is not null)
                {
                    @if (datosEstudiante.Estudiantes.Count > 1)
                    {
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle text-start" type="button"
                                    id="SelectorEstudiantePortal" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="d-block small TextoSuave">Viendo al estudiante:</span>
                                <span class="fw-semibold">@estudianteActual.Estudiante</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="SelectorEstudiantePortal">
                                @foreach (var estudiante in datosEstudiante.Estudiantes)
                                {
                                    var estaSeleccionado = estudiante.IdEstudiante == datosEstudiante.IdEstudiante;
                                    var rutaEstudiante = new RouteValueDictionary
                                    {
                                        ["idEstudiante"] = estudiante.IdEstudiante
                                    };

                                    if (!string.IsNullOrWhiteSpace(filtroActual))
                                    {
                                        rutaEstudiante["filtro"] = filtroActual;
                                    }

                                    if (!string.IsNullOrWhiteSpace(filtroReportesActual))
                                    {
                                        rutaEstudiante["filtroReportes"] = filtroReportesActual;
                                    }

                                    <li>
                                        <a class="dropdown-item@(estaSeleccionado ? " active" : "")"
                                           href="@Url.Action(accionPortal, "Portal", rutaEstudiante)"
                                           data-portal-cambiar-estudiante
                                           aria-current="@(estaSeleccionado ? "true" : null)">
                                            @estudiante.Estudiante
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="navbar-text px-xl-2">
                                <span class="d-block small TextoSuave">Viendo al estudiante:</span>
                                <span class="fw-semibold">@estudianteActual.Estudiante</span>
                            </span>
                        </li>
                    }
                }

                <li class="nav-item"><a class="nav-link@(accionPortal == "Inicio" ? " active" : "")" asp-controller="Portal" asp-action="Inicio" asp-route-idEstudiante="@idActual">Inicio</a></li>
                <li class="nav-item"><a class="nav-link@(accionPortal == "Citas" ? " active" : "")" asp-controller="Portal" asp-action="Citas" asp-route-idEstudiante="@idActual">Citas</a></li>
                <li class="nav-item"><a class="nav-link@(accionPortal == "Progreso" ? " active" : "")" asp-controller="Portal" asp-action="Progreso" asp-route-idEstudiante="@idActual">Progreso</a></li>
                <li class="nav-item"><a class="nav-link@(accionPortal == "Tareas" ? " active" : "")" asp-controller="Portal" asp-action="Tareas" asp-route-idEstudiante="@idActual">Tareas</a></li>
                <li class="nav-item"><a class="nav-link@(accionPortal == "Pagos" ? " active" : "")" asp-controller="Portal" asp-action="Pagos" asp-route-idEstudiante="@idActual">Pagos</a></li>
                <li class="nav-item">
                    <a class="nav-link@(accionPortal == "Mensajes" ? " active" : "")"
                       asp-controller="Portal" asp-action="Mensajes" asp-route-idEstudiante="@idActual">
                        Mensajes
                        <span class="badge badge-estado-nuevo ms-1 d-none" id="ContadorMensajesPortal"
                              data-contador-mensajes="/Portal/MensajesSinLeer"></span>
                    </a>
                </li>
                <li class="nav-item"><a class="nav-link@(accionPortal == "Perfil" ? " active" : "")" asp-controller="Portal" asp-action="Perfil">Mi perfil</a></li>
                <li class="nav-item ms-xl-2">
                    <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-arrow-left me-1" aria-hidden="true"></i>Salir
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>
