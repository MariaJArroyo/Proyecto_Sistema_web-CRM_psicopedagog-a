              <i class="bi bi-mortarboard me-1"></i>Viendo a: <span data-estudiante-etiqueta>María Rodríguez</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="#" data-estudiante-valor="MariaRodriguez">María Rodríguez</a></li>
              <li><a class="dropdown-item" href="#" data-estudiante-valor="AndresJimenez">Andrés Jiménez</a></li>
            </ul>
          </li>
          <!-- Razor: asp-controller="Portal" asp-action="Inicio" -->
          <li class="nav-item"><a class="nav-link@(accionPortal == "Inicio" ? " active" : "")" href="/Portal/Inicio">Inicio</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Citas" -->
          <li class="nav-item"><a class="nav-link@(accionPortal == "Citas" ? " active" : "")" href="/Portal/Citas">Citas</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Progreso" -->
          <li class="nav-item"><a class="nav-link@(accionPortal == "Progreso" ? " active" : "")" href="/Portal/Progreso">Progreso</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Tareas" -->
          <li class="nav-item"><a class="nav-link@(accionPortal == "Tareas" ? " active" : "")" href="/Portal/Tareas">Tareas</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Pagos" -->
          <li class="nav-item"><a class="nav-link@(accionPortal == "Pagos" ? " active" : "")" href="/Portal/Pagos">Pagos</a></li>
          <!-- Razor: asp-controller="Portal" asp-action="Perfil" -->
          <li class="nav-item"><a class="nav-link@(accionPortal == "Perfil" ? " active" : "")" href="/Portal/Perfil">Mi perfil</a></li>
          <li class="nav-item ms-lg-2">
            <!-- Razor: asp-controller="Cuenta" asp-action="CerrarSesion" -->
            <a class="btn btn-outline-secondary btn-sm" href="/Cuenta/Login">
              <i class="bi bi-box-arrow-left me-1"></i>Salir
            </a>
          </li>
        </ul>
