@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    // la ficha vive dentro de estudiantes, por eso resalta ese enlace
    var seccion = accion == "EstudianteFicha" ? "Estudiantes" : accion;
}
    <aside class="SidebarAdmin">
      <a href="/Admin/Dashboard" class="SidebarAdmin-Marca">
        <img src="~/img/LogoMenteActiva.jpeg" alt="Logo Mente Activa Psicopedagogía" class="LogoMarca">
        <span>Mente Activa</span>
      </a>

      <nav class="SidebarAdmin-Nav">
        <!-- Razor: asp-controller="Dashboard" asp-action="Index" -->
        <a href="/Admin/Dashboard" class="SidebarAdmin-Enlace@(seccion == "Dashboard" ? " activo" : "")">
          <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>
        <!-- Razor: asp-controller="Clientes" asp-action="Index" -->
        <a href="/Admin/Clientes" class="SidebarAdmin-Enlace@(seccion == "Clientes" ? " activo" : "")">
          <i class="bi bi-person-lines-fill"></i><span>Encargados</span>
        </a>
        <!-- Razor: asp-controller="Estudiantes" asp-action="Index" -->
        <a href="/Admin/Estudiantes" class="SidebarAdmin-Enlace@(seccion == "Estudiantes" ? " activo" : "")">
          <i class="bi bi-mortarboard"></i><span>Estudiantes</span>
        </a>
        <!-- Razor: asp-controller="Agenda" asp-action="Index" -->
        <a href="/Admin/Agenda" class="SidebarAdmin-Enlace@(seccion == "Agenda" ? " activo" : "")">
          <i class="bi bi-calendar3"></i><span>Agenda</span>
        </a>
        <!-- Razor: asp-controller="Sesiones" asp-action="Index" -->
         @if (User.IsInRole("Administrador") || User.IsInRole("Psicopedagoga"))
        {
          <!-- Burbuja: citas ya pasadas que nadie anoto como sesion -->
          <a href="/Admin/Sesiones" class="SidebarAdmin-Enlace@(seccion == "Sesiones" ? " activo" : "")">
            <div class="SidebarAdmin-Icono">
              <i class="bi bi-journal-text"></i>
              <sup class="SidebarAdmin-Contador d-none"
                   data-contador="/Admin/ContarCitasSinSesion"
                   data-contador-nombre="citasSinSesion"
                   data-contador-singular="cita atendida sin sesión registrada"
                   data-contador-plural="citas atendidas sin sesión registrada"></sup>
            </div>
            <span>Bitácora de citas</span>
          </a>
        }
        <!-- Razor: asp-controller="Planes" asp-action="Index" -->
        <a href="/Admin/Planes" class="SidebarAdmin-Enlace@(seccion == "Planes" ? " activo" : "")">
          <i class="bi bi-clipboard2-pulse"></i><span>Planes de intervención</span>
        </a>
        <!-- Razor: asp-controller="Reportes" asp-action="Index" -->
        @if (User.IsInRole("Administrador") || User.IsInRole("Psicopedagoga"))
        {
          <a href="/Admin/Reportes" class="SidebarAdmin-Enlace@(seccion == "Reportes" ? " activo" : "")">
            <i class="bi bi-bar-chart-line"></i><span>Reportes</span>
          </a>
        }
        <!-- Razor: asp-controller="Pagos" asp-action="Index" -->
        <!-- Burbuja: cobros que ya pasaron su fecha de vencimiento -->
        <a href="/Admin/Pagos" class="SidebarAdmin-Enlace@(seccion == "Pagos" ? " activo" : "")">
          <div class="SidebarAdmin-Icono">
            <i class="bi bi-cash-coin"></i>
            <sup class="SidebarAdmin-Contador d-none"
                 data-contador="/Admin/ContarPagosVencidos"
                 data-contador-nombre="pagosVencidos"
                 data-contador-singular="cobro vencido"
                 data-contador-plural="cobros vencidos"></sup>
          </div>
          <span>Pagos</span>
        </a>
        <!-- Burbuja: mensajes internos sin leer mas recordatorios que no salieron.
             Suma las dos cosas porque el enlace es uno; el texto del tooltip lo
             arma el servidor y dice de que esta hecho el numero -->
        <a href="/Admin/Comunicacion" class="SidebarAdmin-Enlace@(seccion == "Comunicacion" ? " activo" : "")">
          <div class="SidebarAdmin-Icono">
            <i class="bi bi-chat-dots"></i>
            <sup class="SidebarAdmin-Contador d-none"
                 data-contador="/Admin/PendientesComunicacion"
                 data-contador-campo-titulo="detalle"
                 data-contador-nombre="mensajes"
                 data-contador-singular="pendiente de comunicación"
                 data-contador-plural="pendientes de comunicación"></sup>
          </div>
          <span>Comunicación</span>
        </a>
        <!-- Solicitudes de contacto del sitio web, con contador de pendientes -->
        <a href="/Admin/Solicitudes" class="SidebarAdmin-Enlace@(seccion == "Solicitudes" ? " activo" : "")">
          <div class="SidebarAdmin-Icono">
            <i class="bi bi-inbox"></i>
            <sup class="SidebarAdmin-Contador d-none" id="ContadorSolicitudes"
                 data-contador="/Admin/ContarSolicitudesPendientes"
                 data-contador-campo="pendientes"
                 data-contador-nombre="solicitudes"
                 data-contador-singular="solicitud pendiente"
                 data-contador-plural="solicitudes pendientes"></sup>
          </div>
          <span>Solicitudes</span>
        </a>
        <!-- Razor: asp-controller="Materiales" asp-action="Index" -->
        <a href="/Admin/Materiales" class="SidebarAdmin-Enlace@(seccion == "Materiales" ? " activo" : "")">
          <i class="bi bi-folder2-open"></i><span>Materiales</span>
        </a>
        <!-- Razor: asp-controller="Usuarios" asp-action="Index" -->
        <a href="/Admin/Usuarios" class="SidebarAdmin-Enlace@(seccion == "Usuarios" ? " activo" : "")">
          <i class="bi bi-people-fill"></i><span>Usuarios internos</span>
        </a>
        <!-- Razor: asp-controller="UsuariosExternos" asp-action="Index" -->
        <!-- Burbuja: encargados con correo que todavia no tienen cuenta de portal.
             Va dentro del rol que pide la pantalla, para no ensenar la cuenta de
             algo que esa persona no puede abrir -->
        <a href="/Admin/UsuariosExternos" class="SidebarAdmin-Enlace@(seccion == "UsuariosExternos" ? " activo" : "")">
          <div class="SidebarAdmin-Icono">
            <i class="bi bi-person-badge"></i>
            @if (User.IsInRole("Administrador") || User.IsInRole("Psicopedagoga"))
            {
              <sup class="SidebarAdmin-Contador d-none"
                   data-contador="/Admin/ContarEncargadosSinInvitar"
                   data-contador-nombre="sinInvitar"
                   data-contador-singular="encargado sin invitación al portal"
                   data-contador-plural="encargados sin invitación al portal"></sup>
            }
          </div>
          <span>Acceso al portal</span>
        </a>

         @if (User.IsInRole("Administrador"))
        {
          <!-- Configuración del sitio: solo Administrador -->
          <a href="/Admin/Configuracion" class="SidebarAdmin-Enlace@(seccion == "Configuracion" ? " activo" : "")">
            <i class="bi bi-gear"></i><span>Configuración</span>
          </a>
        }
      </nav>
      
    </aside>
