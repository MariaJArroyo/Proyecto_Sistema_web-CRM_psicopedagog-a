@{
  var nombreUsuario = User.Identity?.Name ?? "Invitado";
  var iniciales = string.Concat(
    nombreUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                 .Take(2)
                 .Select(p => char.ToUpperInvariant(p[0])));
}
      <header class="TopbarAdmin">
        <div class="d-flex align-items-center gap-3">
          <button type="button" class="BotonSidebarToggle" aria-label="Abrir menú">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="TopbarAdmin-Titulo">@ViewData["Title"]</h1>
        </div>
        <div class="dropdown">
          <button type="button" class="TopbarAdmin-Usuario" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="d-none d-sm-inline">@nombreUsuario</span>
            <div class="TopbarAdmin-Avatar">@iniciales</div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/Admin/MiPerfil"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <li>
              <!-- Cerrar sesion va por POST: con un enlace, otro sitio podria
                   sacar a la persona de su sesion desde una imagen -->
              <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="m-0">
                <button type="submit" class="dropdown-item">
                  <i class="bi bi-box-arrow-left me-2"></i>Cerrar sesión
                </button>
              </form>
            </li>
          </ul>
        </div>
      </header>
